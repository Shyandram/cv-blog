---
import 'katex/dist/katex.min.css';
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/source-serif-4/opsz.css';
import '../styles/global.css';
import { createHash } from 'node:crypto';
import themeScript from '../scripts/theme.js?raw';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { HTML_LANG, LANGS, type Lang, useT } from '../i18n/ui';
import { url } from '../lib/site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path (without base) of this page in each language, when it differs from a simple prefix swap. */
  alternates?: Partial<Record<Lang, string>>;
  /** Pages that Pagefind should not index (lists, home). */
  noindex?: boolean;
}
const { lang, title, description, alternates = {}, noindex = false } = Astro.props;
const t = useT(lang);
const fullTitle = title ? `${title} · ${t('site.name')}` : t('site.name');
const desc = description ?? t('site.tagline');

// Path relative to base, e.g. "/en/learn/".
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rel = Astro.url.pathname.slice(base.length) || '/';
const alt = Object.fromEntries(
  LANGS.map((l) => [l, alternates[l] ?? rel.replace(new RegExp(`^/${lang}/`), `/${l}/`)])
) as Record<Lang, string>;
const canonical = new URL(Astro.url.pathname, Astro.site);
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(themeScript).digest('base64')}`);
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={new URL(url(alt[l]), Astro.site)} />)}
    <link rel="alternate" type="application/rss+xml" title={t('site.name')} href={url(`/${lang}/rss.xml`)} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <script is:inline set:html={themeScript}></script>
    {!import.meta.env.DEV && <>
      <link rel="stylesheet" href={url('/pagefind/pagefind-component-ui.css')} />
      <script is:inline type="module" src={url('/pagefind/pagefind-component-ui.js')}></script>
    </>}
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <SearchPalette lang={lang} />
    <Header lang={lang} alternates={alt} />
    <main id="main" tabindex="-1" data-pagefind-body={noindex ? undefined : ''}>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>import '../scripts/prose'; import '../scripts/citations'; import '../scripts/langswitch';</script>
  </body>
</html>
