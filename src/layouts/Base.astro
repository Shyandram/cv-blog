---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { HTML_LANG, LANGS, type Lang, useT } from '../i18n/ui';
import { url } from '../lib/site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path (without base) of this page in each language, when it differs from a simple prefix swap. */
  alternates?: Partial<Record<Lang, string>>;
  /** Pages that Pagefind should not index (lists, home). */
  noindex?: boolean;
}
const { lang, title, description, alternates = {}, noindex = false } = Astro.props;
const t = useT(lang);
const fullTitle = title ? `${title} · ${t('site.name')}` : t('site.name');
const desc = description ?? t('site.tagline');

// Path relative to base, e.g. "/en/learn/".
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rel = Astro.url.pathname.slice(base.length) || '/';
const alt = Object.fromEntries(
  LANGS.map((l) => [l, alternates[l] ?? rel.replace(new RegExp(`^/${lang}/`), `/${l}/`)])
) as Record<Lang, string>;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={new URL(url(alt[l]), Astro.site)} />)}
    <link rel="alternate" type="application/rss+xml" title={t('site.name')} href={url(`/${lang}/rss.xml`)} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href={`https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=JetBrains+Mono:wght@400;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600${lang === 'zh-tw' ? '&family=Noto+Sans+TC:wght@400;700&family=Noto+Serif+TC:wght@400;600' : ''}&display=swap`}
    />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <Header lang={lang} alternates={alt} />
    <main data-pagefind-body={noindex ? undefined : ''}>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
