---
import Base from '../../layouts/Base.astro';
import { LANGS, type Lang, useT } from '../../i18n/ui';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
---
<Base lang={lang} title={t('about.title')}>
  <div class="wrap narrow">
    <header class="page-head"><h1>{t('about.title')}</h1></header>
    <div class="prose">
      {lang === 'zh-tw' ? (
        <>
          <p>這是一個從基礎影像處理一路講到現代深度學習的電腦視覺教學網站。每篇教學都包含直覺說明、數學推導、可執行的程式碼，以及可以在瀏覽器中直接操作的互動示範。</p>
          <p>所有程式碼都附有對應的 Jupyter 筆記本，可以在 Google Colab 上直接執行。</p>
        </>
      ) : (
        <>
          <p>This site teaches computer vision from basic image processing up to modern deep learning. Every tutorial has an intuitive explanation, the math, runnable code, and an interactive demo that runs in your browser.</p>
          <p>The code for each tutorial comes with a Jupyter notebook you can open directly in Google Colab.</p>
        </>
      )}
    </div>
  </div>
</Base>
<style>.narrow { max-width: calc(var(--measure) + 2 * var(--gutter)); }</style>
