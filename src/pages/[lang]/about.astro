---
import Base from '../../layouts/Base.astro';
import { LANGS, type Lang, useT } from '../../i18n/ui';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
---
<Base lang={lang} title={t('about.title')}>
  <div class="wrap narrow">
    <header class="page-head"><h1>{t('about.title')}</h1></header>
    <div class="prose">
      {lang === 'zh-tw' ? (
        <>
          <p>這是一個中英雙語的教學網站，內容涵蓋數位影像處理、自然語言處理、圖形識別、機器學習與深度學習、電腦視覺、最佳化及資訊理論，從數學基礎一路講到近年的研究進展。</p>
          <p>每篇教學都先用淺白的比喻說明，再給出嚴謹的數學推導，並附上可以實際執行的 Python 程式碼、圖表、整理自綜述論文的「現代觀點」、練習題，以及經過查證的參考文獻。部分教學另有可以在瀏覽器中直接操作的互動示範，或可在 Google Colab 執行的 Jupyter 筆記本。</p>
          <p>可以從<a href="/zh-tw/learn/foundations/getting-started/">入門指南</a>開始，或直接到<a href="/zh-tw/learn/">學習</a>頁面挑選單元。</p>
        </>
      ) : (
        <>
          <p>This is a bilingual (English / Traditional Chinese) tutorial site covering digital image processing, natural language processing, pattern recognition, machine learning and deep learning, computer vision, optimization and information theory, from the mathematical foundations to recent research.</p>
          <p>Every tutorial starts with a plain-language explanation, then gives the rigorous math, runnable Python code, figures, a "Modern view" built from survey papers, exercises, and verified references. Some tutorials also include interactive demos that run in your browser, or a Jupyter notebook you can open in Google Colab.</p>
          <p>Start with the <a href="/en/learn/foundations/getting-started/">getting-started guide</a>, or pick a track on the <a href="/en/learn/">Learn</a> page.</p>
        </>
      )}
    </div>
  </div>
</Base>
<style>.narrow { max-width: calc(var(--measure) + 2 * var(--gutter)); }</style>
