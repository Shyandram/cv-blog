---
import Base from '../../layouts/Base.astro';
import { LANGS, LANG_LABEL, type Lang } from '../../i18n/ui';
import { url } from '../../lib/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const zh = lang === 'zh-tw';

interface Volume { id: string; number: number; title: string; file: string; bytes: number; tutorials?: number; posts?: number; figures?: number; codeBlocks?: number; displayEquations?: number }
interface Edition { date: string; sourceCommit: string; volumes: Volume[] }
// Written by `npm run book` (scripts/book/publish.mjs). The page still builds before the first PDF exists.
const found = Object.values(import.meta.glob('../../data/books.json', { eager: true, import: 'default' }))[0] as { editions: Partial<Record<Lang, Edition>> } | undefined;
const editions = found?.editions ?? {};
const order: Lang[] = [lang, ...LANGS.filter((l) => l !== lang)];
const mb = (bytes: number) => `${(bytes / 2 ** 20).toFixed(1)} MB`;
const title = zh ? '下載 PDF' : 'Download as PDF';
const lede = zh
  ? '把整個課程帶在身邊：所有教學與部落格文章編成四冊 PDF，公式、圖表與程式碼完整保留，可離線閱讀與列印。'
  : 'Take the whole course with you: every tutorial and blog post typeset as four PDF volumes, with equations, figures and code, for offline reading and printing.';
---
<Base lang={lang} title={title} description={lede}>
  <div class="wrap narrow">
    <header class="page-head"><h1>{title}</h1><p>{lede}</p></header>
    {Object.keys(editions).length === 0 ? (
      <p class="empty">{zh ? 'PDF 尚未發佈。' : 'The PDF has not been published yet.'}</p>
    ) : (
      <div class="books">
        {order.filter((l) => editions[l]).map((l) => {
          const e = editions[l]!;
          return (
            <section class:list={['book', { current: l === lang }]} aria-labelledby={`book-${l}`}>
              <h2 id={`book-${l}`}>{LANG_LABEL[l]}{l === lang && <small>{zh ? '（目前語言）' : ' (current language)'}</small>}</h2>
              <ol class="volumes">
                {e.volumes.map((v) => (
                  <li>
                    <div class="vol-text">
                      <strong>{zh ? `第 ${v.number} 冊` : `Volume ${v.number}`} · {v.title}</strong>
                      <span class="facts">
                        {v.tutorials !== undefined && <span>{v.tutorials} {zh ? '篇教學' : 'tutorials'}</span>}
                        {!!v.posts && <span>{v.posts} {zh ? '篇文章' : 'posts'}</span>}
                        {v.figures !== undefined && <span>{v.figures} {zh ? '張圖' : 'figures'}</span>}
                      </span>
                    </div>
                    <a class="button" href={url(`/books/${v.file}`)} download>{zh ? '下載' : 'Download'} · {mb(v.bytes)}</a>
                  </li>
                ))}
              </ol>
              <p class="meta">{zh ? '建立於' : 'Built'} {e.date} · {zh ? '來源版本' : 'source commit'} <code>{e.sourceCommit}</code></p>
            </section>
          );
        })}
      </div>
    )}
    <div class="prose">
      <h2>{zh ? '關於這份 PDF' : 'About the PDF'}</h2>
      <ul>
        <li>{zh ? '全書依網站的學習單元順序分成四冊，每冊是獨立的 PDF，可以只下載需要的部分；連到其他冊教學的連結會開啟網站。' : 'The course is split into four volumes following the site\'s track order. Each is a separate PDF, so you can download only the part you need; links to tutorials in other volumes open the website.'}</li>
        <li>{zh ? '它是網站內容在建立日當天的快照。網站會持續更新與修訂，內容以網站為準。' : 'It is a snapshot of the site on the build date. The website keeps being updated and revised, so it is the authoritative version.'}</li>
        <li>{zh ? '互動示範與互動實驗無法放進 PDF；書中以「網站版」連結取代，點擊即可在線上操作。' : 'Interactive demonstrations and experiments cannot live in a PDF. The book links to the online edition of each one instead.'}</li>
        <li>{zh ? '為了讓檔案夠小、可以下載，圖片已縮小並壓縮（寬度最多 800 像素，照片以 JPEG 儲存）；需要原始解析度時請看網站。' : 'Figures are downsampled and compressed to keep the file small enough to download (800 px wide at most, photographs stored as JPEG). The website has them at full resolution.'}</li>
        <li>{zh ? '每篇教學的參考文獻編號只在該篇內有效，與網站一致。' : 'Reference numbers are local to each tutorial, as on the site.'}</li>
        <li>{zh ? '建立方式：Pandoc 與 Tectonic，字型為 Noto CJK 與 DejaVu Sans Mono（皆為開放字型授權）。' : 'Built with Pandoc and Tectonic, using the Noto CJK and DejaVu Sans Mono fonts (open font licences).'}</li>
      </ul>
    </div>
  </div>
</Base>
<style>
  .narrow { max-width: calc(var(--measure) + 2 * var(--gutter)); }
  .books { display: grid; gap: 16px; margin: 8px 0 32px; }
  .book { border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; background: var(--surface); }
  .book.current { border-color: var(--accent); }
  .book h2 { margin: 0 0 8px; font-size: 20px; }
  .book h2 small { font-size: 13px; font-weight: 400; color: var(--muted); }
  .volumes { list-style: none; margin: 0 0 8px; padding: 0; display: grid; gap: 12px; }
  .volumes li { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; padding-top: 12px; border-top: 1px solid var(--line); }
  .volumes li:first-child { padding-top: 0; border-top: 0; }
  .vol-text { display: grid; gap: 4px; min-width: 0; }
  .facts { display: flex; flex-wrap: wrap; gap: 4px 16px; font: 13px var(--f-mono); color: var(--muted); }
  .button { display: inline-block; padding: 10px 16px; border-radius: 8px; background: var(--accent); color: var(--on-accent, #fff); text-decoration: none; font: 600 14px var(--f-ui); }
  .button:hover { filter: brightness(1.08); }
  .meta { margin: 6px 0 0; font-size: 12px; color: var(--muted); }
  .empty { color: var(--muted); }
</style>
