---
import Base from '../../layouts/Base.astro';
import KernelPlayground from '../../components/KernelPlayground.astro';
import ExperimentPlayground from '../../components/ExperimentPlayground.astro';
import ImageLab from '../../components/ImageLab.astro';
import { experiments, sources, experimentSources } from '../../lib/playground/catalog';
import { labs } from '../../lib/playground/labs/registry';
import { testImageCredit } from '../../lib/playground/labs/sources';
import { chapterExperiments, chaptersForExperiment, readingOnly, idAliases } from '../../lib/playground/coverage';
import { LANGS, type Lang, useT } from '../../i18n/ui';
import { TRACKS } from '../../lib/taxonomy';
import { tutorialsFor, url } from '../../lib/site';

export function getStaticPaths() { return LANGS.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = useT(lang), zh = lang === 'zh-tw';
const tutorials = await tutorialsFor(lang);
const titleBySlug = new Map(tutorials.map(x => [x.slug, x.entry.data.title]));
const relatedLinks = (slugs: string[]) => slugs.filter(slug => titleBySlug.has(slug)).map(slug => ({ title: titleBySlug.get(slug)!, href: url(`/${lang}/learn/${slug}/`) }));
// Cards appear in curriculum order within each track: the first chapter that lists the experiment decides.
const chapterIndex = new Map(tutorials.map((x, i) => [x.slug, i]));
const firstChapter = (id: string) => Math.min(...chaptersForExperiment(id).map(slug => chapterIndex.get(slug) ?? 1e6), 1e6);
const cards = [...experiments, ...labs].sort((a, b) => firstChapter(a.id) - firstChapter(b.id));
const cardsFor = (track: string) => cards.filter(e => e.track === track);
const count = cards.length + 1;
const chapterPlans = tutorials.map(ch => ({ ...ch, labs: chapterExperiments(ch.slug), reason: readingOnly[ch.slug] }));
const linkedSlugs = (id: string) => chaptersForExperiment(id).filter(slug => titleBySlug.has(slug));
const chapterSearch = (id: string) => linkedSlugs(id).map(slug => titleBySlug.get(slug)).join(' ');
const lede = zh ? '從正在閱讀的章節出發，選一個關鍵問題，先預測再驗證。每章連到最相關的實驗，適合閱讀或實作練習的章節也會說明原因。' : 'Start with your chapter and one important question. Predict, change a parameter, and inspect the result. Find the experiments that matter for each chapter, with a reading-only choice where appropriate.';
---
<Base lang={lang} title={t('playground.title')} description={lede}>
  <div class="wrap playground-wrap">
    <header class="page-head">
      <p class="eyebrow">{zh ? '觀察 · 預測 · 驗證' : 'Observe · Predict · Test'}</p>
      <h1>{t('playground.title')}</h1><p>{lede}</p>
      <div class="lab-stats"><span>{count} {zh ? '個實驗' : 'experiments'}</span><span>{chapterPlans.length} {zh ? '章學習指引' : 'chapter guides'}</span><span>8 {zh ? '條路線' : 'tracks'}</span><span>{zh ? '在瀏覽器中運算' : 'Runs in your browser'}</span></div>
    </header>
    <playground-library data-lang={lang} data-aliases={JSON.stringify(idAliases)}>
      <details class="chapter-directory">
        <summary>{zh ? '逐章選擇實驗' : 'Choose experiments chapter by chapter'} <span>{chapterPlans.length}</span></summary>
        <p>{zh ? '每章列出建議起點；同一實驗可支援不同章節的共同概念。' : 'Each chapter has a suggested starting point. A shared experiment can support the same concept in several chapters.'}</p>
        {TRACKS.map(track => <details class="chapter-group">
          <summary>{t(`track.${track}`)}</summary>
          <ol>{chapterPlans.filter(ch => ch.entry.data.track === track).map(ch => <li data-chapter-row={ch.slug}>
            <a class="chapter-title" href={url(`/${lang}/learn/${ch.slug}/`)}>{ch.entry.data.title}</a>
            {ch.labs.length > 0 ? <>
              <p class="chapter-focus">{ch.labs[0].description[lang]}</p>
              <div class="chapter-lab-links">{ch.labs.map((lab,i) => <a href={`#${lab.id}`}><small>{i===0 ? (zh ? '先試這個' : 'Start here') : (zh ? '延伸' : 'Also explore')}</small>{lab.title[lang]} →</a>)}</div>
            </> : <p class="chapter-focus">{ch.reason?.[lang] ?? (zh ? '本章尚未選定實驗。' : 'No experiment selected for this chapter yet.')}</p>}
          </li>)}</ol>
        </details>)}
      </details>
      <div class="library-tools">
        <label class="chapter-select-label" for="chapter-select">{zh ? '正在閱讀哪一章？' : 'Which chapter are you reading?'}
          <select id="chapter-select"><option value="all">{zh ? '全部章節' : 'All chapters'}</option>{TRACKS.map(track => <optgroup label={t(`track.${track}`)}>{chapterPlans.filter(ch => ch.entry.data.track === track).map(ch => <option value={ch.slug}>{ch.entry.data.title}{ch.labs.length===0 ? (zh ? ' — 閱讀指引' : ' — reading guide') : ''}</option>)}</optgroup>)}</select>
        </label>
        <label class="search-label" for="experiment-search">{zh ? '尋找實驗' : 'Find an experiment'}
          <input id="experiment-search" type="search" placeholder={zh ? '例如：注意力、熵、CBOW' : 'Try attention, entropy, CBOW'} autocomplete="off" />
        </label>
        <div class="track-filters" role="group" aria-label={zh ? '依學習路線篩選' : 'Filter by track'}>
          <button type="button" data-track-filter="all" aria-pressed="true">{zh ? '全部' : 'All'} <span>{count}</span></button>
          {TRACKS.map(track => <button type="button" data-track-filter={track} aria-pressed="false" style={`--tc: var(--t-${track})`}>{t(`track.${track}`)} <span>{cardsFor(track).length + (track === 'image-processing' ? 1 : 0)}</span></button>)}
        </div>
        <p class="result-count" aria-live="polite">{zh ? `顯示 ${count} 個實驗` : `Showing ${count} experiments`}</p>
      </div>
      <div class="experiment-list">
        {TRACKS.map(track => <section class="experiment-track" data-track-section={track}>
          <h2 class="track-heading" style={`--tc: var(--t-${track})`}>{t(`track.${track}`)}</h2>
          {cardsFor(track).map(e => <article class="experiment-card" id={e.id} data-track={track} data-chapters={linkedSlugs(e.id).join(' ')} data-search={`${chapterSearch(e.id)} ${e.id} ${e.title.en} ${e.title['zh-tw']} ${e.description.en} ${e.description['zh-tw']} ${e.related.join(' ')}`}>
            <div class="card-heading"><h3>{e.title[lang]}</h3><a class="permalink" href={`#${e.id}`} aria-label={zh ? `連結至${e.title[lang]}` : `Link to ${e.title[lang]}`}>#</a></div>
            <p class="card-description">{e.description[lang]}</p>
            <details class="experiment-panel" open={e.id === 'linear-transform'}>
              <summary><span class="when-closed">{zh ? '開啟實驗' : 'Open experiment'}</span><span class="when-open">{zh ? '收起實驗' : 'Close experiment'}</span></summary>
              {'kind' in e
                ? <ImageLab lab={e} lang={lang} links={relatedLinks(linkedSlugs(e.id))} sources={Object.keys(e.assets).length ? [...e.sources, testImageCredit] : e.sources} />
                : <ExperimentPlayground experiment={e} lang={lang} links={relatedLinks(linkedSlugs(e.id))} sources={experimentSources[e.id] ?? sources[track]} />}
            </details>
          </article>)}
          {track === 'image-processing' && <>
            <article class="experiment-card" id="kernel-filter" data-chapters={linkedSlugs('kernel-filter').join(' ')} data-track={track} data-search="kernel convolution correlation sobel sharpen filter 卷積 相關 濾波 銳化">
              <div class="card-heading"><h3>{zh ? '編輯濾波核' : 'Edit a filter kernel'}</h3><a class="permalink" href="#kernel-filter" aria-label={zh ? '連結至濾波核實驗' : 'Link to kernel experiment'}>#</a></div>
              <p class="card-description">{zh ? '修改 3 × 3 權重，觀察平滑、銳化與邊緣回應。' : 'Edit 3 × 3 weights and inspect smoothing, sharpening and edge responses.'}</p>
              <details class="experiment-panel"><summary><span class="when-closed">{zh ? '開啟實驗' : 'Open experiment'}</span><span class="when-open">{zh ? '收起實驗' : 'Close experiment'}</span></summary>
                <KernelPlayground lang={lang} />
                <p class="legacy-challenge">{zh ? '試試看：先選恆等核，再讓所有權重加總為零。平坦區域的回應會如何改變？' : 'Try this: start with the identity kernel, then make the weights sum to zero. What happens in a flat region?'}</p>
                <p class="legacy-note">{zh ? '此處以未翻轉的核計算互相關，邊界複製最近像素；零和核的帶正負回應以中灰色為零點顯示，超出顯示範圍的值會截斷。' : 'This computes cross-correlation with an unflipped kernel and replicated boundaries. Signed zero-sum responses use mid-gray as zero; values outside the display range are clipped.'}</p>
                {relatedLinks(linkedSlugs('kernel-filter')).map(link => <a class="legacy-link" href={link.href}>{link.title} →</a>)}
                <p class="legacy-note"><a href="https://visionbook.mit.edu/linear_image_filtering.html">{zh ? '方法來源：Torralba、Isola 與 Freeman，Foundations of Computer Vision，MIT Press，2024' : 'Method source: Torralba, Isola & Freeman, Foundations of Computer Vision, MIT Press, 2024'}</a></p>
              </details>
            </article>
          </>}
        </section>)}
      </div>
      <p class="no-results" hidden>{zh ? '此選擇沒有實驗。請參考上方逐章指引，或清除關鍵字、選擇其他章節。' : 'No experiments match this selection. Check the chapter guide above, clear the search, or choose another chapter.'}</p>
    </playground-library>
  </div>
</Base>
<script>
  class PlaygroundLibrary extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const zh = this.dataset.lang === 'zh-tw';
      const search = this.querySelector<HTMLInputElement>('input[type=search]')!;
      const chapter = this.querySelector<HTMLSelectElement>('#chapter-select')!;
      const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-track-filter]'));
      const cards = Array.from(this.querySelectorAll<HTMLElement>('[data-track]'));
      const sections = Array.from(this.querySelectorAll<HTMLElement>('[data-track-section]'));
      let selected = 'all';
      const filter = () => {
        const query = search.value.trim().toLocaleLowerCase();
        let count = 0;
        for (const card of cards) {
          card.hidden = !((selected === 'all' || card.dataset.track === selected) && (chapter.value === 'all' || (card.dataset.chapters ?? '').split(' ').includes(chapter.value)) && (card.dataset.search ?? '').toLocaleLowerCase().includes(query));
          if (!card.hidden) count++;
        }
        sections.forEach(section => section.hidden = !section.querySelector('[data-track]:not([hidden])'));
        buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.trackFilter === selected)));
        this.querySelector('.result-count')!.textContent = zh ? `顯示 ${count} 個實驗` : `Showing ${count} experiment${count === 1 ? '' : 's'}`;
        this.querySelector<HTMLElement>('.no-results')!.hidden = count !== 0;
      };
      buttons.forEach(button => button.addEventListener('click', () => { selected = button.dataset.trackFilter!; chapter.value = 'all'; filter(); }));
      search.addEventListener('input', filter);
      chapter.addEventListener('change', () => { selected = 'all'; search.value = ''; filter(); });
      const openHash = (hash = location.hash) => {
        let id: string;
        try { id = decodeURIComponent(hash.slice(1)); } catch { return; }
        const aliases: Record<string, string> = JSON.parse(this.dataset.aliases ?? '{}');
        const card = cards.find(c => c.id === id) ?? cards.find(c => c.id === aliases[id]);
        if (!card) return;
        selected = 'all'; chapter.value = 'all'; search.value = ''; filter();
        card.querySelector<HTMLDetailsElement>('details.experiment-panel')!.open = true;
        requestAnimationFrame(() => card.scrollIntoView({ block: 'start' }));
      };
      this.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(a => a.addEventListener('click', () => openHash(a.hash)));
      window.addEventListener('hashchange', () => openHash());
      openHash();
    }
  }
  if (!customElements.get('playground-library')) customElements.define('playground-library', PlaygroundLibrary);
</script>
<style>
  .playground-wrap { max-width: 1120px; padding-bottom: 24px; }
  .page-head .eyebrow { font: 11px var(--f-mono); color: var(--accent); }
  .lab-stats { display: flex; gap: 12px 24px; flex-wrap: wrap; margin-top: 10px; color: var(--muted); font: 12px var(--f-mono); }
  playground-library { display: block; }
  .chapter-directory { border: 1px solid var(--line); border-radius: 10px; padding: 16px 20px; margin-bottom: 24px; background: var(--surface); }
  .chapter-directory > summary { font-weight: 600; cursor: pointer; padding-block: 10px; }
  .chapter-directory > summary span { font: 12px var(--f-mono); color: var(--muted); margin-left: 10px; }
  .chapter-directory > p { font-size: 14px; color: var(--muted); }
  .chapter-group { margin: 12px 0; border-top: 1px solid var(--line); padding-top: 12px; }
  .chapter-group > summary { cursor: pointer; font-weight: 600; padding-block: 10px; }
  .chapter-group ol { padding: 0; list-style: none; }
  .chapter-group li { padding: 16px 0; border-bottom: 1px solid var(--line); }
  .chapter-title { font-weight: 600; font-size: 14px; display: inline-block; padding-block: 4px; }
  .chapter-focus { font-size: 14px; margin: 6px 0 10px; color: var(--muted); }
  .chapter-lab-links { display: flex; gap: 10px 20px; flex-wrap: wrap; }
  .chapter-lab-links a { font-size: 13px; text-decoration: none; display: inline-block; padding-block: 4px; }
  .chapter-lab-links small { display: block; color: var(--muted); margin-bottom: 3px; }
  .chapter-select-label { display: grid; gap: 8px; font-size: 13px; margin-bottom: 16px; }
  .chapter-select-label select { width: 100%; min-width: 0; padding: 11px; border: 1px solid var(--line-strong); border-radius: 8px; background: var(--surface); color: var(--ink); font: 14px var(--f-ui); }
  .library-tools { padding: 20px 0; border-block: 1px solid var(--line); }
  .search-label { display: grid; gap: 8px; font-size: 13px; max-width: 520px; }
  .search-label input { width: 100%; padding: 11px 14px; font: 15px var(--f-ui); border: 1px solid var(--line-strong); border-radius: 8px; background: var(--surface); color: var(--ink); }
  .track-filters { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
  .track-filters button { display: flex; align-items: center; gap: 8px; padding: 8px 11px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--ink); font: 13px var(--f-ui); cursor: pointer; }
  .track-filters button[aria-pressed=true] { border-color: var(--tc, var(--accent)); box-shadow: inset 0 -2px var(--tc, var(--accent)); }
  .track-filters span { font: 11px var(--f-mono); color: var(--muted); }
  .result-count { margin: 14px 0 0; color: var(--muted); font-size: 12px; }
  .experiment-track { margin-top: 28px; }
  .track-heading { font-size: 19px; border-left: 3px solid var(--tc); padding-left: 12px; margin-bottom: 14px; }
  .experiment-card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 20px; margin-bottom: 14px; min-width: 0; scroll-margin-top: var(--anchor-offset); }
  .card-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  h3 { font-size: 21px; }
  .permalink { color: var(--muted); text-decoration: none; font-family: var(--f-mono); display: inline-flex; align-items: center; justify-content: center; min-width: 28px; min-height: 28px; border-radius: 6px; flex: none; }
  .permalink:hover { color: var(--accent); }
  .card-description { color: var(--muted); font-family: var(--f-body); font-size: 17px; margin: 9px 0 12px; max-width: 72ch; }
  .experiment-panel > summary { color: var(--accent); cursor: pointer; font-size: 13px; padding: 10px 0; width: fit-content; }
  .when-open { display: none; }
  .experiment-panel[open] > summary .when-open { display: inline; }
  .experiment-panel[open] > summary .when-closed { display: none; }
  .experiment-panel[open] > summary { margin-bottom: 20px; }
  .legacy-challenge { padding: 12px; background: var(--code-bg); border-radius: 8px; }
  .legacy-link { display: inline-block; margin: 0 12px 8px 0; font-size: 13px; }
  .legacy-note { font-size: 13px; color: var(--muted); }
  .no-results { padding: 32px 0; color: var(--muted); }
  @media (max-width: 520px) { .experiment-card { padding: 16px; } h3 { font-size: 19px; } }
</style>
