---
import Base from '../../layouts/Base.astro';
import KernelPlayground from '../../components/KernelPlayground.astro';
import ImageCompare from '../../components/ImageCompare.astro';
import { LANGS, type Lang, useT } from '../../i18n/ui';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const zh = lang === 'zh-tw';
---
<Base lang={lang} title={t('playground.title')}>
  <div class="wrap narrow">
    <header class="page-head"><h1>{t('playground.title')}</h1><p>{t('playground.lede')}</p></header>
    <h2>{zh ? '卷積與濾波' : 'Convolution & filtering'}</h2>
    <KernelPlayground lang={lang} />
    <h2>{zh ? '高斯模糊前後比較' : 'Gaussian blur, before and after'}</h2>
    <ImageCompare beforeLabel={zh ? '輸入' : 'Input'} afterLabel={zh ? '高斯 σ=1.4' : 'Gaussian σ=1.4'} alt={zh ? '測試影像' : 'Test image'} />
  </div>
</Base>
<style>
  .narrow { max-width: calc(var(--col-max) + 2 * var(--gutter)); }
  h2 { font-size: 22px; margin-block: 24px 12px; }
</style>
