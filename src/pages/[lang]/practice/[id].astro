---
// One practice problem (LeetCode-style). At >= 1024 px a split view: left, tabs Description (description, challenge,
// prediction) · Hints (the chapter sections that use the lab) · Explanation (the prediction's explanation, closed until
// asked for); right, the existing lab component mounted unchanged (its own prediction and "Try this" line are hidden
// here because the left pane shows them). Below 1024 px the panes stack. Without JavaScript the tabs are not shown and
// every panel is listed in order. Opening the page marks the problem "attempted"; a correct prediction marks it
// "solved" (this browser only, src/scripts/practice.ts).
import Base from '../../../layouts/Base.astro';
import Predict from '../../../components/Predict.astro';
import ImageLab from '../../../components/ImageLab.astro';
import ExperimentPlayground from '../../../components/ExperimentPlayground.astro';
import { experiments, sources, experimentSources } from '../../../lib/playground/catalog';
import { labs } from '../../../lib/playground/labs/registry';
import { testImageCredit } from '../../../lib/playground/labs/sources';
import { LANGS, type Lang, useT } from '../../../i18n/ui';
import { url } from '../../../lib/site';
import { problemsFor, sectionsFor, type Problem } from '../../../lib/practice';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    const problems = await problemsFor(lang);
    for (const p of problems) {
      paths.push({ params: { lang, id: p.id }, props: { problem: p, prev: problems[p.index - 1], next: problems[p.index + 1], total: problems.length } });
    }
  }
  return paths;
}
interface Props { problem: Problem; prev?: Problem; next?: Problem; total: number }
const { problem: p, prev, next, total } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (m, k: string) => (k in v ? String(v[k]) : m));
const lab = labs.find((l) => l.id === p.id);
const exp = experiments.find((e) => e.id === p.id);
const labSources = lab ? (Object.keys(lab.assets).length ? [...lab.sources, testImageCredit] : lab.sources) : [];
const sections = await sectionsFor(p, lang);
const chapter = p.chapters[0];
const tabs = [
  { key: 'desc', label: t('practice.description') },
  { key: 'hints', label: t('practice.hints') },
  ...(p.predict ? [{ key: 'explain', label: t('practice.explanation') }] : []),
];
const labels = { solved: t('practice.status.solved'), attempted: t('practice.status.attempted') };
---
<Base lang={lang} title={p.title[lang]} description={p.description[lang]}>
  <div class="problem">
    <nav class="pb-bar" aria-label={t('practice.title')}>
      <a class="pb-back" href={url(`/${lang}/practice/`)}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
        {t('practice.back')}
      </a>
      <span class="pb-pos">{fill(t('practice.problemN'), { i: p.index + 1, n: total })}</span>
      <span class="pb-status" data-status hidden></span>
      <span class="pb-arrows">
        {prev ? <a class="arrow" href={url(`/${lang}/practice/${prev.id}/`)} rel="prev" title={prev.title[lang]}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg><span class="sr-only">{t('practice.prev')}: {prev.title[lang]}</span></a>
          : <span class="arrow is-off" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"></path></svg></span>}
        {next ? <a class="arrow" href={url(`/${lang}/practice/${next.id}/`)} rel="next" title={next.title[lang]}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg><span class="sr-only">{t('practice.next')}: {next.title[lang]}</span></a>
          : <span class="arrow is-off" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"></path></svg></span>}
      </span>
    </nav>

    <practice-problem class="pb-split" data-id={p.id} data-labels={JSON.stringify(labels)}>
      <section class="pane pb-left" aria-labelledby="pb-title">
        <div class="tablist" role="tablist" aria-label={p.title[lang]} hidden>
          {tabs.map((x, i) => <button type="button" role="tab" id={`tab-${x.key}`} aria-controls={`panel-${x.key}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{x.label}</button>)}
        </div>
        <div class="pb-body">
          <h1 id="pb-title">{p.title[lang]}</h1>
          <p class="ppills">
            <span class={`ppill lv lv-${p.level}`}>{t(`level.${p.level}`)}</span>
            {chapter && <a class="ppill" href={url(chapter.href)}>{chapter.title}</a>}
            <span class="ppill">{t(`practice.type.${p.type}`)}</span>
          </p>

          <div class="panel" role="tabpanel" id="panel-desc" aria-labelledby="tab-desc">
            <h2 class="panel-h">{t('practice.description')}</h2>
            <p class="desc">{p.description[lang]}</p>
            <p class="challenge"><strong>{t('practice.tryThis')}</strong>{p.challenge[lang]}</p>
            {p.predict && <Predict id={`practice-${p.id}`} predict={p.predict} lang={lang} />}
          </div>

          <div class="panel" role="tabpanel" id="panel-hints" aria-labelledby="tab-hints">
            <h2 class="panel-h">{t('practice.hints')}</h2>
            <p>{t('practice.hintsLead')}</p>
            <ul class="hint-links">
              {sections.map((s) => <li><a href={url(s.href)}><span class="hl-code">{s.chapter.code}</span> {s.heading ?? s.chapter.title}</a></li>)}
            </ul>
          </div>

          {p.predict && (
            <div class="panel" role="tabpanel" id="panel-explain" aria-labelledby="tab-explain">
              <h2 class="panel-h">{t('practice.explanation')}</h2>
              <p class="muted">{t('practice.explainLater')}</p>
              <details class="explain" data-explain>
                <summary>{t('practice.showExplanation')}</summary>
                <p>{p.predict.explain[lang]}</p>
              </details>
            </div>
          )}
        </div>
      </section>

      <section class="pane pb-right" aria-label={t('practice.lab')}>
        <p class="lab-head"><strong>{t('practice.lab')}</strong> · <span>{p.title[lang]}</span></p>
        {lab
          ? <ImageLab lab={lab} lang={lang} links={[]} sources={labSources} />
          : <ExperimentPlayground experiment={exp!} lang={lang} links={[]} sources={experimentSources[p.id] ?? sources[p.track]} />}
        <p class="lab-foot"><a href={url(`/${lang}/playground/#${p.id}`)}>{t('practice.inPlayground')} →</a></p>
      </section>
    </practice-problem>
  </div>
</Base>

<script>
  import { markPractice, practiceStatus } from '../../../scripts/practice';

  class PracticeProblem extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const id = this.dataset.id!;
      const labels = JSON.parse(this.dataset.labels ?? '{}') as Record<string, string>;
      const statusEl = document.querySelector<HTMLElement>('[data-status]');
      const showStatus = () => {
        const s = practiceStatus()[id];
        if (!statusEl || !s) return;
        statusEl.hidden = false;
        statusEl.dataset.s = s;
        statusEl.textContent = labels[s];
      };
      markPractice(id, 'attempted');
      showStatus();

      // Tabs (WAI-ARIA tabs pattern, manual activation with arrow keys moving focus and selection).
      const tablist = this.querySelector<HTMLElement>('[role=tablist]')!;
      const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role=tab]')];
      const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls')!)!);
      const select = (i: number, focus = false) => {
        tabs.forEach((tab, j) => {
          const on = i === j;
          tab.setAttribute('aria-selected', String(on));
          tab.tabIndex = on ? 0 : -1;
          panels[j].hidden = !on;
        });
        if (focus) tabs[i].focus();
      };
      tablist.hidden = false;
      this.classList.add('has-tabs');
      select(0);
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', (e) => {
          const k = e.key;
          let j = -1;
          if (k === 'ArrowRight') j = (i + 1) % tabs.length;
          else if (k === 'ArrowLeft') j = (i - 1 + tabs.length) % tabs.length;
          else if (k === 'Home') j = 0;
          else if (k === 'End') j = tabs.length - 1;
          if (j < 0) return;
          e.preventDefault();
          select(j, true);
        });
      });

      // The prediction on the left is the page's own Predict component; its verdict (data-ok) marks the problem solved.
      const verdict = this.querySelector<HTMLElement>('.pb-left [data-verdict]');
      const explain = this.querySelector<HTMLDetailsElement>('[data-explain]');
      if (verdict) {
        new MutationObserver(() => {
          if (verdict.dataset.ok === 'true') { markPractice(id, 'solved'); showStatus(); }
          if (verdict.dataset.ok && explain) explain.open = true;
        }).observe(verdict, { attributes: true, attributeFilter: ['data-ok'] });
      }
    }
  }
  if (!customElements.get('practice-problem')) customElements.define('practice-problem', PracticeProblem);
</script>

<style>
  .problem {
    --ground: color-mix(in srgb, var(--ink) 5%, var(--bg)); --card: var(--bg); --card-line: var(--line);
    --lv-beginner: #1d6b45; --lv-intermediate: #8a5a00; --lv-advanced: #a3324a; --ok: #1d6b45; --try: #8a5a00;
    background: var(--ground); flex: 1 0 auto; padding: 8px var(--gutter) 24px;
  }
  :global(main:has(> .problem)) { display: flex; flex-direction: column; }
  :global(main:has(> .problem) ~ footer.site-foot) { margin-top: 0; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .problem { --ground: var(--bg); --card: var(--surface); --lv-beginner: #6bd58b; --lv-intermediate: #f0a93a; --lv-advanced: #ff8fae; --ok: #6bd58b; --try: #f0a93a; }
  }
  :global(:root[data-theme='dark']) .problem { --ground: var(--bg); --card: var(--surface); --lv-beginner: #6bd58b; --lv-intermediate: #f0a93a; --lv-advanced: #ff8fae; --ok: #6bd58b; --try: #f0a93a; }

  .pb-bar { max-width: var(--wrap-max); margin: 0 auto 8px; display: flex; align-items: center; gap: 4px 16px; flex-wrap: wrap; font: 14px var(--f-ui); }
  .pb-back { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--ink); text-decoration: none; font-weight: 600; }
  .pb-back:hover { color: var(--accent); }
  .pb-pos { color: var(--muted); font-variant-numeric: tabular-nums; }
  .pb-status { padding: 3px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; color: var(--try); background: color-mix(in srgb, var(--try) 10%, var(--card)); }
  .pb-status[data-s='solved'] { color: var(--ok); background: color-mix(in srgb, var(--ok) 10%, var(--card)); }
  .pb-arrows { margin-left: auto; display: flex; gap: 4px; }
  .arrow { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; color: var(--ink); background: var(--card); border: 1px solid var(--card-line); }
  .arrow:hover { border-color: var(--line-strong); color: var(--accent); }
  .arrow.is-off { opacity: 0.35; }

  practice-problem { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; max-width: var(--wrap-max); margin: 0 auto; }
  .pane { background: var(--card); border: 1px solid var(--card-line); border-radius: 10px; min-width: 0; }
  @media (min-width: 1024px) {
    practice-problem { grid-template-columns: minmax(380px, 5fr) minmax(0, 7fr); align-items: start; }
    /* The problem text stays in view while the lab (often taller) scrolls with the page. */
    .pb-left { position: sticky; top: calc(var(--header-h) + 8px); max-height: calc(100vh - var(--header-h) - 16px); overflow: auto; }
  }

  .tablist { position: sticky; top: 0; z-index: 1; display: flex; gap: 2px; padding: 6px 8px; border-bottom: 1px solid var(--card-line); background: color-mix(in srgb, var(--ink) 2%, var(--card)); border-radius: 10px 10px 0 0; }
  .tablist[hidden] { display: none; }
  [role='tab'] { min-height: 40px; padding: 0 14px; border: 0; border-radius: 6px; background: transparent; color: var(--muted); font: 500 14px var(--f-ui); cursor: pointer; }
  [role='tab']:hover { color: var(--ink); background: color-mix(in srgb, var(--ink) 5%, transparent); }
  [role='tab'][aria-selected='true'] { color: var(--ink); font-weight: 600; background: var(--card); box-shadow: 0 0 0 1px var(--card-line); }
  [role='tab']:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

  .pb-body { padding: 22px 26px 26px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  .pb-body h1 { font-size: 24px; line-height: 1.3; margin: 0; }
  .ppills { margin: 0; display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; }
  .ppill { display: inline-flex; align-items: center; min-height: 28px; padding: 3px 10px; border-radius: 999px; background: color-mix(in srgb, var(--ink) 6%, var(--card)); color: var(--ink); text-decoration: none; overflow-wrap: anywhere; }
  a.ppill:hover { color: var(--accent); text-decoration: underline; }
  .lv { font-weight: 600; }
  .lv-beginner { color: var(--lv-beginner); background: color-mix(in srgb, var(--lv-beginner) 10%, var(--card)); }
  .lv-intermediate { color: var(--lv-intermediate); background: color-mix(in srgb, var(--lv-intermediate) 10%, var(--card)); }
  .lv-advanced { color: var(--lv-advanced); background: color-mix(in srgb, var(--lv-advanced) 10%, var(--card)); }

  .panel { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; font-size: 16px; line-height: 1.65; overflow-wrap: anywhere; }
  .panel > p { margin: 0; }
  .panel-h { font-size: 17px; margin: 8px 0 0; }
  /* With tabs, the tab names the panel; the heading stays for screen readers only. */
  .has-tabs .panel-h { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .panel[hidden] { display: none; }
  .desc { font-family: var(--f-body); font-size: 17px; }
  .challenge { padding: 12px 14px; border-radius: 8px; background: color-mix(in srgb, var(--accent) 6%, var(--card)); }
  .panel :global(predict-reveal) { margin: 0; }
  .panel :global(.predict) { border: 1px solid var(--card-line); border-radius: 10px; padding: 12px 16px 16px; }
  .muted { color: var(--muted); font-size: 14px; }
  .hint-links { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .hint-links a { display: flex; gap: 10px; align-items: baseline; min-height: 44px; padding: 10px 12px; border: 1px solid var(--card-line); border-radius: 8px; text-decoration: none; color: var(--ink); }
  .hint-links a:hover { border-color: var(--accent); color: var(--accent); }
  .hl-code { flex: none; font: 600 13px var(--f-ui); color: var(--muted); font-variant-numeric: tabular-nums; }
  .explain { border: 1px solid var(--card-line); border-radius: 10px; padding: 0 16px; }
  .explain > summary { min-height: 44px; display: flex; align-items: center; cursor: pointer; font: 600 14px var(--f-ui); color: var(--accent); }
  .explain[open] { padding-bottom: 12px; }
  .explain p { margin: 0; }

  .pb-right { padding: 18px 20px; }
  .lab-head { margin: 0 0 12px; font-size: 14px; color: var(--muted); }
  .lab-head strong { color: var(--ink); }
  .lab-head span { color: var(--ink); }
  /* The lab's own prediction and "Try this" line are shown in the left pane; the lab itself is unchanged. */
  .pb-right :global(predict-reveal), .pb-right :global(.lab-challenge), .pb-right :global(.experiment-challenge) { display: none; }
  .lab-foot { margin: 14px 0 0; font-size: 14px; }

  @media (max-width: 620px) {
    .problem { padding-inline: 8px; }
    .pb-body { padding: 18px 16px 20px; }
    .pb-right { padding: 14px 12px; }
    .pb-pos { order: 3; width: 100%; }
    .tablist { overflow-x: auto; }
  }
</style>
