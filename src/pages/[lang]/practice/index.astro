---
// Practice list (LeetCode-style): study plans (one per course), search and filters, a table of every playground
// experiment and image lab as a problem, topic chips from the tags of the chapters behind the problems, and this
// browser's progress. Status (attempted / solved) lives only in localStorage (src/scripts/practice.ts). Without
// JavaScript the whole table is shown and the filters, which need a script, are hidden.
import Base from '../../../layouts/Base.astro';
import { LANGS, type Lang, useT } from '../../../i18n/ui';
import { PREFIX } from '../../../lib/curriculum';
import { TRACKS } from '../../../lib/taxonomy';
import { url } from '../../../lib/site';
import { problemsFor, plansOf, topicsOf } from '../../../lib/practice';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (m, k: string) => (k in v ? String(v[k]) : m));
const problems = await problemsFor(lang);
const plans = plansOf(problems);
const topics = topicsOf(problems);
const solvable = problems.filter((p) => p.predict).length;
const badgeOf = (track: string) => PREFIX[track as keyof typeof PREFIX] || String(TRACKS.indexOf(track as (typeof TRACKS)[number])).padStart(2, '0');
const tagLabel = (tag: string) => tag.replace(/-/g, ' ');
const levels = ['beginner', 'intermediate', 'advanced'] as const;
const statusLabels = { solved: t('practice.status.solved'), attempted: t('practice.status.attempted'), todo: t('practice.status.todo') };
const noscriptStyle = '.practice .needs-js{display:none!important}';
---
<Base lang={lang} title={t('practice.title')} description={t('practice.lede')} noindex>
  <div class="practice">
    <div class="wrap pr-wrap">
      <header class="pr-head">
        <h1>{t('practice.title')}</h1>
        <p class="lede">{t('practice.lede')}</p>
      </header>

      <practice-list class="pr-grid" data-labels={JSON.stringify({ ...statusLabels, showing: t('practice.showing'), solvedOf: t('practice.solvedOf'), attemptedN: t('practice.attemptedN') })} data-total={problems.length} data-solvable={solvable}>
        <section class="plans" aria-labelledby="plans-h">
          <h2 id="plans-h">{t('practice.plans')}</h2>
          <ul class="plan-grid">
            {plans.map((p) => (
              <li>
                <a class="plan" href={`?course=${p.track}#problems`} data-course={p.track} style={`--tc: var(--t-${p.track})`}>
                  <span class="badge" aria-hidden="true">{badgeOf(p.track)}</span>
                  <span class="plan-name">{t(`track.${p.track}`)}</span>
                  <span class="plan-meta">{fill(t('practice.problems'), { n: p.count })} · {fill(t(p.chapters === 1 ? 'practice.chapter1' : 'practice.chapters'), { n: p.chapters })}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <aside class="side">
          <section class="pcard progress" aria-labelledby="progress-h">
            <h2 id="progress-h">{t('practice.progress')}</h2>
            <div class="ring-row">
              <svg class="ring" width="88" height="88" viewBox="0 0 36 36" role="img" aria-label={fill(t('practice.solvedOf'), { s: 0, n: solvable })}>
                <circle cx="18" cy="18" r="15.9155" class="ring-track"></circle>
                <circle cx="18" cy="18" r="15.9155" class="ring-fill" data-empty stroke-dasharray="0 100" transform="rotate(-90 18 18)"></circle>
              </svg>
              <div class="ring-text">
                <span data-solved>{fill(t('practice.solvedOf'), { s: 0, n: solvable })}</span>
                <span data-attempted>{fill(t('practice.attemptedN'), { n: 0 })}</span>
                <span class="muted">{t('practice.stored')}</span>
              </div>
            </div>
            <p class="muted small">{fill(t('practice.solvable'), { n: solvable })}</p>
          </section>
          {topics.length > 0 && (
            <section class="pcard topics needs-js" aria-labelledby="topics-h">
              <h2 id="topics-h">{t('practice.topics')}</h2>
              <div class="chips">
                {topics.map((x) => <button type="button" class="tchip" data-topic={x.tag} aria-pressed="false">{tagLabel(x.tag)} <span>{x.count}</span></button>)}
              </div>
            </section>
          )}
        </aside>

        <section class="list" id="problems" aria-labelledby="problems-h">
          <h2 id="problems-h" class="sr-only">{t('practice.question')}</h2>
          <div class="tools needs-js">
            <label class="search">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
              <span class="sr-only">{t('practice.search')}</span>
              <input type="search" data-f="q" placeholder={t('practice.search')} autocomplete="off" />
            </label>
            <label class="select"><span>{t('practice.course')}</span>
              <select data-f="course"><option value="">{t('practice.all')}</option>{plans.map((p) => <option value={p.track}>{t(`track.${p.track}`)}</option>)}</select>
            </label>
            <label class="select"><span>{t('practice.level')}</span>
              <select data-f="level"><option value="">{t('practice.all')}</option>{levels.map((l) => <option value={l}>{t(`level.${l}`)}</option>)}</select>
            </label>
            <label class="select"><span>{t('practice.type')}</span>
              <select data-f="type"><option value="">{t('practice.all')}</option><option value="image">{t('practice.type.image')}</option><option value="plot">{t('practice.type.plot')}</option></select>
            </label>
            <label class="select"><span>{t('practice.status')}</span>
              <select data-f="status"><option value="">{t('practice.all')}</option><option value="solved">{statusLabels.solved}</option><option value="attempted">{statusLabels.attempted}</option><option value="todo">{statusLabels.todo}</option></select>
            </label>
          </div>
          <div class="count-row needs-js">
            <p class="count" aria-live="polite" data-count>{fill(t('practice.showing'), { n: problems.length, t: problems.length })}</p>
            <button type="button" class="clear" data-clear hidden>{t('practice.clear')}</button>
          </div>
          <table class="ptable">
            <thead>
              <tr>
                <th scope="col" class="c-status"><span class="sr-only">{t('practice.status')}</span><span aria-hidden="true" class="th-short">{t('practice.status')}</span></th>
                <th scope="col">{t('practice.question')}</th>
                <th scope="col" class="c-chapter">{t('practice.chapter')}</th>
                <th scope="col" class="c-type">{t('practice.type')}</th>
                <th scope="col" class="c-level">{t('practice.level')}</th>
              </tr>
            </thead>
            <tbody>
              {problems.map((p) => {
                const ch = p.chapters[0];
                return (
                  <tr data-id={p.id} data-track={p.track} data-level={p.level} data-type={p.type} data-tags={p.tags.join(' ')}
                    data-search={[p.id, p.title.en, p.title['zh-tw'], p.description[lang], ...p.chapters.map((c) => c.title), ...p.tags.map(tagLabel)].join(' ').toLocaleLowerCase()}>
                    <td class="c-status" data-status-cell><span class="st st-todo"><span class="sr-only">{statusLabels.todo}</span></span></td>
                    <td class="c-q"><a href={url(`/${lang}/practice/${p.id}/`)}>{p.title[lang]}</a><span class="q-desc">{p.description[lang]}</span></td>
                    <td class="c-chapter">{ch ? <a href={url(ch.href)} title={ch.title}>{ch.code}</a> : '—'}</td>
                    <td class="c-type">{t(`practice.type.${p.type}`)}</td>
                    <td class="c-level"><span class={`lv lv-${p.level}`}>{t(`level.${p.level}`)}</span></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          <p class="none" data-none hidden>{t('practice.none')}</p>
        </section>
      </practice-list>
    </div>
  </div>
  <noscript><style is:inline set:html={noscriptStyle}></style></noscript>
</Base>

<script>
  import { practiceStatus } from '../../../scripts/practice';

  const CHECK = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>';
  const DOT = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="7.5"></circle></svg>';
  const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (m, k: string) => (k in v ? String(v[k]) : m));

  class PracticeList extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const labels = JSON.parse(this.dataset.labels ?? '{}') as Record<string, string>;
      const total = Number(this.dataset.total), solvable = Number(this.dataset.solvable);
      const rows = [...this.querySelectorAll<HTMLTableRowElement>('tbody tr')];
      const fields = [...this.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-f]')];
      const field = (k: string) => fields.find((f) => f.dataset.f === k)!;
      const chips = [...this.querySelectorAll<HTMLButtonElement>('[data-topic]')];
      const clear = this.querySelector<HTMLButtonElement>('[data-clear]')!;
      let topic = '';

      // Status from this browser only.
      const status = practiceStatus();
      let solved = 0, attempted = 0;
      for (const row of rows) {
        const s: string = status[row.dataset.id!] ?? 'todo';
        row.dataset.status = s;
        if (s === 'solved') solved++;
        if (s === 'attempted') attempted++;
        if (s !== 'todo') {
          const cell = row.querySelector('[data-status-cell]')!;
          cell.innerHTML = `<span class="st st-${s}" title="${labels[s]}">${s === 'solved' ? CHECK : DOT}<span class="sr-only">${labels[s]}</span></span>`;
        }
      }
      const ring = this.querySelector<SVGElement>('.ring')!;
      const share = solvable ? Math.min(100, (solved / solvable) * 100) : 0;
      const ringFill = this.querySelector('.ring-fill')!;
      ringFill.setAttribute('stroke-dasharray', `${share.toFixed(2)} 100`);
      ringFill.toggleAttribute('data-empty', solved === 0);
      const solvedText = fill(labels.solvedOf, { s: solved, n: solvable });
      ring.setAttribute('aria-label', solvedText);
      this.querySelector('[data-solved]')!.textContent = solvedText;
      this.querySelector('[data-attempted]')!.textContent = fill(labels.attemptedN, { n: attempted });

      const apply = (sync = true) => {
        const q = field('q').value.trim().toLocaleLowerCase();
        const want = { track: field('course').value, level: field('level').value, type: field('type').value, status: field('status').value };
        let shown = 0;
        for (const row of rows) {
          const d = row.dataset;
          const ok = (!q || (d.search ?? '').includes(q)) && (!want.track || d.track === want.track) && (!want.level || d.level === want.level)
            && (!want.type || d.type === want.type) && (!want.status || d.status === want.status) && (!topic || (d.tags ?? '').split(' ').includes(topic));
          row.hidden = !ok;
          if (ok) shown++;
        }
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.topic === topic)));
        this.querySelectorAll<HTMLAnchorElement>('.plan').forEach((a) => a.classList.toggle('is-current', a.dataset.course === want.track));
        this.querySelector('[data-count]')!.textContent = fill(labels.showing, { n: shown, t: total });
        this.querySelector<HTMLElement>('[data-none]')!.hidden = shown > 0;
        const active = !!(q || want.track || want.level || want.type || want.status || topic);
        clear.hidden = !active;
        if (!sync) return;
        const params = new URLSearchParams();
        if (q) params.set('q', field('q').value.trim());
        if (want.track) params.set('course', want.track);
        if (want.level) params.set('level', want.level);
        if (want.type) params.set('type', want.type);
        if (want.status) params.set('status', want.status);
        if (topic) params.set('topic', topic);
        const qs = params.toString();
        history.replaceState(history.state, '', `${location.pathname}${qs ? `?${qs}` : ''}${location.hash}`);
      };

      // Restore filters from the URL (study-plan links and shared links use ?course=…).
      const params = new URLSearchParams(location.search);
      const setSelect = (k: string, v: string | null) => {
        const f = field(k);
        if (v && [...(f as HTMLSelectElement).options].some((o) => o.value === v)) f.value = v;
      };
      field('q').value = params.get('q') ?? '';
      setSelect('course', params.get('course'));
      setSelect('level', params.get('level'));
      setSelect('type', params.get('type'));
      setSelect('status', params.get('status'));
      const tp = params.get('topic');
      if (tp && chips.some((c) => c.dataset.topic === tp)) topic = tp;
      apply(false);

      fields.forEach((f) => f.addEventListener(f.tagName === 'INPUT' ? 'input' : 'change', () => apply()));
      chips.forEach((c) => c.addEventListener('click', () => { topic = topic === c.dataset.topic ? '' : c.dataset.topic!; apply(); }));
      clear.addEventListener('click', () => {
        fields.forEach((f) => (f.value = ''));
        topic = '';
        apply();
        field('q').focus();
      });
      this.querySelectorAll<HTMLAnchorElement>('.plan').forEach((a) => a.addEventListener('click', (e) => {
        if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        const course = field('course');
        course.value = course.value === a.dataset.course ? '' : a.dataset.course!;
        apply();
        const list = this.querySelector<HTMLElement>('#problems')!;
        if (list.getBoundingClientRect().top > innerHeight * 0.7 || list.getBoundingClientRect().top < 0) list.scrollIntoView({ block: 'start' });
      }));
    }
  }
  if (!customElements.get('practice-list')) customElements.define('practice-list', PracticeList);
</script>

<style>
  /* Same surfaces as the Learn page: white cards on a light ground in light mode; --surface cards on --bg in dark mode. */
  .practice {
    --ground: color-mix(in srgb, var(--ink) 3.5%, var(--bg)); --card: var(--bg); --card-line: var(--line);
    --lv-beginner: #1d6b45; --lv-intermediate: #8a5a00; --lv-advanced: #a3324a; --ok: #1d6b45; --try: #8a5a00;
    background: var(--ground); padding-block: 40px 64px; flex: 1 0 auto;
  }
  :global(main:has(> .practice)) { display: flex; flex-direction: column; }
  :global(main:has(> .practice) ~ footer.site-foot) { margin-top: 0; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .practice { --ground: var(--bg); --card: var(--surface); --lv-beginner: #6bd58b; --lv-intermediate: #f0a93a; --lv-advanced: #ff8fae; --ok: #6bd58b; --try: #f0a93a; }
  }
  :global(:root[data-theme='dark']) .practice { --ground: var(--bg); --card: var(--surface); --lv-beginner: #6bd58b; --lv-intermediate: #f0a93a; --lv-advanced: #ff8fae; --ok: #6bd58b; --try: #f0a93a; }

  .pr-head { display: grid; gap: 12px; margin-bottom: 28px; }
  .pr-head h1 { font-size: clamp(32px, 4vw, 44px); letter-spacing: -0.01em; }
  .lede { margin: 0; font-size: 18px; line-height: 1.55; color: var(--muted); max-width: 60ch; }
  h2 { font-size: 18px; }

  practice-list { display: block; }
  .pr-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; grid-template-areas: 'plans side' 'list side'; gap: 28px; align-items: start; }
  .plans { grid-area: plans; display: grid; gap: 12px; min-width: 0; }
  .side { grid-area: side; display: grid; gap: 16px; position: sticky; top: calc(var(--header-h) + 16px); }
  .list { grid-area: list; display: grid; gap: 12px; min-width: 0; scroll-margin-top: var(--anchor-offset); }

  .plan-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .plan-grid > li { display: flex; min-width: 0; }
  .plan { flex: 1; min-width: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 12px; row-gap: 2px; align-items: center; padding: 14px 16px; background: var(--card); border: 1px solid var(--card-line); border-radius: 12px; color: var(--ink); text-decoration: none; transition: border-color 0.15s, box-shadow 0.15s; }
  .plan:hover { border-color: var(--line-strong); }
  .plan.is-current { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .plan .badge { grid-row: 1 / 3; }
  .plan-name { font: 600 15px/1.3 var(--f-ui); overflow-wrap: anywhere; }
  .plan-meta { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .badge { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 40px; padding: 0 8px; border-radius: 10px; background: color-mix(in srgb, var(--tc) 8%, var(--card)); color: var(--tc); font: 700 14px var(--f-ui); letter-spacing: 0.02em; }

  .pcard { background: var(--card); border: 1px solid var(--card-line); border-radius: 12px; padding: 18px; display: grid; gap: 10px; }
  .pcard h2 { font-size: 15px; }
  .ring-row { display: flex; align-items: center; gap: 16px; }
  .ring { flex: none; }
  .ring-track, .ring-fill { fill: none; stroke-width: 4; }
  .ring-track { stroke: var(--line); }
  .ring-fill[data-empty] { display: none; }
  .ring-fill { stroke: var(--ok); stroke-linecap: round; transition: stroke-dasharray 0.4s ease; }
  .ring-text { display: grid; gap: 4px; font-size: 14px; font-variant-numeric: tabular-nums; }
  .muted { color: var(--muted); }
  .small { font-size: 13px; margin: 0; line-height: 1.5; }
  .tchips { display: flex; flex-wrap: wrap; gap: 8px; }
  .tchip { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 6px 12px; border: 1px solid transparent; border-radius: 999px; background: color-mix(in srgb, var(--ink) 6%, var(--card)); color: var(--ink); font: 13px var(--f-ui); cursor: pointer; }
  .tchip span { font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .tchip:hover { border-color: var(--line-strong); }
  .tchip[aria-pressed='true'] { background: var(--accent); color: var(--on-accent); }
  .tchip[aria-pressed='true'] span { color: inherit; }

  .tools { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; }
  .search { flex: 1 1 240px; display: flex; align-items: center; gap: 8px; height: 44px; padding: 0 12px; border: 1px solid var(--line-strong); border-radius: 8px; background: var(--card); color: var(--muted); }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--ink); font: 15px var(--f-ui); height: 100%; }
  .search:focus-within { outline: 2px solid var(--accent); outline-offset: 1px; }
  .select { display: grid; gap: 4px; font-size: 12px; color: var(--muted); }
  .select select { height: 44px; padding: 0 10px; border: 1px solid var(--line-strong); border-radius: 8px; background: var(--card); color: var(--ink); font: 14px var(--f-ui); max-width: 220px; }
  .count-row { display: flex; align-items: center; gap: 12px; min-height: 44px; }
  .count { margin: 0; font-size: 13px; color: var(--muted); }
  .clear { min-height: 44px; padding: 0 12px; border: 0; background: transparent; color: var(--accent); font: 13px var(--f-ui); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }

  .ptable { width: 100%; border-collapse: separate; border-spacing: 0; background: var(--card); border: 1px solid var(--card-line); border-radius: 12px; font-size: 15px; overflow: hidden; }
  .ptable th { text-align: left; padding: 12px 14px; font: 600 13px var(--f-ui); color: var(--muted); border-bottom: 1px solid var(--card-line); }
  .ptable td { padding: 12px 14px; border-top: 1px solid var(--card-line); vertical-align: top; }
  .ptable tbody tr:first-child td { border-top: 0; }
  .ptable tbody tr:nth-child(even of :not([hidden])) { background: color-mix(in srgb, var(--ink) 2%, var(--card)); }
  .ptable tbody tr:hover { background: color-mix(in srgb, var(--accent) 6%, var(--card)); }
  .c-status { width: 56px; }
  .c-chapter { width: 120px; white-space: nowrap; }
  .c-type { width: 140px; color: var(--muted); }
  .c-level { width: 120px; }
  .c-q a { font-weight: 600; color: var(--ink); text-decoration: none; }
  .c-q a:hover { color: var(--accent); text-decoration: underline; }
  .q-desc { display: block; margin-top: 2px; font-size: 13px; line-height: 1.45; color: var(--muted); }
  .c-chapter a { display: inline-flex; align-items: center; min-height: 24px; color: var(--ink); font-variant-numeric: tabular-nums; }
  .st { display: inline-flex; width: 18px; height: 18px; }
  .st-solved { color: var(--ok); }
  .st-attempted { color: var(--try); }
  .lv { font-weight: 600; font-size: 14px; }
  .lv-beginner { color: var(--lv-beginner); }
  .lv-intermediate { color: var(--lv-intermediate); }
  .lv-advanced { color: var(--lv-advanced); }
  .none { margin: 0; padding: 24px; text-align: center; color: var(--muted); background: var(--card); border: 1px solid var(--card-line); border-radius: 12px; }

  @media (max-width: 1100px) {
    .pr-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'plans' 'side' 'list'; }
    .side { position: static; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); align-items: start; }
    .plan-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* Phones: each row becomes a small card: status, the question, then chapter · type · level on one line. */
  @media (max-width: 720px) {
    .practice { padding-block: 28px 48px; }
    .plan-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .plan { grid-template-columns: minmax(0, 1fr); row-gap: 4px; padding: 12px; align-content: start; }
    .plan .badge { grid-row: auto; justify-self: start; min-width: 34px; height: 30px; font-size: 13px; border-radius: 8px; margin-bottom: 4px; }
    .plan-name { font-size: 14px; }
    .plan-meta { font-size: 12px; }
    .select { flex: 1 1 140px; }
    .select select { max-width: none; width: 100%; }
    .ptable, .ptable tbody { display: block; }
    .ptable thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .ptable tr { display: grid; grid-template-columns: 22px auto auto minmax(0, 1fr); grid-template-areas: 'st q q q' 'st ch ty lv'; gap: 6px 12px; padding: 12px 14px; border-top: 1px solid var(--card-line); }
    .ptable tbody tr:first-child { border-top: 0; }
    .ptable tr[hidden] { display: none; }
