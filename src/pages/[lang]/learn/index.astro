---
// The course home: a short hero (with "Continue where you left off" when this browser has read something, else a
// "Start with Foundations" card), one card per course (track), and below the cards the units of the selected course
// (the top-level entries of src/content/curriculum.ts). A unit opens into its sub-chapters only when asked. /learn/#<track>
// opens that course; #lt-<slug> opens the unit lists above that id. Without JavaScript every course's units and
// sub-chapters are shown (the <noscript> style below).
import Base from '../../../layouts/Base.astro';
import StudyMap from '../../../components/StudyMap.astro';
import CourseUnits, { type UnitNode } from '../../../components/CourseUnits.astro';
import { LANGS, type Lang, useT } from '../../../i18n/ui';
import { TRACKS } from '../../../lib/taxonomy';
import { PREFIX, splitTitle } from '../../../lib/curriculum';
import { tutorialsFor, nestTutorials, url, tutorialMinutes, shortTitle, formatDuration, type TutorialNode } from '../../../lib/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const zh = lang === 'zh-tw';
const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (m, k: string) => (k in v ? String(v[k]) : m));
const tutorials = (await tutorialsFor(lang)).map((x) => ({
  ...x,
  href: url(`/${lang}/learn/${x.slug}/`),
  minutes: tutorialMinutes(x.entry.body, x.fallback ? 'en' : lang),
}));
type Row = (typeof tutorials)[number];
const chapters = (n: number) => (n === 1 ? t('learn.chapter1') : fill(t('learn.chapters'), { n }));
const sizeOf = (n: TutorialNode<Row>): number => 1 + n.children.reduce((a, c) => a + sizeOf(c), 0);
const minutesLabel = (m: number) => (zh ? `${m} 分鐘` : `${m} min`);
const toUnit = (n: TutorialNode<Row>): UnitNode => {
  const x = n.item;
  const [prefix, ...rest] = x.place.number.split(' ');
  const hasNumber = rest.length > 0;
  return {
    slug: x.slug, href: x.href, prefix: hasNumber ? prefix : '', number: hasNumber ? rest.join(' ') : '',
    text: splitTitle(x.entry.data.title).text, short: shortTitle(x.entry.data.title),
    ex: x.fallback || lang === 'en' ? 'exercises' : '練習',
    meta: n.depth === 1 || n.children.length > 0 ? chapters(sizeOf(n)) : minutesLabel(x.minutes),
    children: n.children.map(toUnit),
  };
};
const courses = TRACKS.map((track, i) => {
  const list = tutorials.filter((x) => x.entry.data.track === track);
  const tree = nestTutorials(list);
  return {
    track, list, units: tree.map(toUnit), unitCount: tree.length,
    badge: PREFIX[track] || String(i).padStart(2, '0'),
    name: t(`track.${track}`),
    minutes: list.reduce((a, x) => a + x.minutes, 0),
  };
});
const first = courses.find((c) => c.list.length > 0)!;
const firstStart = first.list[0];
const labels = {
  'data-k': t('learn.resumeK'), 'data-at': t('learn.resumeAt'), 'data-go': t('learn.resume'), 'data-read': t('learn.read'),
};
// Without JavaScript nothing can open a course or a unit, so every list is shown and the toggles are removed (the site's
// CSP allows inline styles: astro.config.mjs styleDirective).
const noscriptStyle = '.learn .course-panel[hidden],.learn .cu-children[hidden]{display:grid!important}.learn .unit-toggle,.learn .course-pick{display:none!important}';
---
<Base lang={lang} title={t('learn.title')} noindex>
  <div class="learn">
    <div class="wrap">
      <section class="hero" aria-labelledby="learn-title">
        <div class="hero-text">
          <h1 id="learn-title">{t('learn.hero')}</h1>
          <p class="lede">{fill(t('learn.heroLede'), { n: courses.filter((c) => c.list.length > 0).length })}</p>
          <p class="hero-links">
            <a href={firstStart.href}>{t('learn.start')} <span aria-hidden="true">→</span></a>
            <a href={url(`/${lang}/learn/tree/`)}>{t('learn.tree')} <span aria-hidden="true">→</span></a>
            <a href={url(`/${lang}/download/`)}>{t('learn.pdf')} <span aria-hidden="true">→</span></a>
          </p>
          <ul id="review" hidden data-pagefind-ignore></ul>
        </div>
        <div class="next-card" id="learn-next" data-pagefind-ignore {...labels}>
          <p class="nc-k">{t('learn.newHere')}</p>
          <p class="nc-t">{fill(t('learn.startWith'), { track: first.name })}</p>
          <p class="nc-d">{fill(t('learn.startList'), { n: first.list.length, list: first.list.map((x) => shortTitle(splitTitle(x.entry.data.title).text)).join(zh ? '、' : ', ') })}</p>
          <a class="nc-go" href={firstStart.href}>{t('learn.start')}</a>
        </div>
      </section>

      <section class="courses" aria-labelledby="courses-title">
        <h2 id="courses-title">{t('learn.courses')}</h2>
        <ul class="course-grid">
          {courses.map((c) => (
            <li>
              <a class="course-card" href={`#${c.track}`} data-track={c.track} aria-controls={c.track} aria-expanded="false" style={`--tc: var(--t-${c.track})`} data-paths={c.list.map((x) => x.href).join(' ')}>
                <span class="badge" aria-hidden="true">{c.badge}</span>
                <h3>{c.name}</h3>
                <span class="cmeta">
                  {c.list.length === 0 ? t('track.empty') : <>
                    <span>{chapters(c.list.length)}{c.unitCount !== c.list.length && ` · ${fill(t('learn.units'), { n: c.unitCount })}`}</span>
                    <span>{formatDuration(c.minutes, lang)}</span>
                  </>}
                </span>
                <span class="tprog" hidden></span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <p class="course-pick" id="course-pick">{t('learn.pick')}</p>
      {courses.map((c) => (
        <section class="course-panel" id={c.track} aria-labelledby={`${c.track}-title`} style={`--tc: var(--t-${c.track})`} hidden>
          <header class="cp-head">
            <h2 id={`${c.track}-title`} tabindex="-1"><span class="badge" aria-hidden="true">{c.badge}</span>{c.name}</h2>
            {c.list.length > 0 && <p class="cp-meta">{chapters(c.list.length)}{c.unitCount !== c.list.length && ` · ${fill(t('learn.units'), { n: c.unitCount })}`} · {formatDuration(c.minutes, lang)}{c.unitCount !== c.list.length && <span class="cp-hint"> · {t('learn.unitsHint')}</span>}</p>}
          </header>
          {c.list.length === 0 ? <p class="empty">{t('track.empty')}</p> : <ol class="units"><CourseUnits nodes={c.units} lang={lang} /></ol>}
          <p class="cp-tree"><a href={url(`/${lang}/learn/tree/#tree-${c.track}`)}>{t('learn.inTree')} <span aria-hidden="true">→</span></a></p>
        </section>
      ))}
    </div>
  </div>
  <noscript><style is:inline set:html={noscriptStyle}></style></noscript>
  <StudyMap lang={lang} />
</Base>

<script>
  import { lastPlace, ratioOf, tutorialPathOf, fill } from '../../../scripts/progress';

  const cards = [...document.querySelectorAll<HTMLAnchorElement>('.course-card')];
  const panels = [...document.querySelectorAll<HTMLElement>('.course-panel')];
  const pick = document.getElementById('course-pick');

  const setUnit = (button: HTMLButtonElement, open: boolean) => {
    const list = document.getElementById(button.getAttribute('aria-controls') ?? '');
    if (!list) return;
    button.setAttribute('aria-expanded', String(open));
    list.hidden = !open;
  };

  function select(track: string | null) {
    for (const c of cards) {
      const on = c.dataset.track === track;
      c.setAttribute('aria-expanded', String(on));
      c.classList.toggle('is-current', on);
    }
    for (const p of panels) p.hidden = p.id !== track;
    if (pick) pick.hidden = !!track;
  }

  /** Bring a just-opened course into view when its top is off screen (on phones it sits below all the cards). */
  function reveal(el: HTMLElement) {
    const top = el.getBoundingClientRect().top;
    if (top < 0 || top > innerHeight * 0.6) el.scrollIntoView({ block: 'start' });
  }

  for (const card of cards) {
    card.addEventListener('click', (e) => {
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      const track = card.dataset.track!;
      const open = card.getAttribute('aria-expanded') !== 'true';
      select(open ? track : null);
      history.replaceState(history.state, '', open ? `#${track}` : `${location.pathname}${location.search}`);
      if (!open) return;
      const panel = document.getElementById(track)!;
      panel.querySelector<HTMLElement>('h2')?.focus({ preventScroll: true });
      reveal(panel);
    });
  }

  document.addEventListener('click', (e) => {
    const button = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('.unit-toggle');
    if (button) setUnit(button, button.getAttribute('aria-expanded') !== 'true');
  });

  /** #<track> opens that course; any other id inside a course (e.g. #lt-<slug>) opens the course and the units above it. */
  function openFromHash(): boolean {
    let id: string;
    try { id = decodeURIComponent(location.hash.slice(1)); } catch { return false; }
    const target = id ? document.getElementById(id) : null;
    const panel = target?.closest<HTMLElement>('.course-panel');
    if (!target || !panel) return false;
    select(panel.id);
    for (let list = target.closest<HTMLElement>('.cu-children'); list; list = list.parentElement?.closest<HTMLElement>('.cu-children') ?? null) {
      const button = document.querySelector<HTMLButtonElement>(`.unit-toggle[aria-controls="${CSS.escape(list.id)}"]`);
      if (button) setUnit(button, true);
    }
    requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
    return true;
  }

  // The last place read (src/scripts/progress.ts, written by the chapter pages): a "Continue" card, and its course open.
  const last = lastPlace();
  const lastPath = last ? tutorialPathOf(last.path) : '';
  const lastRow = last ? [...document.querySelectorAll<HTMLElement>('.course-panel [data-path]')].find((el) => el.dataset.path === lastPath) : undefined;
  const next = document.getElementById('learn-next');
  if (last && lastRow && next) {
    const L = next.dataset;
    const el = (tag: string, cls: string, text = '') => { const x = document.createElement(tag); x.className = cls; x.textContent = text; return x; };
    const ratio = ratioOf(lastPath);
    const bar = el('span', 'nc-bar');
    bar.setAttribute('aria-hidden', 'true');
    bar.style.setProperty('--p', String(ratio));
    bar.append(el('span', ''));
    const go = document.createElement('a');
    go.className = 'nc-go';
    go.href = `${last.path}${last.id ? `#${encodeURIComponent(last.id)}` : ''}`;
    go.textContent = L.go ?? 'Resume';
    go.append(el('span', 'sr-only', `: ${last.title}`));
    const parts = [el('p', 'nc-k', L.k ?? ''), el('p', 'nc-t', last.title)];
    if (last.heading) parts.push(el('p', 'nc-d', fill(L.at ?? '{h}', { h: last.heading })));
    parts.push(bar, el('p', 'nc-pct', fill(L.read ?? '{p}%', { p: Math.round(ratio * 100) })), go);
    next.replaceChildren(...parts);
    next.classList.add('is-resume');
  }

  if (!openFromHash() && lastRow) select(lastRow.closest<HTMLElement>('.course-panel')!.id);
  window.addEventListener('hashchange', openFromHash);
</script>

<style>
  /* Page-local surfaces: white cards on a light ground in light mode; raised --surface cards on --bg in dark mode. */
  .learn { --ground: color-mix(in srgb, var(--ink) 3.5%, var(--bg)); --card: var(--bg); --card-line: var(--line); background: var(--ground); padding-block: 40px 64px; flex: 1 0 auto; }
  /* The light ground reaches the footer on short pages. */
  :global(main:has(> .learn)) { display: flex; flex-direction: column; }
  :global(main:has(> .learn) ~ footer.site-foot) { margin-top: 0; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .learn { --ground: var(--bg); --card: var(--surface); }
  }
  :global(:root[data-theme='dark']) .learn { --ground: var(--bg); --card: var(--surface); }

  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 420px); gap: 24px 40px; align-items: stretch; }
  .hero-text { display: grid; align-content: center; gap: 14px; }
  .hero h1 { font-size: clamp(32px, 4vw, 44px); letter-spacing: -0.01em; }
  .lede { margin: 0; font-size: 18px; line-height: 1.55; color: var(--muted); max-width: 60ch; }
  .hero-links { margin: 0; display: flex; flex-wrap: wrap; gap: 0 20px; font: 500 15px var(--f-ui); }
  .hero-links a { display: inline-flex; align-items: center; min-height: 44px; gap: 6px; }
  #review { margin: 0; }

  .next-card { display: flex; flex-direction: column; gap: 10px; padding: 24px; background: var(--card); border: 1px solid var(--card-line); border-radius: 16px; }
  .next-card :global(p) { margin: 0; }
  .next-card :global(.nc-k) { font: 600 14px var(--f-ui); color: var(--muted); }
  .next-card :global(.nc-t) { font: 600 20px/1.3 var(--f-display); color: var(--ink); overflow-wrap: anywhere; }
  .next-card :global(.nc-d) { font-size: 15px; color: var(--muted); overflow-wrap: anywhere; }
  .next-card :global(.nc-pct) { font-size: 13px; color: var(--muted); }
  .next-card :global(.nc-bar) { display: block; height: 8px; border-radius: 999px; background: var(--line); overflow: hidden; margin-top: 4px; }
  .next-card :global(.nc-bar > span) { display: block; height: 100%; width: calc(var(--p, 0) * 100%); background: var(--t-nlp); border-radius: 999px; }
  .next-card :global(.nc-go) { align-self: flex-start; margin-top: auto; display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 8px; background: var(--accent); color: var(--on-accent); font: 600 15px var(--f-ui); text-decoration: none; }
  .next-card :global(.nc-go:hover) { background: color-mix(in srgb, var(--accent) 88%, var(--ink)); }

  .courses { margin-top: 48px; display: grid; gap: 16px; }
  h2 { font-size: 22px; }
  .course-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .course-grid > li { display: flex; min-width: 0; }
  .course-card { flex: 1; min-width: 0; min-height: 44px; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; padding: 20px; border: 1px solid var(--card-line); border-radius: 14px; background: var(--card); color: var(--ink); text-decoration: none; transition: border-color 0.15s, box-shadow 0.15s; }
  .course-card:hover { border-color: var(--line-strong); }
  .course-card.is-current { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .course-card h3 { font-size: 17px; line-height: 1.3; overflow-wrap: anywhere; }
  .cmeta { display: grid; gap: 2px; font-size: 14px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .tprog { width: 100%; font-size: 13px; color: var(--ink); }
  .tprog :global(.pbar) { margin-top: 6px; }
  /* The track color appears only here: a small code badge on a faint tint of the same color (>= 4.5:1 in both themes). */
  .badge { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 40px; padding: 0 8px; border-radius: 10px; background: color-mix(in srgb, var(--tc) 8%, var(--card)); color: var(--tc); font: 700 14px var(--f-ui); letter-spacing: 0.02em; }

  .course-pick { margin: 24px 0 0; color: var(--muted); font-size: 15px; }
  .course-panel { margin-top: 24px; padding: 24px 28px 12px; background: var(--card); border: 1px solid var(--card-line); border-radius: 16px; display: grid; gap: 8px; scroll-margin-top: var(--anchor-offset); }
  .course-panel + .course-panel { margin-top: 16px; }
  .cp-head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; }
  .cp-head h2 { display: flex; align-items: center; gap: 12px; }
  .cp-head h2:focus { outline: none; }
  .cp-head h2:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .cp-meta { margin: 0; font-size: 14px; color: var(--muted); }
  .empty { color: var(--muted); margin: 0; }
  .cp-tree { margin: 0; font-size: 14px; }
  .cp-tree a { display: inline-flex; align-items: center; min-height: 44px; gap: 6px; }

  /* Two columns read top to bottom (01–07, then 08–14); an opened unit stays in one piece. */
  .units { list-style: none; margin: 8px 0 0; padding: 0; columns: 2; column-gap: 40px; }

  @media (max-width: 1100px) {
    .course-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero { grid-template-columns: minmax(0, 1fr); }
    .next-card { max-width: 560px; }
  }
  @media (max-width: 760px) {
    .units { columns: 1; }
  }
  @media (max-width: 560px) {
    .learn { padding-block: 24px 40px; }
    .course-grid { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .course-card { padding: 16px; display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 4px 14px; }
    .course-card .badge { grid-row: 1 / 3; width: 56px; }
    .course-card .tprog { grid-column: 1 / -1; }
    .course-panel { padding: 20px 16px 8px; }
    .next-card { padding: 20px; }
  }
  @media (prefers-reduced-motion: reduce) { .course-card { transition: none; } }
</style>

<style is:global>
  /* Rows of CourseUnits (a component, styled here because only this page uses it). */
  .units .cu-node { min-width: 0; break-inside: avoid; }
  .units .cu-row { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto 44px; align-items: center; gap: 0 8px; border-bottom: 1px solid var(--line); }
  .units .cu-link { display: flex; align-items: baseline; gap: 14px; min-height: 48px; padding: 12px 0; color: var(--ink); text-decoration: none; min-width: 0; }
  .units .cu-link:hover .cu-title { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .units .cu-no { flex: none; min-width: 40px; font: 700 13px var(--f-ui); color: var(--muted); font-variant-numeric: tabular-nums; }
  .units .cu-title { font-size: 15px; font-weight: 500; overflow-wrap: anywhere; }
  .units .cu-row > .meta { display: flex; flex-direction: column; align-items: flex-end; font-size: 13px; color: var(--muted); white-space: nowrap; text-align: end; }
  .units .cu-row > .meta .st { color: var(--ink); white-space: normal; }
  .units .cu-row > .meta .st.done { color: var(--t-nlp); font-weight: 600; }
  .units .cu-row > .pbar { position: absolute; left: 0; right: 52px; bottom: -1px; height: 2px; }
  .units .unit-toggle { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--line); border-radius: 10px; background: none; color: var(--accent); cursor: pointer; font: 600 12px var(--f-ui); }
  .units .unit-toggle:hover { border-color: var(--line-strong); background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .units .unit-toggle[aria-expanded='true'] { background: color-mix(in srgb, var(--accent) 10%, transparent); border-color: var(--accent); }
  .units .cu-more::after { content: ''; display: inline-block; width: 5px; height: 5px; margin-left: 5px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); }
  .units .unit-toggle[aria-expanded='true'] .cu-more::after { transform: translateY(1px) rotate(-135deg); }
  .units .cu-pad { width: 44px; }
  .units .cu-children { list-style: none; margin: 0 0 8px; padding: 0 0 0 16px; border-left: 2px solid var(--line); display: grid; }
  .units .cu-children .cu-link { min-height: 44px; padding-block: 10px; }
  .units .cu-children .cu-title { font-size: 14px; }
  .units .cu-children .cu-no { min-width: 48px; font-size: 12px; }
  .units .cu-node[data-depth='3'] .cu-children, .units .cu-node[data-depth='4'] .cu-children { padding-left: 8px; border-left-style: dashed; }
  @media (max-width: 560px) {
    .units .cu-link { gap: 10px; }
    .units .cu-no { min-width: 28px; }
    .units .cu-children .cu-no { min-width: 40px; }
  }
</style>
