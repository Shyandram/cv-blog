---
import Base from '../../../layouts/Base.astro';
import { LANGS, type Lang, useT } from '../../../i18n/ui';
import { TRACKS } from '../../../lib/taxonomy';
import { tutorialsFor, url } from '../../../lib/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const tutorials = await tutorialsFor(lang);
---
<Base lang={lang} title={t('learn.title')} noindex>
  <div class="wrap">
    <header class="page-head">
      <h1>{t('learn.title')}</h1>
      <p>{t('learn.lede')}</p>
      <p class="resume" id="resume" hidden data-pagefind-ignore data-label={lang === 'zh-tw' ? '繼續閱讀：' : 'Continue reading: '} data-done={lang === 'zh-tw' ? '已讀完' : 'Read'}></p>
      <p class="pdf-note"><a href={url(`/${lang}/download/`)}>{lang === 'zh-tw' ? '下載整個課程的 PDF →' : 'Download the whole course as a PDF →'}</a></p>
    </header>
    {TRACKS.map((track, i) => {
      const list = tutorials.filter((x) => x.entry.data.track === track);
      return (
        <section class="track" id={track} style={`--tc: var(--t-${track})`}>
          <div class="th"><span class="num">{t('track.label').toUpperCase()} {i}</span><h2>{t(`track.${track}`)}</h2></div>
          {list.length === 0 ? (
            <p class="empty">{t('track.empty')}</p>
          ) : (
            <ol>
              {list.map((x) => (
                <li>
                  <a href={url(`/${lang}/learn/${x.slug}/`)}>
                    <span class="title">{x.entry.data.title}</span>
                    <span class="desc">{x.entry.data.description}</span>
                  </a>
                  <span class="pill lvl">{t(`level.${x.entry.data.level}`)}</span>
                </li>
              ))}
            </ol>
          )}
        </section>
      );
    })}
  </div>
</Base>
<script>
  // Show where the viewer left off and how far each tutorial has been read (stored in this browser only).
  try {
    const resume = document.getElementById('resume');
    const last = JSON.parse(localStorage.getItem('pp:last') ?? 'null');
    if (resume && last?.path) {
      // A notes or paper-guides page belongs to the tutorial at the parent path; the link returns to the section last read.
      const tutorialPath = String(last.path).replace(/(?:notes|papers)\/$/, '');
      const link = [...document.querySelectorAll<HTMLAnchorElement>('.track li > a')].find((x) => new URL(x.href).pathname === tutorialPath);
      if (link) {
        const a = document.createElement('a');
        a.href = `${new URL(last.path, location.href).pathname}${last.id ? `#${encodeURIComponent(last.id)}` : ''}`;
        a.textContent = `${resume.dataset.label}${last.title}${last.heading ? ` · ${last.heading}` : ''} (${Math.round(last.ratio * 100)}%) →`;
        resume.append(a);
        resume.hidden = false;
      }
    }
    document.querySelectorAll<HTMLAnchorElement>('.track li > a').forEach((a) => {
      const ratio = Number(localStorage.getItem(`pp:p:${new URL(a.href).pathname}`));
      if (!(ratio > 0.02)) return;
      const badge = document.createElement('span');
      badge.className = 'read-badge';
      badge.textContent = ratio >= 0.95 ? `✓ ${resume?.dataset.done ?? 'Read'}` : `${Math.round(ratio * 100)}%`;
      a.closest('li')?.insertBefore(badge, a.nextElementSibling);
    });
  } catch { /* storage unavailable */ }
</script>
<style>
  .resume { margin: 14px 0 0; font-size: 15px; }
  .resume :global(a) { display: inline-block; padding: 8px 14px; border: 1px solid var(--accent); border-radius: 8px; font: 600 15px var(--f-ui); text-decoration: none; background: var(--surface); }
  :global(.read-badge) { font: 11px var(--f-mono); color: var(--muted); white-space: nowrap; margin-left: auto; padding-right: 8px; }
  .pdf-note { font-size: 14px; margin-top: 8px; }
  .track { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 24px; padding-block: 24px; border-top: 1px solid var(--line); }
  .th { display: grid; gap: 4px; align-content: start; }
  .num { font: 12px var(--f-mono); color: var(--tc); }
  h2 { font-size: 22px; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; counter-reset: s; }
  li { counter-increment: s; display: flex; gap: 12px; align-items: center; justify-content: space-between; padding: 10px 12px; border-radius: 8px; }
  li:hover { background: var(--surface); }
  li a { display: grid; gap: 2px; text-decoration: none; color: var(--ink); min-width: 0; }
  li a::before { content: counter(s, decimal-leading-zero); font: 11px var(--f-mono); color: var(--tc); }
  .title { font: 600 16px var(--f-display); }
  .desc { font-family: var(--f-body); color: var(--muted); font-size: 15px; }
  .empty { color: var(--muted); margin: 0; }
  @media (max-width: 720px) { .track { grid-template-columns: minmax(0, 1fr); gap: 12px; } }
</style>
