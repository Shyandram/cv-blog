---
import Base from '../../../layouts/Base.astro';
import StudyMap from '../../../components/StudyMap.astro';
import LearnTree, { type LearnNode } from '../../../components/LearnTree.astro';
import { LANGS, type Lang, useT } from '../../../i18n/ui';
import { TRACKS } from '../../../lib/taxonomy';
import { tutorialsFor, nestTutorials, url, tutorialMinutes, shortTitle, formatDuration, type TutorialNode } from '../../../lib/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (m, k: string) => (k in v ? String(v[k]) : m));
const tutorials = (await tutorialsFor(lang)).map((x) => ({
  ...x,
  href: url(`/${lang}/learn/${x.slug}/`),
  minutes: tutorialMinutes(x.entry.body, x.fallback ? 'en' : lang),
}));
const titleOf = new Map(tutorials.map((x) => [x.slug, x.entry.data.title]));
const listSep = lang === 'zh-tw' ? '、' : ', ';
type Row = (typeof tutorials)[number];
// Each track as a tree (src/content/curriculum.ts): main chapters, with their sub-chapters one click away.
const toNode = (n: TutorialNode<Row>): LearnNode => {
  const x = n.item;
  const needs = x.entry.data.prereqs.map((p) => titleOf.get(p)).filter((p): p is string => !!p).map(shortTitle);
  return {
    slug: x.slug, title: x.entry.data.title, href: x.href, description: x.entry.data.description, short: shortTitle(x.entry.data.title),
    ex: x.fallback || lang === 'en' ? 'exercises' : '練習',
    meta: [t(`level.${x.entry.data.level}`), `${x.minutes} ${t('tut.minutes')}`, ...(needs.length ? [fill(t('learn.needs'), { list: needs.join(listSep) })] : [])],
    children: n.children.map(toNode),
  };
};
---
<Base lang={lang} title={t('learn.title')} noindex>
  <div class="wrap">
    <header class="page-head">
      <h1>{t('learn.title')}</h1>
      <p>{t('learn.lede')}</p>
      <div class="start-guide">
        <strong>{lang === 'zh-tw' ? '第一次來？' : 'New here?'}</strong>
        {lang === 'zh-tw' ? '從基礎開始，或選擇感興趣的主題。每篇課程會列出程度、閱讀時間與先備知識；選擇「查看子章節」探索更深入的內容。' : 'Start with the foundations or choose a subject that interests you. Each tutorial shows its level, reading time and prerequisites; open its sub-chapters when you are ready to go deeper.'}
        <a href={url(`/${lang}/learn/foundations/getting-started/`)}>{lang === 'zh-tw' ? '從入門開始 →' : 'Start here →'}</a>
      </div>
      <p class="resume" id="resume" hidden data-pagefind-ignore></p>
      <ul id="review" hidden data-pagefind-ignore></ul>
      <p class="pdf-note"><a href={url(`/${lang}/learn/tree/`)}>{lang === 'zh-tw' ? '查看完整課程樹 →' : 'View the whole course tree →'}</a><a href={url(`/${lang}/download/`)}>{lang === 'zh-tw' ? '下載整個課程的 PDF →' : 'Download the whole course as a PDF →'}</a></p>
    </header>
    {TRACKS.map((track, i) => {
      const list = tutorials.filter((x) => x.entry.data.track === track);
      const total = list.reduce((a, x) => a + x.minutes, 0);
      return (
        <section class="track" id={track} style={`--tc: var(--t-${track})`} data-paths={list.map((x) => x.href).join(' ')}>
          <div class="th">
            <span class="num">{t('track.label').toUpperCase()} {i}</span>
            <h2>{t(`track.${track}`)}</h2>
            {list.length > 0 && <p class="tmeta">{list.length === 1 ? t('learn.tutorial1') : fill(t('learn.tutorials'), { n: list.length })} · {formatDuration(total, lang)}</p>}
            <p class="tprog" hidden></p>
          </div>
          {list.length === 0 ? (
            <p class="empty">{t('track.empty')}</p>
          ) : (
            <ol class="lt-tree"><LearnTree nodes={nestTutorials(list).map(toNode)} lang={lang} /></ol>
          )}
        </section>
      );
    })}
  </div>
  <StudyMap lang={lang} />
</Base>
<style>
  .start-guide { max-width: 72ch; margin-top: 16px; padding: 0; line-height: 1.7; }
  .start-guide strong { margin-inline-end: 0.35em; }
  .start-guide a { display: inline-block; margin-inline-start: 0.5em; font-weight: 600; }
  .resume { margin: 14px 0 0; }
  #review:not([hidden]) { margin-top: 6px; }
  .pdf-note { font-size: 14px; margin-top: 8px; display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .pdf-note a { display: inline-block; padding-block: 5px; }
  .track { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 24px; padding-block: 24px; border-top: 1px solid var(--line); }
  .th { display: grid; gap: 4px; align-content: start; }
  .num { font: 12px var(--f-mono); color: var(--tc); }
  h2 { font-size: 22px; }
  .tmeta, .tprog { margin: 0; font: 13px var(--f-ui); color: var(--muted); }
  .tprog :global(.pbar) { margin-top: 6px; max-width: 160px; }
  .empty { color: var(--muted); margin: 0; }
  @media (max-width: 720px) { .track { grid-template-columns: minmax(0, 1fr); gap: 12px; } }
</style>
