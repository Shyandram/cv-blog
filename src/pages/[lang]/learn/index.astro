---
import Base from '../../../layouts/Base.astro';
import { LANGS, type Lang, useT } from '../../../i18n/ui';
import { TRACKS } from '../../../lib/taxonomy';
import { tutorialsFor, url } from '../../../lib/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const tutorials = await tutorialsFor(lang);
---
<Base lang={lang} title={t('learn.title')} noindex>
  <div class="wrap">
    <header class="page-head">
      <h1>{t('learn.title')}</h1>
      <p>{t('learn.lede')}</p>
    </header>
    {TRACKS.map((track, i) => {
      const list = tutorials.filter((x) => x.entry.data.track === track);
      return (
        <section class="track" id={track} style={`--tc: var(--t-${track})`}>
          <div class="th"><span class="num">{t('track.label').toUpperCase()} {i}</span><h2>{t(`track.${track}`)}</h2></div>
          {list.length === 0 ? (
            <p class="empty">{t('track.empty')}</p>
          ) : (
            <ol>
              {list.map((x) => (
                <li>
                  <a href={url(`/${lang}/learn/${x.slug}/`)}>
                    <span class="title">{x.entry.data.title}</span>
                    <span class="desc">{x.entry.data.description}</span>
                  </a>
                  <span class="pill lvl">{t(`level.${x.entry.data.level}`)}</span>
                </li>
              ))}
            </ol>
          )}
        </section>
      );
    })}
  </div>
</Base>
<style>
  .track { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 24px; padding-block: 24px; border-top: 1px solid var(--line); scroll-margin-top: var(--anchor-offset); }
  .th { display: grid; gap: 4px; align-content: start; }
  .num { font: 12px var(--f-mono); color: var(--tc); }
  h2 { font-size: 22px; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; counter-reset: s; }
  li { counter-increment: s; display: flex; gap: 12px; align-items: center; justify-content: space-between; padding: 10px 12px; border-radius: 8px; }
  li:hover { background: var(--surface); }
  li a { display: grid; gap: 2px; text-decoration: none; color: var(--ink); min-width: 0; }
  li a::before { content: counter(s, decimal-leading-zero); font: 11px var(--f-mono); color: var(--tc); }
  .title { font: 600 16px var(--f-display); }
  .desc { font-family: var(--f-body); color: var(--muted); font-size: 15px; }
  .empty { color: var(--muted); margin: 0; }
  @media (max-width: 720px) { .track { grid-template-columns: minmax(0, 1fr); gap: 12px; } }
</style>
