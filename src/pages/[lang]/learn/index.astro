---
import Base from '../../../layouts/Base.astro';
import StudyMap from '../../../components/StudyMap.astro';
import { LANGS, type Lang, useT } from '../../../i18n/ui';
import { TRACKS } from '../../../lib/taxonomy';
import { tutorialsFor, url, tutorialMinutes, shortTitle, formatDuration } from '../../../lib/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (m, k: string) => (k in v ? String(v[k]) : m));
const tutorials = (await tutorialsFor(lang)).map((x) => ({
  ...x,
  href: url(`/${lang}/learn/${x.slug}/`),
  minutes: tutorialMinutes(x.entry.body, x.fallback ? 'en' : lang),
}));
const titleOf = new Map(tutorials.map((x) => [x.slug, x.entry.data.title]));
const listSep = lang === 'zh-tw' ? '、' : ', ';
---
<Base lang={lang} title={t('learn.title')} noindex>
  <div class="wrap">
    <header class="page-head">
      <h1>{t('learn.title')}</h1>
      <p>{t('learn.lede')}</p>
      <p class="resume" id="resume" hidden data-pagefind-ignore></p>
      <ul id="review" hidden data-pagefind-ignore></ul>
      <p class="pdf-note"><a href={url(`/${lang}/download/`)}>{lang === 'zh-tw' ? '下載整個課程的 PDF →' : 'Download the whole course as a PDF →'}</a></p>
    </header>
    {TRACKS.map((track, i) => {
      const list = tutorials.filter((x) => x.entry.data.track === track);
      const total = list.reduce((a, x) => a + x.minutes, 0);
      return (
        <section class="track" id={track} style={`--tc: var(--t-${track})`} data-paths={list.map((x) => x.href).join(' ')}>
          <div class="th">
            <span class="num">{t('track.label').toUpperCase()} {i}</span>
            <h2>{t(`track.${track}`)}</h2>
            {list.length > 0 && <p class="tmeta">{list.length === 1 ? t('learn.tutorial1') : fill(t('learn.tutorials'), { n: list.length })} · {formatDuration(total, lang)}</p>}
            <p class="tprog" hidden></p>
          </div>
          {list.length === 0 ? (
            <p class="empty">{t('track.empty')}</p>
          ) : (
            <ol>
              {list.map((x) => {
                const needs = x.entry.data.prereqs.map((p) => titleOf.get(p)).filter((p): p is string => !!p).map(shortTitle);
                return (
                  <li data-path={x.href} data-short={shortTitle(x.entry.data.title)} data-ex={x.fallback || lang === 'en' ? 'exercises' : '練習'}>
                    <a href={x.href} class="title">{x.entry.data.title}</a>
                    <span class="desc">{x.entry.data.description}</span>
                    <span class="meta">
                      <span>{t(`level.${x.entry.data.level}`)}</span>
                      <span>{x.minutes} {t('tut.minutes')}</span>
                      {needs.length > 0 && <span>{fill(t('learn.needs'), { list: needs.join(listSep) })}</span>}
                    </span>
                  </li>
                );
              })}
            </ol>
          )}
        </section>
      );
    })}
  </div>
  <StudyMap lang={lang} />
</Base>
<style>
  .resume { margin: 14px 0 0; }
  #review:not([hidden]) { margin-top: 6px; }
  .pdf-note { font-size: 14px; margin-top: 8px; }
  .track { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 24px; padding-block: 24px; border-top: 1px solid var(--line); }
  .th { display: grid; gap: 4px; align-content: start; }
  .num { font: 12px var(--f-mono); color: var(--tc); }
  h2 { font-size: 22px; }
  .tmeta, .tprog { margin: 0; font: 13px var(--f-ui); color: var(--muted); }
  .tprog :global(.pbar) { margin-top: 6px; max-width: 160px; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  /* The whole row opens the tutorial (the title link stretches over it); the link's name stays the title. */
  li { position: relative; display: grid; gap: 3px; padding: 10px 12px 12px; border-radius: 8px; }
  li:hover { background: var(--surface); }
  li:has(.title:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .title { font: 600 16px var(--f-display); color: var(--ink); text-decoration: none; }
  .title::after { content: ''; position: absolute; inset: 0; border-radius: 8px; }
  .title:focus-visible { outline: none; }
  li:hover .title { color: var(--accent); }
  .desc { font-family: var(--f-body); color: var(--muted); font-size: 15px; max-width: 72ch; }
  .meta { display: flex; flex-wrap: wrap; gap: 2px 0; font: 13px var(--f-ui); color: var(--muted); }
  .meta > span:not(:first-child)::before { content: '·'; padding-inline: 7px; }
  /* Progress (added by StudyMap) gets a line of its own, so a wrapped line never starts with a separator. */
  .meta :global(.st) { flex-basis: 100%; color: var(--ink); }
  .meta :global(.st.done) { color: var(--t-nlp); font-weight: 600; }
  li :global(.pbar) { position: absolute; left: 12px; bottom: 3px; width: min(calc(100% - 24px), 72ch); }
  .empty { color: var(--muted); margin: 0; }
  @media (max-width: 720px) { .track { grid-template-columns: minmax(0, 1fr); gap: 12px; } }
</style>
