---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { chapterExperiments } from '../../../lib/playground/coverage';
import { LANGS, type Lang, useT } from '../../../i18n/ui';
import { tutorialsFor, url, tutorialMinutes, sectionMinutes, formatDate, exerciseCount, EXERCISES, OPTIONAL_SECTION, REPO, BRANCH } from '../../../lib/site';
import ReaderTools from '../../../components/ReaderTools.astro';
import Show from '../../../components/zones/Show.astro';
import Hide from '../../../components/zones/Hide.astro';
import NotesTeaser from '../../../components/zones/NotesTeaser.astro';
import CheckPanel from '../../../components/CheckPanel.astro';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    const list = await tutorialsFor(lang);
    for (const [i, x] of list.entries()) {
      const sameTrack = list.filter((y) => y.entry.data.track === x.entry.data.track);
      const j = sameTrack.indexOf(x);
      const props = { item: x, trackList: sameTrack, prev: sameTrack[j - 1], next: sameTrack[j + 1], all: list, index: i };
      paths.push({ params: { lang, slug: x.slug }, props: { ...props, mode: 'main' } });
      // Optional sections get pages of their own: Supplementary notes (concept details) at …/notes/ and Paper guides at …/papers/.
      if (/^## (Supplementary notes|補充資料)\s*$/m.test(x.entry.body ?? '')) paths.push({ params: { lang, slug: `${x.slug}/notes` }, props: { ...props, mode: 'notes' } });
      if (/^## (Paper guides|論文導讀)\s*$/m.test(x.entry.body ?? '')) paths.push({ params: { lang, slug: `${x.slug}/papers` }, props: { ...props, mode: 'papers' } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { item, trackList, prev, next, all, mode } = Astro.props;
const { entry, slug, fallback } = item;
const d = entry.data;
const notesPage = mode === 'notes' || mode === 'papers';
const chapterLabs = notesPage ? [] : chapterExperiments(slug);
const { Content, headings } = await render(entry);
const sectionName = mode === 'papers' ? /^(paper guides|論文導讀)$/i : /^(supplementary notes|補充資料)$/i;
const notesAt = notesPage ? headings.findIndex((h) => h.depth === 2 && sectionName.test(h.text.trim())) : -1;
const notesHeading = notesAt >= 0 ? headings[notesAt] : undefined;
const notesEnd = notesAt >= 0 ? headings.findIndex((h, i) => i > notesAt && h.depth === 2) : -1;
const isRefs = (h: { depth: number; text: string }) => h.depth === 2 && /^(references|參考文獻)$/i.test(h.text.trim());
const toc = notesPage
  ? [...headings.slice(notesAt + 1, notesEnd < 0 ? undefined : notesEnd).filter((h) => h.depth === 3), ...headings.filter(isRefs)]
  : headings.filter((h) => h.depth === 2);
// Main page: the side table of contents also lists the h3s of each h2 (shown only for the section being read).
const subsOf = new Map<string, { slug: string; text: string }[]>();
if (!notesPage) {
  let cur: string | undefined;
  for (const h of headings) {
    if (h.depth === 2) cur = OPTIONAL_SECTION.test(h.text.trim()) ? undefined : h.slug;
    else if (h.depth === 3 && cur) subsOf.set(cur, [...(subsOf.get(cur) ?? []), { slug: h.slug, text: h.text }]);
  }
}
const components = mode === 'notes' ? { MainZone: Hide, SupplementZone: Show, PapersZone: Hide }
  : mode === 'papers' ? { MainZone: Hide, SupplementZone: Hide, PapersZone: Show }
  : { MainZone: Show, SupplementZone: NotesTeaser, PapersZone: NotesTeaser };
const tutorialUrl = url(`/${lang}/learn/${slug}/`);
const pageTitle = notesPage ? `${notesHeading?.text ?? (mode === 'papers' ? 'Paper guides' : 'Supplementary notes')} · ${d.title}` : d.title;
const readLang = fallback ? 'en' : lang;
const minutes = tutorialMinutes(entry.body, readLang);
// Per-section minutes for the section bar, matched to the rendered h2s by position (only when the counts agree).
const bodySections = sectionMinutes(entry.body, readLang);
const h2s = headings.filter((h) => h.depth === 2);
const sectionTime = new Map(bodySections.length === h2s.length ? h2s.map((h, i) => [h.slug, bodySections[i].minutes] as const) : []);
const tocItems = toc.map((h) => ({ slug: h.slug, text: h.text, minutes: notesPage ? 0 : sectionTime.get(h.slug) ?? 0 }));
// Retrieval practice (main page only): the exercise heading, its exercise count and the next tutorial for the closing panel.
const exHeading = notesPage ? undefined : headings.find((h) => h.depth === 2 && EXERCISES.test(h.text.trim()));
const nextInfo = next ? { slug: next.slug, title: next.entry.data.title, minutes: tutorialMinutes(next.entry.body, next.fallback ? 'en' : lang) } : undefined;
const prereqs = d.prereqs.map((p) => all.find((x) => x.slug === p)).filter(Boolean);
const colab = d.notebook ? `https://colab.research.google.com/github/${REPO}/blob/${BRANCH}/${d.notebook}` : undefined;
const notebookUrl = d.notebook ? `https://github.com/${REPO}/blob/${BRANCH}/${d.notebook}` : undefined;
const editUrl = `https://github.com/${REPO}/edit/${BRANCH}/${entry.filePath}`;
---
<Base lang={lang} title={pageTitle} description={d.description}>
  <div class="wrap tut" style={`--tc: var(--t-${d.track})`}>
    <nav class="rail" aria-label={t(`track.${d.track}`)} data-pagefind-filter={`${t('search.fLevel')}:${t(`level.${d.level}`)}`}>
      <p class="side-title">{t(`track.${d.track}`)}</p>
      <ol>
        {trackList.map((x) => (
          <li class={x.slug === slug ? 'cur' : undefined}>
            <a href={url(`/${lang}/learn/${x.slug}/`)} aria-current={x.slug === slug ? 'page' : undefined}>{x.entry.data.title}</a>
          </li>
        ))}
      </ol>
    </nav>

    <article data-pagefind-filter={`${t('search.fType')}:${t('search.tutorial')}`}>
      <nav class="crumbs" aria-label={t('nav.breadcrumb')}><a href={url(`/${lang}/learn/`)}>{t('learn.title')}</a> / <a href={url(`/${lang}/learn/#${d.track}`)} data-pagefind-filter={t('search.fTrack')}>{t(`track.${d.track}`)}</a></nav>
      {notesPage ? (
        <>
          <h1 data-pagefind-meta="title[data-title]" data-title={pageTitle}>{notesHeading?.text}</h1>
          <p class="notes-of">{mode === 'papers'
            ? (lang === 'zh-tw' ? '本頁是' : 'Reading guides to the papers behind ')
            : (lang === 'zh-tw' ? '本頁是選讀內容，屬於' : 'Optional reading for ')}<a href={tutorialUrl}>{d.title}</a>{mode === 'papers'
            ? (lang === 'zh-tw' ? '所依據論文的導讀：每篇說明它要解決的問題、核心想法、結果，以及閱讀時該注意什麼。引用編號對應本頁底部的參考文獻。' : ': for each paper, the problem, the idea, what it showed and what to check when you read it. Citation numbers refer to the reference list at the bottom of this page.')
            : (lang === 'zh-tw' ? '。主線不依賴這些補充資料；引用編號對應本頁底部的參考文獻。' : '. Nothing in the main text depends on these notes; citation numbers refer to the reference list at the bottom of this page.')}</p>
        </>
      ) : <h1>{d.title}</h1>}
      {!notesPage && <div class="meta-row">
        <span class="pill track">{t(`track.${d.track}`)}</span>
        <span class="pill lvl">{t(`level.${d.level}`)}</span>
        <span class="pill">{minutes} {t('tut.minutes')}</span>
        <span class="pill date">{formatDate(d.updated ?? d.published, lang)}</span>
        {colab && <a class="pill" href={colab}>▶ {t('tut.colab')}</a>}
      </div>}
      {!notesPage && prereqs.length > 0 && (
        <p class="prereqs">{t('tut.needs')}{prereqs.map((p, i) => (<>{i > 0 && (lang === 'zh-tw' ? '、' : ', ')}<a href={url(`/${lang}/learn/${p!.slug}/`)}>{p!.entry.data.title}</a></>))}</p>
      )}
      {fallback && <p class="notice" lang="en">{t('tut.notTranslated')}</p>}

      <ReaderTools lang={lang} toc={tocItems} tutorialTitle={d.title} trackTitle={t(`track.${d.track}`)} chapters={trackList.map((x) => ({ slug: x.slug, title: x.entry.data.title }))} current={slug} onThisPage={t('tut.onThisPage')} />

      {chapterLabs.length > 0 && <aside class="chapter-playgrounds" aria-label={lang === 'zh-tw' ? '本章互動實驗' : 'Chapter experiments'} data-pagefind-ignore>
        <strong>{lang === 'zh-tw' ? '用實驗理解本章' : 'Explore this chapter'}</strong>
        <p>{chapterLabs[0].description[lang]}</p>
        <ul>{chapterLabs.map((lab,i) => <li><a href={url(`/${lang}/playground/#${lab.id}`)}>{i===0 ? (lang==='zh-tw' ? '先試這個：' : 'Start here: ') : ''}{lab.title[lang]} →</a></li>)}</ul>
      </aside>}

      <div class="prose" lang={fallback ? 'en' : undefined}>
        <Content lang={fallback ? 'en' : lang} components={components} />
      </div>

      {exHeading && <CheckPanel lang={lang} exercisesId={exHeading.slug} count={exerciseCount(entry.body)} next={nextInfo} track={d.track} />}

      <div class="after">
        <a href={editUrl}>{t('tut.edit')}</a>
        {notebookUrl && <a href={notebookUrl}>{t('tut.notebook')}</a>}
      </div>
      {notesPage ? (
        <nav class="pn" aria-label={t('tut.pager')} data-pagefind-ignore>
          <a href={tutorialUrl}><small>{lang === 'zh-tw' ? '← 回到正文' : '← Back to the tutorial'}</small>{d.title}</a>
          {next ? <a class="nx" href={url(`/${lang}/learn/${next.slug}/`)}><small>{t('tut.next')}</small>{next.entry.data.title}</a> : <span></span>}
        </nav>
      ) : <nav class="pn" aria-label={t('tut.pager')} data-pagefind-ignore>
        {prev ? <a href={url(`/${lang}/learn/${prev.slug}/`)}><small>{t('tut.prev')}</small>{prev.entry.data.title}</a> : <span></span>}
        {next ? <a class="nx" href={url(`/${lang}/learn/${next.slug}/`)}><small>{t('tut.next')}</small>{next.entry.data.title}</a> : <span></span>}
      </nav>}
    </article>

    <nav class="toc" aria-label={t('tut.onThisPage')}>
      {toc.length > 0 && (
        <>
          <p class="side-title">{t('tut.onThisPage')}</p>
          <ul>{toc.map((h) => {
            const subs = subsOf.get(h.slug);
            return <li><a href={`#${h.slug}`}>{h.text}</a>{subs && <ul class="toc-sub">{subs.map((x) => <li><a href={`#${x.slug}`}>{x.text}</a></li>)}</ul>}</li>;
          })}</ul>
        </>
      )}
    </nav>
  </div>
</Base>

<style>
  .tut { display: grid; grid-template-columns: 200px minmax(0, 1fr) 180px; gap: 40px; padding-block: 32px; }
  .rail, .toc { font-size: 13px; position: sticky; top: 80px; align-self: start; max-height: calc(100vh - 100px); overflow-y: auto; }
  .side-title { font: 600 11px var(--f-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 0 0 10px; }
  .rail .side-title { color: var(--tc); }
  .rail ol { margin: 0; padding: 0; list-style: none; display: grid; gap: 2px; }
  .rail li { padding: 3px 8px; border-radius: 6px; }
  .rail a { color: var(--muted); text-decoration: none; display: block; padding-block: 2px; }
  .rail a:hover { color: var(--ink); }
  .rail li.cur { background: var(--code-bg); }
  .rail li.cur a { color: var(--ink); font-weight: 600; }
  .toc ul { list-style: none; margin: 0; padding: 0 0 0 10px; border-left: 1px solid var(--line); display: grid; gap: 6px; }
  .toc a { color: var(--muted); text-decoration: none; }
  .toc a:hover { color: var(--ink); }
  /* h3s show only under the section being read. */
  .toc-sub { border-left: 0 !important; padding: 6px 0 2px 10px !important; gap: 5px !important; font-size: 12.5px; }
  .toc li:not(:has(> a[aria-current='location'])) > .toc-sub { display: none; }
  article { min-width: 0; }
  .crumbs { font: 12px var(--f-mono); color: var(--muted); }
  .crumbs a { color: var(--muted); display: inline-block; padding-block: 5px; }
  h1 { font-size: clamp(30px, 4vw, 42px); margin-block: 8px 12px; }
  .meta-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
  .notes-of { font-size: 15px; color: var(--muted); margin: 0 0 18px; max-width: var(--measure); }
  .prereqs { font-size: 14px; color: var(--muted); margin: 0 0 18px; }
  .notice { font-size: 14px; background: var(--code-bg); border: 1px dashed var(--line); padding: 8px 12px; border-radius: 8px; }
  .chapter-playgrounds { border-left: 3px solid var(--tc); padding: 14px 18px; background: var(--code-bg); border-radius: 0 8px 8px 0; margin: 20px 0 28px; font-size: 14px; }
  .chapter-playgrounds p { color: var(--muted); margin: 6px 0 10px; }
  .chapter-playgrounds ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .chapter-playgrounds a { overflow-wrap: anywhere; }
  .after { display: flex; gap: 16px; flex-wrap: wrap; font-size: 13px; margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); }
  .after a { color: var(--muted); display: inline-block; padding-block: 5px; }
  .pn { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 20px; }
  .pn a { border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; text-decoration: none; color: var(--ink); background: var(--surface); }
  .pn a:hover { border-color: var(--accent); }
  .pn small { display: block; font: 11px var(--f-mono); color: var(--muted); }
  .pn .nx { text-align: right; }
  /* Article column: ~916px at 1440, ~790px at 1280; TOC hides below 1200, rail below 900. */
  @media (max-width: 1320px) { .tut { grid-template-columns: 190px minmax(0, 1fr) 170px; gap: 32px; } }
  @media (max-width: 1199px) { .tut { grid-template-columns: 200px minmax(0, 1fr); gap: 36px; } .toc { display: none; } }
  @media (max-width: 899px) { .tut { grid-template-columns: minmax(0, 1fr); } .rail { display: none; } }
</style>
