---
import { chapterSlug } from '../../../lib/chapter-paths.mjs';
import { ZONE_KINDS, type ZoneKind, type Zones } from '../../../lib/zones';
import ChapterTree, { type ChapterNode } from '../../../components/ChapterTree.astro';
import Base from '../../../layouts/Base.astro';
import { chapterExperiments } from '../../../lib/playground/coverage';
import { LANGS, type Lang, useT } from '../../../i18n/ui';
import { tutorialsFor, zonesFor, renderTutorial, nestTutorials, ancestorsOf, shortTitle, type TutorialNode, type TutorialItem, url, tutorialMinutes, sectionMinutes, formatDate, exerciseCount, EXERCISES, OPTIONAL_SECTION, REPO, BRANCH } from '../../../lib/site';
import ReaderTools from '../../../components/ReaderTools.astro';
import Show from '../../../components/zones/Show.astro';
import Hide from '../../../components/zones/Hide.astro';
import NotesTeaser from '../../../components/zones/NotesTeaser.astro';
import ZonePage from '../../../components/zones/ZonePage.astro';
import ItemList from '../../../components/zones/ItemList.astro';
import ItemCard from '../../../components/zones/ItemCard.astro';
import ItemOnly from '../../../components/zones/ItemOnly.astro';
import NoIndex from '../../../components/zones/NoIndex.astro';
import CheckPanel from '../../../components/CheckPanel.astro';
import { PREFIX } from '../../../lib/curriculum';

type Kind = ZoneKind;
const KINDS = ZONE_KINDS;

export async function getStaticPaths() {
  const zonesBy = new Map<string, Zones>();
  const lists = new Map<Lang, Awaited<ReturnType<typeof tutorialsFor>>>();
  for (const lang of LANGS) {
    const list = await tutorialsFor(lang);
    lists.set(lang, list);
    for (const x of list) zonesBy.set(`${lang}:${x.slug}`, await zonesFor(x.entry));
  }
  const paths = [];
  for (const lang of LANGS) {
    const list = lists.get(lang)!;
    for (const [i, x] of list.entries()) {
      const sameTrack = list.filter((y) => y.entry.data.track === x.entry.data.track);
      const j = sameTrack.indexOf(x);
      const zones = zonesBy.get(`${lang}:${x.slug}`)!;
      const props = { item: x, trackList: sameTrack, prev: sameTrack[j - 1], next: sameTrack[j + 1], all: list, index: i, zones };
      paths.push({ params: { lang, slug: chapterSlug(x.slug) }, props: { ...props, mode: 'main' as const } });
      for (const kind of ZONE_KINDS) {
        const zone = zones[kind];
        if (!zone) continue;
        paths.push({ params: { lang, slug: `${chapterSlug(x.slug)}/${kind}` }, props: { ...props, mode: kind } });
        // The same item in the other language (the notes and guides come in the same order in both), for the language switch.
        zone.items.forEach((it, k) => {
          const alternates = Object.fromEntries(LANGS.filter((l) => l !== lang).map((l) => {
            const other = zonesBy.get(`${l}:${x.slug}`)?.[kind];
            const twin = other && other.items.length === zone.items.length ? other.items[k] : undefined;
            return [l, twin ? `/${l}/learn/${x.slug}/${kind}/${twin.slug}/` : other ? `/${l}/learn/${x.slug}/${kind}/` : `/${l}/learn/${x.slug}/`];
          }));
          paths.push({ params: { lang, slug: `${chapterSlug(x.slug)}/${kind}/${it.slug}` }, props: { ...props, mode: kind, itemIndex: k, alternates } });
        });
      }
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const zh = lang === 'zh-tw';
const t = useT(lang);
const { item, trackList, prev, next, all, mode, zones, itemIndex, alternates } = Astro.props as typeof Astro.props & { itemIndex?: number; alternates?: Partial<Record<Lang, string>> };
const { entry, slug, fallback } = item;
const d = entry.data;
const kind: Kind | undefined = mode === 'notes' || mode === 'papers' ? mode : undefined;
const notesPage = kind !== undefined;
const zone = kind ? zones[kind] : undefined;
const sub = zone && itemIndex !== undefined ? zone.items[itemIndex] : undefined;
const chapterLabs = notesPage ? [] : chapterExperiments(slug);
const { Content, headings } = await renderTutorial(entry);
const isRefs = (h: { depth: number; text: string }) => h.depth === 2 && /^(references|參考文獻)$/i.test(h.text.trim());

// Page addresses.
const tutorialUrl = url(`/${lang}/learn/${slug}/`);
const zoneUrl = (k: Kind) => url(`/${lang}/learn/${slug}/${k}/`);
const itemUrl = (k: Kind, id: string) => url(`/${lang}/learn/${slug}/${k}/${id}/`);
const L = {
  chapter: zh ? '正文' : 'Chapter',
  notes: zh ? '補充資料' : 'Supplementary notes',
  papers: zh ? '論文導讀' : 'Paper guides',
  parts: zh ? '本章各部分' : 'Parts of this chapter',
  back: zh ? '← 回到正文' : '← Back to the chapter',
  prevItem: zh ? '← 上一則' : '← Previous',
  nextItem: zh ? '下一則 →' : 'Next →',
  firstItem: zh ? '從第一則開始 →' : 'Start with the first →',
  allItems: (k: Kind) => (k === 'papers' ? (zh ? '所有論文導讀' : 'All paper guides') : (zh ? '所有補充資料' : 'All supplementary notes')),
};

// Tabs under the title: the chapter and its optional sections (shown only when there is at least one).
const tabs = [
  { label: L.chapter, href: tutorialUrl, count: undefined as number | undefined, current: mode === 'main' ? 'page' as const : undefined },
  ...KINDS.filter((k) => zones[k]).map((k) => ({ label: L[k], href: zoneUrl(k), count: zones[k]!.items.length, current: kind === k ? (sub ? 'true' as const : 'page' as const) : undefined })),
];
// The same sections as groups of links (left rail, side table of contents, section bar).
const groups = KINDS.filter((k) => zones[k]).map((k) => ({
  kind: k, label: L[k], href: zoneUrl(k), current: kind === k && !sub,
  items: zones[k]!.items.map((x) => ({ text: x.text, href: itemUrl(k, x.slug), current: kind === k && sub?.slug === x.slug })),
}));

// The track as a tree (src/content/curriculum.ts) for the rail and the section bar; the branch of this tutorial starts open.
// Book contents: each node carries its number without the course code ("02A"; the sidebar heading names the course).
const code = PREFIX[d.track] ?? '';
const numberParts = (x: TutorialItem) => {
  const full = x.place.number;
  const title = x.entry.data.title;
  if (!full || !title.startsWith(full)) return { num: undefined, text: undefined };
  return { num: code && full.startsWith(`${code} `) ? full.slice(code.length + 1) : full, text: title.slice(full.length).replace(/^\s*[·・]\s*/, '') };
};
const toNode = (x: TutorialNode<TutorialItem>): ChapterNode => ({ slug: x.item.slug, title: x.item.entry.data.title, href: url(`/${lang}/learn/${x.item.slug}/`), children: x.children.map(toNode), ...numberParts(x.item) });
const trackTree = nestTutorials(trackList as TutorialItem[]).map(toNode);
const ancestors = ancestorsOf(trackList as TutorialItem[], slug);
const openBranch = [...ancestors.map((a) => a.slug), slug];
// Breadcrumbs and search titles name the whole chain of chapters above this one ("DLCV 04 › DLCV 04A · …").
const chain = ancestors.map((a) => ({ short: shortTitle(a.entry.data.title), href: url(`/${lang}/learn/${a.slug}/`) }));
const chapterPath = [...chain.map((c) => c.short), d.title].join(' › ');

// Side table of contents: main page — the h2s (and h3s of the section being read); item page — the item's h4s and the
// references; index page — the references.
const toc = !notesPage ? headings.filter((h) => h.depth === 2)
  : sub ? [...sub.subs.map((h) => ({ depth: 4, ...h })), ...headings.filter(isRefs)]
  : headings.filter(isRefs);
const subsOf = new Map<string, { slug: string; text: string }[]>();
if (!notesPage) {
  let cur: string | undefined;
  for (const h of headings) {
    if (h.depth === 2) cur = OPTIONAL_SECTION.test(h.text.trim()) ? undefined : h.slug;
    else if (h.depth === 3 && cur) subsOf.set(cur, [...(subsOf.get(cur) ?? []), { slug: h.slug, text: h.text }]);
  }
}
const zoneHeadingIds = new Set(KINDS.map((k) => zones[k]?.heading.slug).filter(Boolean));

const components = mode === 'main'
  ? { MainZone: Show, SupplementZone: NotesTeaser, PapersZone: NotesTeaser, RestZone: Show, ZoneIntro: Hide, ZoneItems: Hide, ZoneItem: Hide, ItemLead: Hide, ItemBody: Hide }
  : {
      MainZone: Hide, SupplementZone: kind === 'notes' ? ZonePage : Hide, PapersZone: kind === 'papers' ? ZonePage : Hide, RestZone: NoIndex,
      ...(sub ? { ZoneIntro: Hide, ZoneItems: Show, ZoneItem: ItemOnly, ItemLead: Hide, ItemBody: Show }
        : { ZoneIntro: Show, ZoneItems: ItemList, ZoneItem: ItemCard, ItemLead: Show, ItemBody: Hide }),
    };
const pageHeading = sub ? sub.text : zone ? zone.heading.text : d.title;
const pageTitle = notesPage ? `${pageHeading} · ${d.title}` : d.title;
const searchTitle = notesPage ? `${pageHeading} · ${chapterPath}` : chapterPath;
const readLang = fallback ? 'en' : lang;
const minutes = tutorialMinutes(entry.body, readLang);
// Per-section minutes for the section bar, matched to the rendered h2s by position (only when the counts agree).
const bodySections = sectionMinutes(entry.body, readLang);
const h2s = headings.filter((h) => h.depth === 2);
const sectionTime = new Map(bodySections.length === h2s.length ? h2s.map((h, i) => [h.slug, bodySections[i].minutes] as const) : []);
const tocItems = toc.map((h) => ({ slug: h.slug, text: h.text, minutes: notesPage ? 0 : sectionTime.get(h.slug) ?? 0 }));
// Retrieval practice (main page only): the exercise heading, its exercise count and the next tutorial for the closing panel.
const exHeading = notesPage ? undefined : headings.find((h) => h.depth === 2 && EXERCISES.test(h.text.trim()));
const nextInfo = next ? { slug: next.slug, title: next.entry.data.title, minutes: tutorialMinutes(next.entry.body, next.fallback ? 'en' : lang) } : undefined;
const prereqs = d.prereqs.map((p) => all.find((x) => x.slug === p)).filter(Boolean);
const colab = d.notebook ? `https://colab.research.google.com/github/${REPO}/blob/${BRANCH}/${d.notebook}` : undefined;
const notebookUrl = d.notebook ? `https://github.com/${REPO}/blob/${BRANCH}/${d.notebook}` : undefined;
const chapterNumber = item.place.number && d.title.startsWith(item.place.number) ? item.place.number : '';
const titleText = chapterNumber ? d.title.slice(chapterNumber.length).replace(/^\s*[·・]\s*/, '') : d.title;
const updated = formatDate(d.updated ?? d.published, lang);
const editUrl = `https://github.com/${REPO}/edit/${BRANCH}/${entry.filePath}`;
const n = zone?.items.length ?? 0;
const pos = sub && itemIndex !== undefined ? itemIndex + 1 : 0;
const prevSub = zone && itemIndex !== undefined ? zone.items[itemIndex - 1] : undefined;
const nextSub = zone && itemIndex !== undefined ? zone.items[itemIndex + 1] : undefined;
const zonePaths = kind && zone ? { index: zoneUrl(kind), items: zone.items.map((x) => url(`/${lang}/learn/${slug}/${kind}/${x.slug}/`)) } : undefined;
---
<Base lang={lang} title={pageTitle} description={d.description} alternates={alternates}>
  <div class="wrap tut" style={`--tc: var(--t-${d.track})`}>
    <nav class="rail" id="book-rail" aria-label={`${t('tut.contents')}: ${t(`track.${d.track}`)}`} data-pagefind-filter={`${t('search.fLevel')}:${t(`level.${d.level}`)}`}>
      <div class="rail-head">
        <a class="rail-course" href={url(`/${lang}/learn/#${d.track}`)}>{code && <span class="rail-code">{code}</span>}<span class="rail-name">{t(`track.${d.track}`)}</span></a>
        <button type="button" class="rail-hide" aria-controls="book-rail" aria-expanded="true" title={t('tut.hideContents')} hidden>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="M9.5 4.5v15M15.5 10l-2 2 2 2"/></svg>
          <span class="sr-only">{t('tut.hideContents')}</span>
        </button>
      </div>
      <ol class="ct-tree">
        <ChapterTree nodes={trackTree} current={slug} currentIsPage={mode === 'main'} open={openBranch} groups={groups} idPrefix="rail" lang={lang} />
      </ol>
      <a class="tree-link" href={url(`/${lang}/learn/tree/`)}>{zh ? '查看完整課程樹 →' : 'View the whole course tree →'}</a>
    </nav>

    <article data-pagefind-filter={`${t('search.fType')}:${t('search.tutorial')}`}>
      <div class="ch-top">
        <button type="button" class="rail-show" aria-controls="book-rail" aria-expanded="false" hidden>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="M9.5 4.5v15M13.5 10l2 2-2 2"/></svg>
          <span>{t('tut.contents')}</span>
        </button>
        <nav class="crumbs" aria-label={t('nav.breadcrumb')}><a href={url(`/${lang}/learn/`)}>{t('learn.title')}</a> / <a href={url(`/${lang}/learn/#${d.track}`)} data-pagefind-filter={t('search.fTrack')}>{t(`track.${d.track}`)}</a>{chain.map((c) => <> / <a href={c.href}>{c.short}</a></>)}{notesPage && <> / <a href={tutorialUrl}>{shortTitle(d.title)}</a></>}{sub && kind && <> / <a href={zoneUrl(kind)}>{L[kind]}</a></>}</nav>
      </div>
      {notesPage ? (
        <>
          <h1 id={sub ? sub.slug : zone?.heading.slug} data-pagefind-meta="title[data-title]" data-title={searchTitle}>{pageHeading}</h1>
          {sub ? (
            <p class="notes-of">{kind === 'papers'
              ? (zh ? <>選讀・<a href={tutorialUrl}>{d.title}</a> 的論文導讀（第 {pos}/{n} 篇）。引用編號對應本頁底部的參考文獻。</>
                    : <>Optional · paper guide {pos} of {n} for <a href={tutorialUrl}>{d.title}</a>. Citation numbers refer to the reference list at the bottom of this page.</>)
              : (zh ? <>選讀・<a href={tutorialUrl}>{d.title}</a> 的補充資料（第 {pos}/{n} 則）。主線不依賴這則補充；引用編號對應本頁底部的參考文獻。</>
                    : <>Optional · supplementary note {pos} of {n} for <a href={tutorialUrl}>{d.title}</a>. Nothing in the main text depends on it; citation numbers refer to the reference list at the bottom of this page.</>)}</p>
          ) : (
            <p class="notes-of">{kind === 'papers'
              ? (zh ? <>選讀：<a href={tutorialUrl}>{d.title}</a> 所依據論文的導讀，每篇一頁：說明它要解決的問題、核心想法、結果，以及閱讀時該注意什麼。</>
                    : <>Optional reading guides to the papers behind <a href={tutorialUrl}>{d.title}</a>, one page each: the problem, the idea, what it showed and what to check when you read it.</>)
              : (zh ? <>選讀：<a href={tutorialUrl}>{d.title}</a> 的補充資料，每則一頁。主線不依賴這些補充資料。</>
                    : <>Optional notes for <a href={tutorialUrl}>{d.title}</a>, one page each. Nothing in the main text depends on them.</>)}</p>
          )}
        </>
      ) : (
        <h1 class="ch-title" data-pagefind-meta={chain.length > 0 ? 'title[data-title]' : undefined} data-title={chain.length > 0 ? searchTitle : undefined}>
          {chapterNumber ? <><span class="ch-num">{chapterNumber}</span><span class="sr-only">{zh ? '・' : ' · '}</span><span class="ch-text">{titleText}</span></> : d.title}
        </h1>
      )}
      {!notesPage && <p class="ch-meta">
        <span>{t(`track.${d.track}`)}</span><span>{t(`level.${d.level}`)}</span><span>{minutes} {t('tut.minutes')}</span><span>{t('tut.updated').replace('{d}', updated)}</span>
      </p>}
      <div class="ch-actions" data-pagefind-ignore>
        {!notesPage && colab && <a class="ch-btn" href={colab}><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M7 4l12 8-12 8z"/></svg>{t('tut.colab')}</a>}
        {!notesPage && notebookUrl && <a class="ch-btn" href={notebookUrl}>{t('tut.notebookShort')}</a>}
      </div>
      {!notesPage && prereqs.length > 0 && (
        <p class="prereqs">{t('tut.needs')}{prereqs.map((p, i) => (<>{i > 0 && (zh ? '、' : ', ')}<a href={url(`/${lang}/learn/${p!.slug}/`)}>{p!.entry.data.title}</a></>))}</p>
      )}
      <div class="ch-bar" data-pagefind-ignore>
        {tabs.length > 1 && (
          <nav class="chapter-tabs" aria-label={L.parts}>
            <ul>{tabs.map((tab) => (
              <li><a href={tab.href} aria-current={tab.current}>{tab.label}{tab.count !== undefined && <span class="count"><span class="sr-only"> (</span>{tab.count}<span class="sr-only">)</span></span>}</a></li>
            ))}</ul>
          </nav>
        )}
        <div class="reader-dock" role="group" aria-label={t('tut.readingTools')} hidden>
          <button type="button" class="rd-btn reader-console-fold-sections" hidden>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 3 4 4 4-4M8 21l4-4 4 4M4 12h16"/></svg>
            <span class="rd-label"></span>
          </button>
          <button type="button" class="rd-btn reader-console-fold-code" hidden>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 7-5 5 5 5m8-10 5 5-5 5"/></svg>
            <span class="rd-label"></span>
          </button>
        </div>
      </div>
      {fallback && <p class="notice" lang="en">{t('tut.notTranslated')}</p>}

      <ReaderTools lang={lang} toc={tocItems} tutorialTitle={d.title} trackTitle={t(`track.${d.track}`)} chapters={trackList.map((x) => ({ slug: x.slug, title: x.entry.data.title }))} current={slug} onThisPage={t('tut.onThisPage')}
        subs={groups} trackProgress={!notesPage || !!sub} zone={sub ? zonePaths : undefined} tree={trackTree} open={openBranch} currentIsPage={mode === 'main'} />

      {chapterLabs.length > 0 && <details class="chapter-playgrounds" data-pagefind-ignore>
        <summary><strong>{zh ? '用實驗理解本章' : 'Explore this chapter'}</strong> <span>{zh ? `${chapterLabs.length} 個互動實驗` : `${chapterLabs.length} interactive experiment${chapterLabs.length === 1 ? '' : 's'}`}</span></summary>
        <p>{chapterLabs[0].description[lang]}</p>
        <ul>{chapterLabs.map((lab,i) => <li><a href={url(`/${lang}/playground/#${lab.id}`)}>{i===0 ? (zh ? '先試這個：' : 'Start here: ') : ''}{lab.title[lang]} →</a></li>)}</ul>
      </details>}

      <script>import '../../../scripts/chapter-sections'; import '../../../scripts/book-rail';</script>
      <div class="prose" data-fold-sections data-fold-level={sub ? 'item' : '2'} lang={fallback ? 'en' : undefined}>
        <Content lang={fallback ? 'en' : lang} components={components} />
      </div>

      {exHeading && <CheckPanel lang={lang} exercisesId={exHeading.slug} count={exerciseCount(entry.body)} next={nextInfo} track={d.track} />}

      <div class="after">
        <a href={editUrl}>{t('tut.edit')}</a>
        {notesPage && notebookUrl && <a href={notebookUrl}>{t('tut.notebook')}</a>}
      </div>
      {sub && kind ? (
        <nav class="pn" aria-label={zh ? '上一則與下一則' : 'Previous and next items'} data-pagefind-ignore>
          {prevSub ? <a href={itemUrl(kind, prevSub.slug)}><small>{L.prevItem}</small>{prevSub.text}</a> : <a href={zoneUrl(kind)}><small>↑ {L.allItems(kind)}</small>{L[kind]}</a>}
          {nextSub ? <a class="nx" href={itemUrl(kind, nextSub.slug)}><small>{L.nextItem}</small>{nextSub.text}</a> : <span></span>}
          <a class="back" href={tutorialUrl}><small>{L.back}</small>{d.title}</a>
        </nav>
      ) : notesPage && kind ? (
        <nav class="pn" aria-label={t('tut.pager')} data-pagefind-ignore>
          <a href={tutorialUrl}><small>{L.back}</small>{d.title}</a>
          {zone && zone.items[0] ? <a class="nx" href={itemUrl(kind, zone.items[0].slug)}><small>{L.firstItem}</small>{zone.items[0].text}</a> : <span></span>}
        </nav>
      ) : <nav class="pn" aria-label={t('tut.pager')} data-pagefind-ignore>
        {prev ? <a href={url(`/${lang}/learn/${prev.slug}/`)}><small>{t('tut.prev')}</small>{prev.entry.data.title}</a> : <span></span>}
        {next ? <a class="nx" href={url(`/${lang}/learn/${next.slug}/`)}><small>{t('tut.next')}</small>{next.entry.data.title}</a> : <span></span>}
      </nav>}
    </article>

    <nav class="toc" aria-label={t('tut.onThisPage')}>
      {toc.length > 0 && (
        <>
          <p class="side-title">{t('tut.onThisPage')}</p>
          <ul>{toc.filter((h) => notesPage || groups.length === 0 || !zoneHeadingIds.has(h.slug)).map((h) => {
            const subs = subsOf.get(h.slug);
            // h2s only; a section's h3s open on demand.
            return <li><a href={`#${h.slug}`}>{h.text}</a>{subs && <button type="button" class="ct-toggle toc-more" aria-expanded="false" aria-controls={`toc-${h.slug}`}><span class="sr-only">{zh ? `${h.text}：${subs.length} 個小節` : `${h.text}: ${subs.length} subsections`}</span></button>}{subs && <ul class="toc-sub" id={`toc-${h.slug}`} hidden>{subs.map((x) => <li><a href={`#${x.slug}`}>{x.text}</a></li>)}</ul>}</li>;
          })}</ul>
        </>
      )}
    </nav>
  </div>
</Base>

<style>
  /* Book page (d2l.ai-style): one left contents sidebar, one reading column, a small "On this page" at >= 1200 px. */
  .tut { --measure: 42.5rem; --col: 880px; display: grid; grid-template-columns: 264px minmax(0, 1fr) 196px; gap: 0 44px; padding-block: 0 32px; }
  .tut[data-rail='closed'] { grid-template-columns: minmax(0, 1fr) 196px; }
  .tut[data-rail='closed'] .rail { display: none; }
  .tut[data-rail='closed'] article { margin-inline: auto; }

  /* Left: the course's chapters, numbered; the current chapter open to its sub-chapters, notes and paper guides. */
  .rail { font-size: 14px; position: sticky; top: var(--header-h, 0px); align-self: start; max-height: calc(100vh - var(--header-h, 0px)); max-height: calc(100dvh - var(--header-h, 0px)); overflow-y: auto; overscroll-behavior: contain; padding: 24px 14px 24px 0; border-right: 1px solid var(--line); scrollbar-width: thin; }
  .rail-head { display: flex; align-items: center; gap: 4px; margin: 0 0 10px; }
  .rail-course { flex: 1; min-width: 0; display: flex; align-items: center; gap: 8px; min-height: 44px; color: var(--ink); text-decoration: none; font: 650 14px/1.3 var(--f-ui); }
  .rail-course:hover .rail-name { text-decoration: underline; text-underline-offset: 3px; }
