---
// The whole course as a tree, rendered from src/content/curriculum.ts: every track, its main chapters, sub-chapters and
// deeper levels, and each chapter's Supplementary notes and Paper guides (pages of their own, the innermost level). Native
// <details> elements keep it keyboard-operable; it opens to level 2 by default, with "expand all" / "collapse all". Reading
// progress already stored by the tutorial pages (src/scripts/progress.ts) is shown as marks; nothing new is stored.
import Base from '../../../layouts/Base.astro';
import { LANGS, type Lang, useT } from '../../../i18n/ui';
import { TRACKS } from '../../../lib/taxonomy';
import { tutorialsFor, nestTutorials, zonesFor, url, type TutorialNode, type TutorialItem } from '../../../lib/site';
import { ZONE_KINDS, ZONE_LABEL } from '../../../lib/zones';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const zh = lang === 'zh-tw';
const t = useT(lang);
const tutorials = await tutorialsFor(lang);
type Group = { label: string; href: string; items: { text: string; href: string }[] };
type Node = { slug: string; title: string; href: string; groups: Group[]; children: Node[]; depth: number };
const toNode = async (n: TutorialNode<TutorialItem>): Promise<Node> => {
  const zones = await zonesFor(n.item.entry);
  const base = `/${lang}/learn/${n.item.slug}/`;
  return {
    slug: n.item.slug, title: n.item.entry.data.title, href: url(base), depth: n.depth,
    groups: ZONE_KINDS.filter((k) => zones[k]).map((k) => ({ label: ZONE_LABEL[k][lang], href: url(`${base}${k}/`), items: zones[k]!.items.map((it) => ({ text: it.text, href: url(`${base}${k}/${it.slug}/`) })) })),
    children: await Promise.all(n.children.map(toNode)),
  };
};
const tracks = await Promise.all(TRACKS.map(async (track) => ({ track, nodes: await Promise.all(nestTutorials(tutorials.filter((x) => x.entry.data.track === track)).map(toNode)) })));
const L = {
  title: zh ? '課程樹' : 'Course tree',
  lede: zh ? '整個課程的結構：每個單元的主章節、子章節與更深的層級，以及每章各自成頁的補充資料與論文導讀。預設展開到第二層。'
    : 'The structure of the whole course: each track’s main chapters, their sub-chapters and any deeper levels, and each chapter’s Supplementary notes and Paper guides, which are pages of their own. It opens to the second level.',
  expand: zh ? '全部展開' : 'Expand all',
  collapse: zh ? '全部收合' : 'Collapse all',
  legend: zh ? '層級' : 'Levels',
  l1: zh ? '主章節' : 'Main chapter',
  l2: zh ? '子章節' : 'Sub-chapter',
  l3: zh ? '更深的層級' : 'Deeper level',
  l4: zh ? '補充資料與論文導讀' : 'Notes and paper guides',
  optional: (n: number) => (zh ? `選讀 ${n} 頁` : `${n} optional page${n === 1 ? '' : 's'}`),
  read: zh ? '已讀' : 'read',
};
---
<Base lang={lang} title={L.title} description={L.lede} noindex>
  <div class="wrap course-tree">
    <nav class="crumbs" aria-label={t('nav.breadcrumb')}><a href={url(`/${lang}/learn/`)}>{t('learn.title')}</a> / {L.title}</nav>
    <header>
      <h1>{L.title}</h1>
      <p class="lede">{L.lede}</p>
      <div class="bar">
        <dl class="legend" aria-label={L.legend}>
          <div><dt class="k k1" aria-hidden="true"></dt><dd>{L.l1}</dd></div>
          <div><dt class="k k2" aria-hidden="true"></dt><dd>{L.l2}</dd></div>
          <div><dt class="k k3" aria-hidden="true"></dt><dd>{L.l3}</dd></div>
          <div><dt class="k k4" aria-hidden="true"></dt><dd>{L.l4}</dd></div>
        </dl>
        <div class="tools">
          <button type="button" class="btn" data-all="open">{L.expand}</button>
          <button type="button" class="btn" data-all="close">{L.collapse}</button>
        </div>
      </div>
    </header>

    {tracks.filter((x) => x.nodes.length > 0).map(({ track, nodes }) => (
      <section class="track" style={`--tc: var(--t-${track})`} aria-labelledby={`tree-${track}`}>
        <h2 id={`tree-${track}`}><a href={url(`/${lang}/learn/#${track}`)}>{t(`track.${track}`)}</a></h2>
        <ol class="tree">
          {nodes.map(function render(node: Node): any {
            const optional = node.groups.reduce((a, g) => a + g.items.length, 0);
            const head = (
              <span class="head">
                <a class="t" href={node.href} data-tree-path={node.href}>{node.title}</a>
                {node.children.length > 0 && <span class="cnt">{zh ? `${node.children.length} 個子章節` : `${node.children.length} sub-chapter${node.children.length === 1 ? '' : 's'}`}</span>}
              </span>
            );
            const body = (
              <>
                {node.groups.length > 0 && (
                  <details class="items">
                    <summary><span class="cnt">{L.optional(optional)}: {node.groups.map((g) => `${g.label} ${g.items.length}`).join(' · ')}</span></summary>
                    {node.groups.map((g) => (
                      <div class="group">
                        <a class="glabel" href={g.href}>{g.label}</a>
                        <ul>{g.items.map((it) => <li><a href={it.href} data-tree-item={it.href}>{it.text}</a></li>)}</ul>
                      </div>
                    ))}
                  </details>
                )}
                {node.children.length > 0 && <ol>{node.children.map(render)}</ol>}
              </>
            );
            return (
              <li class={`lvl lvl-${Math.min(node.depth, 3)}`}>
                {node.children.length > 0
                  ? <details class="node" open={node.depth < 2 ? true : undefined}><summary>{head}</summary>{body}</details>
                  : <div class="node leaf">{head}{body}</div>}
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </div>
  <div id="tree-labels" hidden data-read={L.read}></div>
</Base>

<script>
  import { statusOf, ratioOf } from '../../../scripts/progress';
  // Expand all / collapse all.
  document.querySelectorAll<HTMLButtonElement>('[data-all]').forEach((b) => b.addEventListener('click', () => {
    const open = b.dataset.all === 'open';
    document.querySelectorAll<HTMLDetailsElement>('.course-tree details').forEach((d) => { d.open = open; });
  }));
  // Reading progress already stored by the tutorial pages: ✓ for finished chapters and read notes, a percentage otherwise.
  const read = document.getElementById('tree-labels')?.dataset.read ?? 'read';
  const mark = (a: HTMLElement, text: string, done: boolean) => {
    const s = document.createElement('span');
    s.className = done ? 'pm done' : 'pm';
    s.textContent = text;
    a.after(s);
  };
  document.querySelectorAll<HTMLAnchorElement>('[data-tree-path]').forEach((a) => {
    const st = statusOf(a.dataset.treePath!);
    if (st.done) mark(a, `✓ ${read}`, true);
    else if (st.started) mark(a, `${Math.round(st.ratio * 100)}%`, false);
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-tree-item]').forEach((a) => { if (ratioOf(a.dataset.treeItem!) >= 0.95) mark(a, '✓', true); });
</script>

<style>
  .course-tree { padding-block: 24px 48px; }
  .crumbs { font: 12px var(--f-mono); color: var(--muted); }
  .crumbs a { color: var(--muted); display: inline-block; padding-block: 5px; }
  h1 { font-size: clamp(30px, 4vw, 42px); margin-block: 8px 10px; }
  .lede { font-family: var(--f-body); font-size: 17px; color: var(--muted); max-width: 70ch; margin: 0 0 16px; }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; padding: 12px 0; border-block: 1px solid var(--line); position: sticky; top: var(--header-h, 0px); background: var(--bg); z-index: 5; }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 0; font: 13px var(--f-ui); color: var(--muted); }
  .legend div { display: flex; align-items: center; gap: 6px; }
  .legend dd { margin: 0; }
  .k { width: 18px; height: 12px; }
  .k1 { border-left: 4px solid var(--accent); background: var(--code-bg); }
  .k2 { border-left: 2px solid var(--line-strong); margin-left: 6px; }
  .k3 { border-left: 2px dashed var(--line-strong); margin-left: 10px; }
  .k4 { border-left: 2px dotted var(--line-strong); margin-left: 14px; opacity: 0.7; }
  .tools { display: flex; gap: 8px; flex-wrap: wrap; }
  .tools .btn { min-height: 44px; }
  .track { padding-top: 24px; }
  .track h2 { font-size: 22px; margin: 0 0 8px; }
  .track h2 a { color: var(--ink); text-decoration: none; border-bottom: 3px solid var(--tc); }
  .tree, .tree ol, .tree ul { list-style: none; margin: 0; padding: 0; }
  .tree { display: grid; gap: 2px; }
  .lvl { min-width: 0; }
  .node > summary, .node.leaf { display: flex; align-items: center; gap: 8px; min-height: 44px; padding: 4px 8px; border-radius: 8px; }
  .node > summary { cursor: pointer; list-style: none; }
  .node > summary::-webkit-details-marker { display: none; }
  .node > summary::before { content: ''; flex: none; width: 7px; height: 7px; border-right: 1.5px solid var(--muted); border-bottom: 1.5px solid var(--muted); transform: rotate(-45deg); margin: 0 4px 0 2px; }
  .node[open] > summary::before { transform: rotate(45deg); margin-top: -4px; }
  .node.leaf { padding-left: 25px; }
  .node > summary:hover, .node.leaf:hover { background: var(--surface); }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; min-width: 0; }
  .t { color: var(--ink); text-decoration: none; overflow-wrap: anywhere; }
  .t:hover { color: var(--accent); text-decoration: underline; }
  .lvl-1 > .node .t { font: 600 16px var(--f-display); }
  .lvl-1 > .node { border-left: 4px solid var(--tc); background: color-mix(in srgb, var(--code-bg) 60%, transparent); border-radius: 0 8px 8px 0; }
  .lvl-1 > .node > summary, .lvl-1 > .node.leaf { border-radius: 0 8px 8px 0; }
  .lvl-2 > .node .t, .lvl-3 > .node .t { font-size: 15px; }
  .cnt { font: 12px var(--f-mono); color: var(--muted); }
  .head :global(.pm) { font: 600 12px var(--f-ui); color: var(--muted); }
  .head :global(.pm.done), .group :global(.pm.done) { color: var(--t-nlp); }
  /* Level 2 and deeper: indented under a connector; the indent stops growing after level 3. */
  .node > ol { margin: 0 0 6px 16px; padding-left: 8px; border-left: 2px solid var(--line); display: grid; gap: 2px; }
  .lvl-2 > .node > ol, .lvl-3 > .node > ol { margin-left: 6px; border-left-style: dashed; }
  /* Innermost level: the chapter's optional pages, lighter. */
  .items { margin: 0 0 6px 24px; font: 13px var(--f-ui); }
  .items > summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; color: var(--muted); width: fit-content; max-width: 100%; }
  .items > summary:hover { color: var(--ink); }
  .group { margin: 0 0 8px; padding-left: 10px; border-left: 2px dotted var(--line); }
  .glabel { font: 600 10.5px var(--f-mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--tc); text-decoration: none; display: inline-block; padding-block: 6px; }
  .group li a { display: inline-block; padding-block: 5px; color: var(--muted); overflow-wrap: anywhere; }
  .group li a:hover { color: var(--ink); }
  @media (max-width: 620px) { .bar { position: static; } .node > ol { margin-left: 8px; padding-left: 6px; } .items { margin-left: 12px; } }
</style>
