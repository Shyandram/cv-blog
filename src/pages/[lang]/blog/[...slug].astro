---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { HTML_LANG, LANGS, LANG_LABEL, type Lang, useT } from '../../../i18n/ui';
import { postsFor, url, formatDate, readingMinutes } from '../../../lib/site';
import { BLOG_TOPIC_LABELS, seriesOf } from '../../../lib/blog-topics';

export async function getStaticPaths() {
  const byLang = Object.fromEntries(await Promise.all(LANGS.map(async (l) => [l, await postsFor(l)] as const)));
  return LANGS.flatMap((lang) =>
    byLang[lang].map((p) => {
      // Link the language switcher to the translation when it exists, else to that language's blog index.
      const alternates = Object.fromEntries(
        LANGS.map((l) => [l, byLang[l].some((q) => q.slug === p.slug) ? `/${l}/blog/${p.slug}/` : `/${l}/blog/`])
      );
      return { params: { lang, slug: p.slug }, props: { post: p.entry, alternates } };
    })
  );
}
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const t = useT(lang);
const { post, alternates } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const topicLabel = BLOG_TOPIC_LABELS[d.category][lang];

// Other language, when this post has a translation.
const other = LANGS.find((l) => l !== lang && alternates[l] === `/${l}/blog/${slug}/`);

// Series block ("Part n of N") and the posts that come next.
const all = await postsFor(lang);
const series = seriesOf(slug);
const seriesPosts = series
  ? series.series.slugs.map((s) => all.find((p) => p.slug === s)).filter((p): p is NonNullable<typeof p> => !!p)
  : [];
const partText = series && t('blog.part').replace('{n}', String(series.part)).replace('{total}', String(series.total));
const next = series ? all.find((p) => p.slug === series.series.slugs[series.part]) : undefined;
const rank = (p: (typeof all)[number]) => (seriesOf(p.slug)?.series === series?.series && series ? 0 : p.entry.data.category === d.category ? 1 : 2);
const more = all
  .filter((p) => p.slug !== slug && p !== next)
  .sort((a, b) => rank(a) - rank(b) || (a.entry.data.topicOrder ?? 99) - (b.entry.data.topicOrder ?? 99))
  .slice(0, next ? 2 : 3);

const minutes = readingMinutes(post.body, lang);
const updated = d.updated && d.updated.valueOf() !== d.published.valueOf() ? d.updated : undefined;
---
<Base lang={lang} title={d.title} description={d.description} alternates={alternates}>
  <article class="post" data-pagefind-filter={`${t('search.fType')}:${t('blog.title')}`}>
    <header class="post-head">
      <nav class="crumbs" aria-label={t('nav.breadcrumb')}><a href={url(`/${lang}/blog/`)}>{t('blog.title')}</a> / <a href={url(`/${lang}/blog/#${d.category}`)}>{topicLabel}</a></nav>
      <h1>{d.title}</h1>
      <p class="subtitle">{d.question ?? d.description}</p>
      <p class="meta">
        <span>{t('blog.readMin').replace('{n}', String(minutes))}</span>
        <span aria-hidden="true">·</span>
        <time datetime={d.published.toISOString().slice(0, 10)}>{formatDate(d.published, lang)}</time>
        {updated && <><span aria-hidden="true">·</span><span>{t('blog.updated')} <time datetime={updated.toISOString().slice(0, 10)}>{formatDate(updated, lang)}</time></span></>}
        {d.checked && <><span aria-hidden="true">·</span><span>{t('blog.checked')} <time datetime={d.checked.toISOString().slice(0, 10)}>{formatDate(d.checked, lang)}</time></span></>}
        {other && <a class="switch" href={url(alternates[other])} hreflang={other} lang={HTML_LANG[other]}>{LANG_LABEL[other]}</a>}
      </p>
    </header>

    {series && seriesPosts.length > 1 && (
      <nav class="series" aria-label={`${series.series.label[lang]}: ${partText}`} data-pagefind-ignore>
        <p class="series-title"><strong>{series.series.label[lang]}</strong> <span>{partText}</span></p>
        <ol>
          {seriesPosts.map((p, i) => (
            <li>
              {p.slug === slug
                ? <span class="here" aria-current="page"><span class="n">{i + 1}</span>{p.entry.data.title}</span>
                : <a href={url(`/${lang}/blog/${p.slug}/`)}><span class="n">{i + 1}</span>{p.entry.data.title}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose"><Content /></div>

    <footer class="post-foot">
      {post.data.original && (
        <p class="original">{t('blog.original')} <a href={post.data.original}>{new URL(post.data.original).hostname.replace(/^www\./, '')}</a></p>
      )}
      {d.tags.length > 0 && (
        <ul class="tags" aria-label={t('blog.tags')}>{d.tags.map((tag) => <li>#{tag}</li>)}</ul>
      )}
    </footer>

    {(next || more.length > 0) && (
      <aside class="more" data-pagefind-ignore aria-label={t('blog.moreFrom')}>
        {next && (
          <section>
            <h2>{t('blog.nextInSeries')}</h2>
            <div class="grid one"><PostCard post={next} lang={lang} featured /></div>
          </section>
        )}
        {more.length > 0 && (
          <section>
            <h2>{t('blog.moreFrom')}</h2>
            <div class="grid">{more.map((p) => <PostCard post={p} lang={lang} />)}</div>
          </section>
        )}
      </aside>
    )}
  </article>
</Base>
<style>
  /* Medium-style reading column: a 680 px text column; figures break out to 1000 px; everything is centered. */
  .post { --post-col: 680px; --post-mid: 820px; --post-wide: 1000px; max-width: calc(var(--post-wide) + 2 * var(--gutter)); margin: 0 auto; padding: 40px var(--gutter) 24px; }
  .post > :where(.post-head, .series, .post-foot) { max-width: var(--post-col); margin-inline: auto; }
  .crumbs { font: 13px var(--f-ui); color: var(--muted); }
  .crumbs a { color: var(--muted); display: inline-block; padding-block: 5px; text-decoration: none; }
  .crumbs a:hover { color: var(--accent); text-decoration: underline; }
  h1 { font: 700 clamp(30px, 5vw, 42px)/1.2 var(--f-display); letter-spacing: -0.016em; margin: 14px 0 0; text-wrap: balance; }
  .subtitle { font: clamp(18px, 2.6vw, 22px)/1.45 var(--f-ui); color: var(--muted); margin: 14px 0 0; text-wrap: pretty; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 12px; margin: 26px 0 0; padding: 6px 0; border-block: 1px solid var(--line); font: 14px var(--f-ui); color: var(--muted); }
  .switch { margin-left: auto; display: inline-flex; align-items: center; min-height: 44px; padding-inline: 4px; color: var(--accent); font-weight: 500; text-decoration: none; }
  .switch:hover { text-decoration: underline; }

  .series { margin-top: 28px; padding: 14px 18px; border: 1px solid var(--line); border-radius: 10px; background: color-mix(in srgb, var(--ink) 2.5%, var(--bg)); font-family: var(--f-ui); }
  .series-title { margin: 0 0 6px; font-size: 13px; color: var(--muted); }
  .series-title strong { color: var(--ink); margin-right: 6px; }
  .series ol { list-style: none; margin: 0; padding: 0; }
  .series li + li { border-top: 1px solid var(--line); }
  .series a, .series .here { display: flex; gap: 12px; align-items: baseline; min-height: 44px; padding-block: 10px; font-size: 15px; line-height: 1.4; text-decoration: none; overflow-wrap: anywhere; }
  .series a { color: var(--ink); }
  .series a:hover { color: var(--accent); }
  .series .here { font-weight: 650; color: var(--ink); }
  .series .n { flex: none; width: 22px; height: 22px; border-radius: 50%; display: inline-grid; place-items: center; font: 600 12px var(--f-ui); border: 1px solid var(--line-strong); color: var(--muted); }
  .series .here .n { background: var(--ink); border-color: var(--ink); color: var(--bg); }

  /* Body copy: large serif, sans headings. */
  .prose { margin-top: 34px; font-size: 20px; line-height: 1.68; }
  .post :global(.prose:lang(zh)), .post :global(:lang(zh) .prose) { font-size: 19px; line-height: 1.95; }
  .post :global(.prose > *) { max-width: var(--post-col); margin-inline: auto; }
  .post :global(.prose > :is(pre, table, .rt-code, .demo, .wide)) { max-width: min(var(--post-mid), 100%); }
  .post :global(.prose > :is(figure, p:has(> img:only-child))) { max-width: min(var(--post-wide), 100%); margin-block: 2em; }
  .post :global(.prose p) { margin-block: 0 1.1em; }
  .post :global(.prose h2) { font: 700 26px/1.25 var(--f-display); letter-spacing: -0.01em; margin: 2.1em auto 0.55em; }
  .post :global(.prose h3) { font: 700 21px/1.35 var(--f-display); margin: 1.8em auto 0.5em; }
  .post :global(.prose h4) { font: 700 18px/1.4 var(--f-display); margin: 1.5em auto 0.4em; }
  .post :global(.prose a) { color: var(--ink); text-decoration-thickness: 1px; text-decoration-color: var(--line-strong); }
  .post :global(.prose a:hover) { color: var(--accent); text-decoration-color: currentColor; }
  .post :global(.prose a.cite) { text-decoration: none; }
  .post :global(.prose ul), .post :global(.prose ol) { padding-left: 1.4em; }
  .post :global(.prose li + li) { margin-top: 0.5em; }
  .post :global(.prose hr) { border: 0; text-align: center; margin-block: 2.4em; }
  .post :global(.prose hr::before) { content: '···'; letter-spacing: 0.6em; color: var(--muted); }

  /* Figures: wider than the text, quiet caption. */
  .post :global(.prose figcaption) { font: 14px/1.55 var(--f-ui); color: var(--muted); max-width: var(--post-col); margin-inline: auto; margin-top: 10px; }

  /* Pull quotes. A quote that opens with a bold lead-in (a labelled aside) stays upright, in a quiet panel. */
  .post :global(.prose blockquote) { margin-block: 1.8em; padding: 0 0 0 22px; border-left: 3px solid var(--ink); color: var(--ink); font-size: 1.14em; line-height: 1.5; font-style: italic; }
  .post :global(.prose blockquote:lang(zh)), .post :global(:lang(zh) .prose blockquote) { font-style: normal; font-size: 1.06em; line-height: 1.8; }
  .post :global(.prose blockquote > :last-child) { margin-bottom: 0; }
  .post :global(.prose blockquote:has(> p > strong:first-child)) { font-style: normal; font-size: 0.92em; line-height: 1.65; padding: 14px 18px; border-left-width: 3px; border-left-color: var(--line-strong); background: color-mix(in srgb, var(--ink) 3%, var(--bg)); border-radius: 0 8px 8px 0; color: var(--ink); }

  /* Tables: no grid, a strong rule under the header, hairlines between rows. */
  .post :global(.prose table) { font: 15px/1.5 var(--f-ui); margin-block: 1.8em; }
  .post :global(.prose th), .post :global(.prose td) { border: 0; border-bottom: 1px solid var(--line); padding: 10px 14px 10px 0; }
  .post :global(.prose th) { background: transparent; border-bottom: 2px solid var(--ink); font-weight: 650; }
  .post :global(.prose tr:last-child td) { border-bottom: 0; }

  .post :global(.prose pre) { border-radius: 8px; }

  /* Further reading and references: smaller, muted. */
  .post :global(.prose #further-reading), .post :global(.prose #references), .post :global(.prose #延伸閱讀), .post :global(.prose #參考文獻) { font-size: 20px; margin-top: 2.6em; padding-top: 1.2em; border-top: 1px solid var(--line); }
  .post :global(.prose :is(#further-reading, #延伸閱讀) ~ :is(ul, ol, p)) { font: 15.5px/1.6 var(--f-ui); color: var(--muted); }
  .post :global(.prose :is(#references, #參考文獻) ~ *) { font: 14px/1.6 var(--f-ui); color: var(--muted); }
  .post :global(.prose :is(#further-reading, #延伸閱讀, #references, #參考文獻) ~ :is(ul, ol) a) { color: var(--ink); }

  .post-foot { margin-top: 40px; display: grid; gap: 14px; }
  .original { margin: 0; padding-top: 16px; border-top: 1px solid var(--line); font: 14px var(--f-ui); color: var(--muted); }
  .original a { color: var(--muted); }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 8px; }
  .tags li { font: 13px var(--f-ui); color: var(--muted); padding: 3px 10px; border: 1px solid var(--line); border-radius: 999px; }

  /* Footer: the next post in the series, then more posts. */
  .more { margin: 56px auto 0; padding-top: 32px; border-top: 1px solid var(--line); max-width: var(--post-wide); display: grid; gap: 36px; }
  .more h2 { font: 700 20px var(--f-display); margin: 0 0 14px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 16px; }
  .grid.one { grid-template-columns: minmax(0, 1fr); }

  @media (max-width: 620px) {
    .post { padding-top: 24px; }
    .prose { font-size: 18px; }
    .post :global(.prose h2) { font-size: 23px; }
    .meta { gap: 0 10px; }
    .switch { margin-left: 0; }
  }
</style>
