---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { LANGS, type Lang, useT } from '../../../i18n/ui';
import { postsFor, url, formatDate, readingMinutes } from '../../../lib/site';

export async function getStaticPaths() {
  const byLang = Object.fromEntries(await Promise.all(LANGS.map(async (l) => [l, await postsFor(l)] as const)));
  return LANGS.flatMap((lang) =>
    byLang[lang].map((p) => {
      // Link the language switcher to the translation when it exists, else to that language's blog index.
      const alternates = Object.fromEntries(
        LANGS.map((l) => [l, byLang[l].some((q) => q.slug === p.slug) ? `/${l}/blog/${p.slug}/` : `/${l}/blog/`])
      );
      return { params: { lang, slug: p.slug }, props: { post: p.entry, alternates } };
    })
  );
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { post, alternates } = Astro.props;
const { Content } = await render(post);
---
<Base lang={lang} title={post.data.title} description={post.data.description} alternates={alternates}>
  <article class="wrap post" data-pagefind-filter={`${t('search.fType')}:${t('blog.title')}`}>
    <div class="crumbs"><a href={url(`/${lang}/blog/`)}>{t('blog.title')}</a></div>
    <h1>{post.data.title}</h1>
    <div class="meta-row">
      <span class="pill">{formatDate(post.data.published, lang)}</span>
      {post.data.updated && <span class="pill updated">{t('blog.updated')} {formatDate(post.data.updated, lang)}</span>}
      <span class="pill">{readingMinutes(post.body, lang)} {t('tut.minutes')}</span>
      {post.data.tags.map((tag) => <span class="pill">#{tag}</span>)}
    </div>
    <div class="prose"><Content /></div>
    {post.data.original && (
      <p class="original">{t('blog.original')} <a href={post.data.original}>{new URL(post.data.original).hostname.replace(/^www\./, '')}</a></p>
    )}
  </article>
</Base>
<style>
  /* Centered column: text at the reading measure, figures/code/math/tables up to --col-max. */
  .post { max-width: calc(var(--col-max) + 2 * var(--gutter)); padding-block: 32px; }
  .post > :not(.prose) { max-width: var(--measure); margin-inline: auto; }
  .post :global(.prose > *) { margin-inline: auto; }
  .crumbs { font: 12px var(--f-mono); }
  .crumbs a { color: var(--muted); display: inline-block; padding-block: 5px; }
  h1 { font-size: clamp(30px, 4vw, 42px); margin-block: 8px 12px; }
  .meta-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; }
  .updated { color: var(--muted); }
  .original { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
  .original a { color: var(--muted); }
</style>
