---
import Base from '../../../layouts/Base.astro';
import { LANGS, LANG_LABEL, type Lang, useT } from '../../../i18n/ui';
import { postsFor, url, formatDate } from '../../../lib/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const posts = await postsFor(lang, { includeUntranslated: true });
---
<Base lang={lang} title={t('blog.title')} noindex>
  <div class="wrap">
    <header class="page-head"><h1>{t('blog.title')}</h1><p>{t('blog.lede')}</p></header>
    <div class="cards">
      {posts.map((p) => (
        <a class="card" href={url(`/${p.lang}/blog/${p.slug}/`)} hreflang={p.lang}>
          <span class="date">{formatDate(p.entry.data.published, lang)}{p.entry.data.updated && ` · ${t('blog.updated')} ${formatDate(p.entry.data.updated, lang)}`}{p.lang !== lang && ` · ${LANG_LABEL[p.lang]}`}</span>
          <h3>{p.entry.data.title}</h3>
          <p>{p.entry.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
