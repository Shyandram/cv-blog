---
import Base from '../../../layouts/Base.astro';
import { LANGS, type Lang, useT } from '../../../i18n/ui';
import { postsFor, url, formatDate } from '../../../lib/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const posts = await postsFor(lang);
---
<Base lang={lang} title={t('blog.title')} noindex>
  <div class="wrap">
    <header class="page-head"><h1>{t('blog.title')}</h1><p>{t('blog.lede')}</p></header>
    <div class="cards">
      {posts.map((p) => (
        <a class="card" href={url(`/${lang}/blog/${p.slug}/`)}>
          <span class="date">{formatDate(p.entry.data.published, lang)}</span>
          <h3>{p.entry.data.title}</h3>
          <p>{p.entry.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
