---
import Base from '../../../layouts/Base.astro';
import { LANGS, LANG_LABEL, type Lang, useT } from '../../../i18n/ui';
import { postsFor, url, formatDate } from '../../../lib/site';
import { BLOG_TOPICS, BLOG_TOPIC_LABELS, BLOG_TOPIC_DESCRIPTIONS, BLOG_START_HERE, seriesOf } from '../../../lib/blog-topics';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const posts = await postsFor(lang, { includeUntranslated: true });
const groups = BLOG_TOPICS.map((topic) => ({ topic, posts: posts.filter((p) => p.entry.data.category === topic)
  .sort((a, b) => (a.entry.data.topicOrder ?? Infinity) - (b.entry.data.topicOrder ?? Infinity)) })).filter((g) => g.posts.length);
const startHere = BLOG_START_HERE.map((s) => ({ ...s, post: posts.find((p) => p.slug === s.slug) })).filter((s) => s.post);
const partLabel = (slug: string) => {
  const s = seriesOf(slug);
  return s && `${s.series.label[lang]} · ${t('blog.part').replace('{n}', String(s.part)).replace('{total}', String(s.total))}`;
};
---
<Base lang={lang} title={t('blog.title')} noindex>
  <div class="wrap blog-wrap">
    <header class="page-head"><h1>{t('blog.title')}</h1><p>{t('blog.lede')}</p></header>
    {startHere.length > 0 && (
      <nav class="start-here" aria-labelledby="start-here-title">
        <h2 id="start-here-title">{t('blog.start')}</h2>
        <ul>
          {startHere.map(({ goal, post }) => (
            <li><span class="goal">{goal[lang]}</span> <a href={url(`/${post!.lang}/blog/${post!.slug}/`)} hreflang={post!.lang}>{post!.entry.data.title}</a></li>
          ))}
        </ul>
      </nav>
    )}
    <p class="list-hint">{lang === 'zh-tw' ? '選擇主題，展開文章清單。系列文章已按閱讀順序排列。' : 'Choose a topic to open its reading list. Series appear in reading order.'}</p>
    <div class="topic-lists" data-disclosure-index>
      {groups.map(({ topic, posts: entries }) => (
        <details class="topic" id={topic}>
          <summary>
            <h2>{BLOG_TOPIC_LABELS[topic][lang]}</h2>
            <span class="count">{entries.length} {lang === 'zh-tw' ? '篇' : entries.length === 1 ? 'post' : 'posts'}</span>
            <span class="description">{BLOG_TOPIC_DESCRIPTIONS[topic][lang]}</span>
          </summary>
          <ol class="post-list">
            {entries.map((p) => (
              <li>
                {partLabel(p.slug) && <span class="series">{partLabel(p.slug)}</span>}
                <a class="post-link" href={url(`/${p.lang}/blog/${p.slug}/`)} hreflang={p.lang}>{p.entry.data.title}</a>
                {p.entry.data.question
                  ? <p><span class="answers">{t('blog.answers')}:</span> {p.entry.data.question}</p>
                  : <p>{p.entry.data.description}</p>}
                <span class="date">{formatDate(p.entry.data.published, lang)}{p.entry.data.updated && ` · ${t('blog.updated')} ${formatDate(p.entry.data.updated, lang)}`}{p.entry.data.checked && ` · ${t('blog.checked')} ${formatDate(p.entry.data.checked, lang)}`}{p.lang !== lang && ` · ${LANG_LABEL[p.lang]}`}</span>
              </li>
            ))}
          </ol>
        </details>
      ))}
    </div>
  </div>
</Base>
<script>import '../../../scripts/disclosure-index';</script>

<style>
  .blog-wrap { max-width: calc(var(--col-max) + 2 * var(--gutter)); }
  .list-hint { color: var(--muted); margin-block: 0 24px; }
  .start-here { margin-block: 0 28px; padding: 16px 20px; border: 1px solid var(--line); border-radius: 6px; }
  .start-here h2 { font-size: 16px; margin: 0 0 8px; }
  .start-here ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .start-here li { line-height: 1.6; overflow-wrap: anywhere; }
  .start-here a { display: inline-block; padding-block: 4px; }
  .goal { font: 12px var(--f-mono); color: var(--muted); margin-right: 6px; }
  .series { display: block; font: 12px var(--f-mono); color: var(--muted); }
  .answers { font-weight: 600; }
  .topic { border-top: 1px solid var(--line); scroll-margin-top: 90px; }
  .topic:last-child { border-bottom: 1px solid var(--line); }
  summary { display: grid; grid-template-columns: 16px minmax(0, 1fr) auto; align-items: center; column-gap: 12px; padding: 22px 4px; cursor: pointer; list-style: none; min-height: 44px; }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: ''; width: 7px; height: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(-45deg); }
  details[open] > summary::before { transform: rotate(45deg); }
  summary:hover h2 { color: var(--accent); }
  summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  h2 { font-size: 22px; margin: 0; }
  .count, .date { font: 12px var(--f-mono); color: var(--muted); }
  .description { grid-column: 2 / -1; margin-top: 6px; color: var(--muted); line-height: 1.6; }
  .post-list { list-style: none; margin: 0 0 22px 28px; padding: 0; display: grid; gap: 20px; }
  .post-list li { min-width: 0; }
  .post-link { display: inline-block; padding-block: 9px; font: 600 18px/1.5 var(--f-display); overflow-wrap: anywhere; }
  .post-list p { max-width: 65ch; margin: 0 0 8px; font-size: 15px; line-height: 1.65; color: var(--muted); }
  @media (max-width: 620px) { h2 { font-size: 20px; } .post-list { margin-left: 16px; } }
</style>
