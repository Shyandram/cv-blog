---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { LANGS, LANG_LABEL, type Lang, useT } from '../../../i18n/ui';
import { postsFor, url, formatDate, readingMinutes } from '../../../lib/site';
import { firstPostImage } from '../../../lib/blog-thumb';
import { BLOG_TOPICS, BLOG_TOPIC_LABELS, BLOG_TOPIC_DESCRIPTIONS, BLOG_START_HERE, seriesOf } from '../../../lib/blog-topics';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const posts = await postsFor(lang, { includeUntranslated: true });
const groups = BLOG_TOPICS.map((topic) => ({ topic, posts: posts.filter((p) => p.entry.data.category === topic)
  .sort((a, b) => (a.entry.data.topicOrder ?? Infinity) - (b.entry.data.topicOrder ?? Infinity)) })).filter((g) => g.posts.length);
const startHere = BLOG_START_HERE.map((s) => ({ ...s, post: posts.find((p) => p.slug === s.slug) })).filter((s) => s.post);
const startSlugs = new Set<string>(startHere.map((s) => s.slug));
const partLabel = (slug: string) => {
  const s = seriesOf(slug);
  return s && `${s.series.label[lang]} · ${t('blog.part').replace('{n}', String(s.part)).replace('{total}', String(s.total))}`;
};
const href = (p: (typeof posts)[number]) => url(`/${p.lang}/blog/${p.slug}/`);
const sizes = '(max-width: 620px) 100vw, 168px';
---
<Base lang={lang} title={t('blog.title')} noindex>
  <div class="blog-wrap">
    <header class="head"><h1>{t('blog.title')}</h1><p>{t('blog.lede')}</p></header>

    {startHere.length > 0 && (
      <section class="start" id="start" aria-labelledby="start-title" data-blog-start>
        <h2 id="start-title" class="label">{t('blog.startHere')}</h2>
        <ul>
          {startHere.map(({ goal, post }) => {
            const p = post!;
            const thumb = firstPostImage(p.entry.body);
            return (
              <li>
                <a class="scard" href={href(p)} hreflang={p.lang}>
                  {thumb && <Image class="scard-img" src={thumb} alt="" width={480} widths={[240, 480]} sizes="(max-width: 700px) 100vw, 320px" loading="lazy" decoding="async" />}
                  <span class="goal">{goal[lang]}</span>
                  <span class="stitle">{p.entry.data.title}</span>
                  <span class="sdesc">{p.entry.data.question ?? p.entry.data.description}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <nav class="chips" aria-label={t('blog.filter')} data-blog-chips>
      <a href="#posts" data-topic="all" aria-current="true">{t('blog.all')} <span>{posts.length}</span></a>
      {groups.map(({ topic, posts: entries }) => (
        <a href={`#${topic}`} data-topic={topic}>{BLOG_TOPIC_LABELS[topic][lang]} <span>{entries.length}</span></a>
      ))}
    </nav>
    <p class="hint" data-blog-hint>{t('blog.hint')}</p>

    <div id="posts" data-blog-list>
      {groups.map(({ topic, posts: entries }) => (
        <section class="topic" id={topic} data-topic={topic} aria-labelledby={`h-${topic}`}>
          <header>
            <h2 id={`h-${topic}`}>{BLOG_TOPIC_LABELS[topic][lang]}</h2>
            <p>{BLOG_TOPIC_DESCRIPTIONS[topic][lang]}</p>
          </header>
          <ol class="post-list">
            {entries.map((p) => {
              const d = p.entry.data;
              const thumb = firstPostImage(p.entry.body);
              const series = partLabel(p.slug);
              return (
                <li class:list={['item', { 'has-thumb': !!thumb }]}>
                  <div class="text">
                    {(series || startSlugs.has(p.slug)) && <span class="kicker">{series}{series && startSlugs.has(p.slug) && ' · '}{startSlugs.has(p.slug) && <b>{t('blog.startHere')}</b>}</span>}
                    <h3><a class="post-link" href={href(p)} hreflang={p.lang}>{d.title}</a></h3>
                    <p>{d.question ?? d.description}</p>
                    <span class="meta">{t('blog.readMin').replace('{n}', String(readingMinutes(p.entry.body, p.lang)))} · {formatDate(d.published, lang)}{d.updated && d.updated.valueOf() !== d.published.valueOf() && ` · ${t('blog.updated')} ${formatDate(d.updated, lang)}`}{d.checked && ` · ${t('blog.checked')} ${formatDate(d.checked, lang)}`}{p.lang !== lang && ` · ${LANG_LABEL[p.lang]}`}</span>
                  </div>
                  {thumb && <Image class="thumb" src={thumb} alt="" width={336} widths={[168, 336]} sizes={sizes} loading="lazy" decoding="async" />}
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </div>
  </div>
</Base>
<script>import '../../../scripts/blog-filter';</script>

<style>
  .blog-wrap { max-width: 860px; margin: 0 auto; padding: 8px var(--gutter) 64px; }
  .head { padding-block: 40px 22px; }
  .head h1 { font: 700 clamp(32px, 5vw, 46px)/1.15 var(--f-display); letter-spacing: -0.016em; }
  .head p { margin: 12px 0 0; font: clamp(17px, 2.4vw, 20px)/1.5 var(--f-body); color: var(--muted); max-width: 56ch; }
  .label { font: 700 13px var(--f-ui); letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); margin: 0 0 12px; }
  :lang(zh) .label { letter-spacing: 0.08em; text-transform: none; }

  /* Start here: one card per reader goal. */
  .start { margin-bottom: 30px; }
  .start ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .start li { display: flex; }
  .scard { display: flex; flex-direction: column; gap: 6px; width: 100%; min-width: 0; padding: 16px 18px 18px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--ink); text-decoration: none; transition: border-color 0.15s, translate 0.15s; }
  .scard:hover { border-color: var(--line-strong); translate: 0 -2px; }
  .scard:hover .stitle { color: var(--accent); }
  .scard-img { height: auto; width: calc(100% + 36px); margin: -16px -18px 8px; border-radius: 9px 9px 0 0; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; background: var(--code-bg); }
  .goal { font: 600 12.5px var(--f-ui); color: var(--accent); }
  .stitle { font: 700 17px/1.3 var(--f-display); overflow-wrap: anywhere; text-wrap: balance; }
  .sdesc { font: 14.5px/1.55 var(--f-body); color: var(--muted); display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  /* Topic chips. */
  .chips { display: flex; flex-wrap: wrap; gap: 8px; padding-block: 14px; border-block: 1px solid var(--line); }
  .chips a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--ink); font: 500 14px var(--f-ui); text-decoration: none; transition: background-color 0.15s, border-color 0.15s; }
  .chips a span { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .chips a:hover { border-color: var(--ink); }
  .chips a[aria-current='true'] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .chips a[aria-current='true'] span { color: inherit; opacity: 0.75; }
  .hint { margin: 12px 0 0; font: 13px var(--f-ui); color: var(--muted); }

  /* Editorial list. */
  .topic { margin-top: 44px; scroll-margin-top: 90px; }
  .topic > header { padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  .topic h2 { font: 700 24px/1.25 var(--f-display); }
  .topic > header p { margin: 6px 0 12px; font: 15px/1.55 var(--f-ui); color: var(--muted); max-width: 62ch; }
  .post-list { list-style: none; margin: 0; padding: 0; }
  .item { position: relative; display: flex; gap: 24px; justify-content: space-between; align-items: flex-start; padding-block: 26px; border-bottom: 1px solid var(--line); }
  .item .text { min-width: 0; flex: 1; display: grid; gap: 6px; }
  .kicker { font: 600 12.5px var(--f-ui); color: var(--muted); }
  .kicker b { color: var(--accent); }
  .item h3 { font: 700 22px/1.3 var(--f-display); margin: 0; text-wrap: balance; overflow-wrap: anywhere; }
  .post-link { color: var(--ink); text-decoration: none; }
  /* The title link covers the whole row, so the thumbnail and text are one target. */
  .post-link::after { content: ''; position: absolute; inset: 0; }
  .post-link:hover { color: var(--accent); }
  .post-link:focus-visible { outline: none; }
  .post-link:focus-visible::after { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 6px; }
  .item p { margin: 0; font: 17px/1.55 var(--f-body); color: var(--muted); max-width: 60ch; }
  .meta { font: 13px var(--f-ui); color: var(--muted); margin-top: 2px; }
  .thumb { flex: none; height: auto; width: 168px; aspect-ratio: 3 / 2; object-fit: cover; object-position: top; border-radius: 6px; border: 1px solid var(--line); background: var(--code-bg); }

  @media (max-width: 760px) { .start ul { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 620px) {
    .item { flex-direction: column-reverse; gap: 14px; }
    .thumb { width: 100%; aspect-ratio: 16 / 9; }
    .item h3 { font-size: 20px; }
  }
  @media (prefers-reduced-motion: reduce) { .scard, .chips a { transition: none; } .scard:hover { translate: none; } }
</style>
