---
import Base from '../../layouts/Base.astro';
import { LANGS, type Lang, useT } from '../../i18n/ui';
import { url } from '../../lib/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const dev = import.meta.env.DEV;
---
<Base lang={lang} title={t('search.title')} noindex>
  <div class="wrap narrow">
    <header class="page-head"><h1>{t('search.title')}</h1></header>
    {dev ? (
      <p class="note">Search is built by Pagefind after <code>npm run build</code>. Use <code>npm run preview</code> to try it locally.</p>
    ) : (
      <div id="search" data-bundle={url('/pagefind/')}></div>
    )}
  </div>
  <link href={url('/pagefind/pagefind-ui.css')} rel="stylesheet" />
<script is:inline define:vars={{ bundle: url('/pagefind/') }}>
  const el = document.getElementById('search');
  if (el) {
    const s = document.createElement('script');
    s.src = bundle + 'pagefind-ui.js';
    s.onload = () => {
      // eslint-disable-next-line no-undef
      new PagefindUI({ element: '#search', bundlePath: bundle, showImages: false, showSubResults: true, autofocus: true });
    };
    document.head.appendChild(s);
  }
</script>
</Base>
<style>
  .narrow { max-width: calc(var(--col-max) + 2 * var(--gutter)); }
  .note { color: var(--muted); }
  #search { --pagefind-ui-primary: var(--accent); --pagefind-ui-text: var(--ink); --pagefind-ui-background: var(--surface); --pagefind-ui-border: var(--line); --pagefind-ui-tag: var(--code-bg); --pagefind-ui-font: var(--f-ui); }
</style>
