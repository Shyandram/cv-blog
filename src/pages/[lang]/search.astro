---
import Base from '../../layouts/Base.astro';
import { LANGS, type Lang, useT } from '../../i18n/ui';
import { TRACKS } from '../../lib/taxonomy';
import { url } from '../../lib/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const dev = import.meta.env.DEV;
// Sample queries shown before anything is typed (each returns results in its language).
const samples = lang === 'zh-tw'
  ? ['直方圖等化', '卷積', '注意力', '梯度下降', '熵', '物件偵測']
  : ['histogram equalization', 'convolution', 'attention', 'gradient descent', 'entropy', 'object detection'];
---
<Base lang={lang} title={t('search.title')} noindex>
  <div class="wrap narrow">
    <header class="page-head"><h1>{t('search.title')}</h1></header>
    {dev ? (
      <p class="note">Search is built by Pagefind after <code>npm run build</code>. Use <code>npm run preview</code> to try it locally.</p>
    ) : (
      <>
        <div id="search" data-bundle={url('/pagefind/')}></div>
        <div class="search-empty" id="search-empty">
          <p class="try-h">{t('search.try')}</p>
          <div class="chips">{samples.map((q) => <button type="button" class="chip-btn" data-q={q}>{q}</button>)}</div>
          <p class="try-h">{t('search.browse')}</p>
          <div class="chips">{TRACKS.map((track) => <a class="chip-btn track" href={url(`/${lang}/learn/#${track}`)} style={`--tc: var(--t-${track})`}>{t(`track.${track}`)}</a>)}</div>
        </div>
      </>
    )}
  </div>
  <link href={url('/pagefind/pagefind-ui.css')} rel="stylesheet" />
<script>
  declare const PagefindUI: new (options: Record<string, unknown>) => { triggerSearch: (term: string) => void };
  const el = document.getElementById('search');
  const empty = document.getElementById('search-empty');
  if (el) {
    const bundle = el.dataset.bundle!;
    const s = document.createElement('script');
    s.src = bundle + 'pagefind-ui.js';
    s.onload = () => {
      const ui = new PagefindUI({ element: '#search', bundlePath: bundle, showImages: false, showSubResults: true, autofocus: true, openFilters: [] });
      // The suggestions show only while the box is empty.
      const sync = () => {
        const input = el.querySelector<HTMLInputElement>('input[type=text], input[type=search]');
        if (empty) empty.hidden = !!input?.value.trim();
      };
      el.addEventListener('input', sync);
      el.addEventListener('click', () => window.setTimeout(sync, 0));
      empty?.querySelectorAll<HTMLButtonElement>('button[data-q]').forEach((b) => b.addEventListener('click', () => {
        ui.triggerSearch(b.dataset.q ?? '');
        if (empty) empty.hidden = true;
        el.querySelector<HTMLInputElement>('input')?.focus();
      }));
      // ?q=… opens the page with a search already run (shareable links to a query).
      const q = new URLSearchParams(location.search).get('q');
      if (q) { ui.triggerSearch(q); if (empty) empty.hidden = true; }
    };
    document.head.appendChild(s);
  }
</script>
</Base>
<style>
  .narrow { max-width: calc(var(--col-max) + 2 * var(--gutter)); }
  .note { color: var(--muted); }
  #search { --pagefind-ui-primary: var(--accent); --pagefind-ui-text: var(--ink); --pagefind-ui-background: var(--surface); --pagefind-ui-border: var(--line); --pagefind-ui-tag: var(--code-bg); --pagefind-ui-font: var(--f-ui); --pagefind-ui-border-radius: var(--radius-control); }
  #search :global(.pagefind-ui__search-input), #search :global(.pagefind-ui__filter-checkbox) { border-color: var(--line-strong); }
  .search-empty { margin-top: 24px; }
  .try-h { font: 600 11px var(--f-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 18px 0 8px; }
  .chips { display: flex; flex-wrap: wrap; gap: 4px 24px; }
  .chip-btn { display: inline-flex; align-items: center; min-height: 44px; padding: 6px 0; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--ink); font: 14px var(--f-ui); text-decoration: none; cursor: pointer; }
  .chip-btn:hover { border-color: var(--accent); color: var(--accent); }
  .chip-btn.track { color: var(--muted); }
</style>
