---
import Base from '../../layouts/Base.astro';
import HeroSobel from '../../components/HeroSobel.astro';
import TrackGrid from '../../components/TrackGrid.astro';
import StudyMap from '../../components/StudyMap.astro';
import { LANGS, type Lang, useT } from '../../i18n/ui';
import { tutorialsFor, postsFor, url, formatDate, tutorialMinutes } from '../../lib/site';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const tutorials = await tutorialsFor(lang);
const posts = await postsFor(lang, { includeUntranslated: true });
const first = tutorials[0];
const mapItems = tutorials.map((x) => ({ ...x, href: url(`/${lang}/learn/${x.slug}/`), minutes: tutorialMinutes(x.entry.body, x.fallback ? 'en' : lang) }));
const latest = [
  ...tutorials.map((x) => ({ kind: 'tut' as const, href: `/${lang}/learn/${x.slug}/`, date: x.entry.data.published, title: x.entry.data.title, desc: x.entry.data.description, track: x.entry.data.track, level: x.entry.data.level })),
  ...posts.map((x) => ({ kind: 'post' as const, href: `/${x.lang}/blog/${x.slug}/`, date: x.entry.data.published, title: x.entry.data.title, desc: x.entry.data.description, track: undefined, level: undefined })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 6);
---
<Base lang={lang} noindex>
  <section class="wrap hero">
    <div>
      <div class="eyebrow">{t('site.tagline')}</div>
      <h1>{t('home.title')}</h1>
      <p>{t('home.lede')}</p>
      <div class="btns">
        {first && <a class="btn primary" href={url(`/${lang}/learn/${first.slug}/`)}>{t('home.start')}</a>}
        <a class="btn" href={url(`/${lang}/learn/`)}>{t('home.browse')}</a>
      </div>
      <p class="resume" id="resume" hidden></p>
    </div>
    <HeroSobel />
  </section>

  <section class="wrap">
    <div class="section-h"><h2>{t('home.curriculum')}</h2></div>
    <TrackGrid lang={lang} items={mapItems} />
  </section>

  <section class="wrap">
    <div class="section-h"><h2>{t('home.latest')}</h2><a href={url(`/${lang}/blog/`)}>{t('home.allPosts')}</a></div>
    <div class="cards">
      {latest.map((x) => (
        <a class="card" href={url(x.href)} style={x.track ? `--tc: var(--t-${x.track})` : undefined}>
          <span class="chip">{x.track ? `${t(`track.${x.track}`)} · ${t(`level.${x.level}`)}` : t('blog.title')}</span>
          <h3>{x.title}</h3>
          <p>{x.desc}</p>
          <span class="date">{formatDate(x.date, lang)}</span>
        </a>
      ))}
    </div>
  </section>
  <StudyMap lang={lang} />
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center; padding-block: 56px 32px; }
  .hero > * { min-width: 0; }
  h1 { font-size: clamp(34px, 5vw, 56px); margin-block: 10px 16px; letter-spacing: -0.01em; }
  .hero p { font-family: var(--f-body); font-size: 19px; color: var(--muted); max-width: 52ch; margin: 0 0 24px; }
  .hero .resume { margin: 18px 0 0; }
  .section-h { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-block: 40px 16px; flex-wrap: wrap; }
  .section-h h2 { font-size: 26px; }
  .section-h a { display: inline-block; padding-block: 5px; }
  @media (max-width: 720px) { .hero { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-block: 32px; } }
</style>
