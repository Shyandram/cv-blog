---
// The home page: hero with a fan of real chapter figures, the course in numbers, how a chapter works, a before/after
// demo, three learning paths and the newest blog posts. Every number and chapter label is computed from the content
// (curriculum tree, tutorial headings, playground registry) at build time; nothing here is typed by hand.
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ImageCompare from '../../components/ImageCompare.astro';
import StudyMap from '../../components/StudyMap.astro';
import { LANGS, LANG_LABEL, type Lang, useT } from '../../i18n/ui';
import { TRACKS } from '../../lib/taxonomy';
import { tutorialsFor, postsFor, zonesFor, renderTutorial, url, readingMinutes, shortTitle } from '../../lib/site';
import { BLOG_START_HERE, BLOG_TOPIC_LABELS, seriesOf } from '../../lib/blog-topics';
import { experiments } from '../../lib/playground/catalog';
import { labs } from '../../lib/playground/labs/registry';
import canny from '../../assets/dip/ch10/compare-canny.png';
import histBefore from '../../assets/dip/ch03/hist-eq-before.png';
import histAfter from '../../assets/dip/ch03/hist-eq-after.png';
import slic from '../../assets/dip/ch10/kmeans-slic.png';
import splat from '../../assets/deep-learning/dl-08-3d-reconstruction/splat-toy.png';
import noising from '../../assets/ml/ml-07-diffusion-flow-matching/forward-noising.png';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (m, k: string) => (k in v ? String(v[k]) : m));
const n = (v: number) => v.toLocaleString(lang === 'zh-tw' ? 'zh-TW' : 'en-US');

const tutorials = await tutorialsFor(lang);
const bySlug = new Map(tutorials.map((x) => [x.slug, x]));
/** A chapter by its curriculum slug: link, displayed title and number (e.g. "IP 03"); a wrong slug fails the build. */
function chapter(slug: string) {
  const x = bySlug.get(slug);
  if (!x) throw new Error(`Home page: no tutorial "${slug}" in the curriculum`);
  return { href: url(`/${lang}/learn/${slug}/`), title: x.entry.data.title, number: x.place.number || shortTitle(x.entry.data.title) };
}

// ---- The course in numbers ----
// Courses: tracks with at least one published chapter. Chapters: published tutorials (one per slug). Two languages: chapters
// whose zh-tw file exists. Paper guides: "###" items under "## Paper guides" in this language's chapters (the same
// headings that become the …/papers/<guide>/ pages). Experiments: the playground's cards (catalog + image labs) plus its
// kernel playground, counted exactly as src/pages/[lang]/playground.astro counts them.
const courses = TRACKS.filter((track) => tutorials.some((x) => x.entry.data.track === track)).length;
const chapters = tutorials.length;
const bilingual = (await tutorialsFor('zh-tw')).filter((x) => !x.fallback).length;
const guides = (await Promise.all(tutorials.map(async (x) => (await zonesFor(x.entry)).papers?.items.length ?? 0))).reduce((a, b) => a + b, 0);
const experimentCount = experiments.length + labs.length + 1;
const numbers = [
  { value: courses, label: t('home.n.courses') },
  { value: chapters, label: bilingual === chapters ? t('home.n.chapters') : fill(t('home.n.chaptersSome'), { k: n(bilingual) }) },
  { value: guides, label: t('home.n.guides') },
  { value: experimentCount, label: t('home.n.labs') },
  { value: 0, label: t('home.n.free') },
];

// ---- Hero figure fan (each card links to the chapter the figure comes from) ----
const ip03 = chapter('image-processing/dip-03-intensity-spatial-filtering');
const ip10 = chapter('image-processing/dip-10-segmentation');
const splatCh = chapter('deep-learning/dl-08-3d-reconstruction');
const diffusionCh = chapter('ml/ml-07-diffusion-flow-matching');

// The "Open IP 03" link goes to the histogram-equalization section; its id is read from this language's headings.
const histSection = (await renderTutorial(bySlug.get('image-processing/dip-03-intensity-spatial-filtering')!.entry)).headings
  .find((h) => h.depth === 3 && /^(histogram equalization|直方圖等化)$/i.test(h.text.trim()))?.slug;
const histHref = histSection ? `${ip03.href}#${encodeURIComponent(histSection)}` : ip03.href;

// ---- Before/after demo: the IP 03 figures, re-encoded as WebP at their own size ----
const [histBeforeImg, histAfterImg] = await Promise.all([histBefore, histAfter].map((src) => getImage({ src, format: 'webp' })));

// ---- Learning paths ----
const paths = [
  { level: 'beginner', track: 'image-processing', title: t('home.paths.beginner'), slugs: ['foundations/images-as-arrays', 'image-processing/dip-02-fundamentals', 'image-processing/dip-03-intensity-spatial-filtering', 'image-processing/dip-04-frequency-domain'] },
  { level: 'intermediate', track: 'ml', title: t('home.paths.intermediate'), slugs: ['ml/ml-02-neural-networks', 'ml/ml-03-convolutional-networks', 'deep-learning/dl-02-image-classification', 'deep-learning/dl-03-object-detection'] },
  { level: 'advanced', track: 'deep-learning', title: t('home.paths.advanced'), slugs: ['ml/ml-07-diffusion-flow-matching', 'deep-learning/dl-04-image-restoration', 'deep-learning/dl-04a-super-resolution', 'deep-learning/dl-10-image-generation'] },
].map((p) => ({ ...p, steps: p.slugs.map(chapter) }));

// ---- From the blog: the three newest posts. Posts published the same day are ordered by the blog's "start here"
// entry points, then by their part in a series, then by slug, so the choice is stable. ----
const startRank = (slug: string) => { const i = BLOG_START_HERE.findIndex((s) => s.slug === slug); return i < 0 ? BLOG_START_HERE.length : i; };
const posts = (await postsFor(lang, { includeUntranslated: true }))
  .sort((a, b) => b.entry.data.published.valueOf() - a.entry.data.published.valueOf()
    || startRank(a.slug) - startRank(b.slug)
    || (seriesOf(a.slug)?.part ?? 0) - (seriesOf(b.slug)?.part ?? 0)
    || a.slug.localeCompare(b.slug))
  .slice(0, 3)
  .map((p) => {
    const s = seriesOf(p.slug);
    const meta = [
      BLOG_TOPIC_LABELS[p.entry.data.category][lang],
      s && fill(t('blog.part'), { n: s.part, total: s.total }),
      `${readingMinutes(p.entry.body, p.lang)} ${t('tut.minutes')}`,
    ].filter(Boolean).join(' · ');
    return { href: url(`/${p.lang}/blog/${p.slug}/`), title: p.entry.data.title, desc: p.entry.data.description, meta, lang: p.lang };
  });

const allPaths = tutorials.map((x) => url(`/${lang}/learn/${x.slug}/`)).join(' ');
const learn = url(`/${lang}/learn/`);
const first = tutorials[0];
---
<Base lang={lang} noindex>
  <div class="home">
    <section class="hero" aria-labelledby="home-title">
      <div class="wrap hero-text">
        <p class="badge rise"><span class="dot" aria-hidden="true"></span>{t('home.badge.free')} · {fill(t('home.badge.langs'), { a: LANG_LABEL.en, b: LANG_LABEL['zh-tw'] })} · {t('home.badge.code')}</p>
        <h1 id="home-title" class="rise r1">{t('home.h1.pre')}<span class="see">{t('home.h1.see')}</span>{t('home.h1.post')}</h1>
        <p class="lede rise r2">{t('home.lede')}</p>
        <div class="cta rise r3">
          {first && <a class="b primary" href={url(`/${lang}/learn/${first.slug}/`)}>{t('home.start')}</a>}
          <a class="b" href={learn}>{fill(t('home.browse'), { n: courses })}</a>
        </div>
        <p class="resume" id="resume" hidden></p>
        <span hidden data-paths={allPaths}></span>
      </div>

      <div class="wrap fan-wrap">
        <ul class="fan" aria-label={t('home.fan')}>
          <li class="card c1">
            <a href={ip10.href}>
              <span class="pic edges">
                <Image src={canny} alt={t('home.fan.edgesAlt')} widths={[240, 480]} sizes="(max-width: 899px) 200px, min(17vw, 226px)" loading="eager" />
                <span class="scan" aria-hidden="true"></span>
              </span>
              <span class="cap"><strong>{ip10.number}</strong> · {t('home.fan.edges')}</span>
            </a>
          </li>
          <li class="card c2">
            <a href={ip03.href}>
              <span class="pic pair">
                <Image src={histBefore} alt={t('home.fan.histeqBefore')} widths={[140, 280]} sizes="(max-width: 899px) 120px, min(10vw, 135px)" loading="eager" />
                <Image src={histAfter} alt={t('home.fan.histeqAfter')} widths={[140, 280]} sizes="(max-width: 899px) 120px, min(10vw, 135px)" loading="eager" />
              </span>
              <span class="cap"><strong>{ip03.number}</strong> · {t('home.fan.histeq')}</span>
            </a>
          </li>
          <li class="card c3">
            <a href={ip10.href}>
              <span class="pic crop">
                <Image src={slic} alt={t('home.fan.slicAlt')} widths={[800, 1550]} sizes="(max-width: 899px) 850px, min(105vw, 1320px)" loading="eager" />
              </span>
              <span class="cap"><strong>{ip10.number}</strong> · {t('home.fan.slic')}</span>
            </a>
          </li>
          <li class="card c4">
            <a href={splatCh.href}>
              <span class="pic wide">
                <Image src={splat} alt={t('home.fan.splatAlt')} widths={[800, 1575]} sizes="(max-width: 899px) 600px, min(50vw, 680px)" loading="eager" />
              </span>
              <span class="cap"><strong>{splatCh.number}</strong> · {t('home.fan.splat')}</span>
            </a>
          </li>
          <li class="card c5">
            <a href={diffusionCh.href}>
              <span class="pic wide">
                <Image src={noising} alt={t('home.fan.diffusionAlt')} widths={[600, 1308]} sizes="(max-width: 899px) 600px, min(45vw, 600px)" loading="eager" />
              </span>
              <span class="cap"><strong>{diffusionCh.number}</strong> · {t('home.fan.diffusion')}</span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <section class="wrap numbers" aria-label={t('home.n.label')}>
      <dl>
        {numbers.map((x) => (
          <div><dt>{x.label}</dt><dd><span data-count={x.value}>{n(x.value)}</span></dd></div>
        ))}
      </dl>
    </section>

    <section class="wrap block" aria-labelledby="how-title">
      <div class="head reveal">
        <p class="kicker">{t('home.how.kicker')}</p>
        <h2 id="how-title">{t('home.how.title')}</h2>
      </div>
      <ol class="steps">
        {[1, 2, 3, 4].map((i) => (
          <li class={`step s${i} reveal`} style={`--d: ${(i - 1) * 150}ms`}>
            <span class="num" aria-hidden="true">{i}</span>
            <h3>{t(`home.how.${i}`)}</h3>
            <p>{t(`home.how.${i}d`)}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap block try" aria-labelledby="try-title">
      <div class="try-text reveal">
        <p class="kicker">{t('home.try.kicker')}</p>
        <h2 id="try-title">{t('home.try.title')}</h2>
        <p>{fill(t('home.try.text'), { ch: ip03.number })}</p>
        <a class="more" href={histHref}>{fill(t('home.try.open'), { ch: ip03.number })}</a>
      </div>
      <div class="try-demo reveal" style="--d: 150ms">
        <ImageCompare before={histBeforeImg.src} after={histAfterImg.src} beforeLabel={t('home.try.before')} afterLabel={t('home.try.after')} alt={t('home.try.alt')} sweep />
      </div>
    </section>

    <section class="wrap block" aria-labelledby="paths-title">
      <div class="head row reveal">
        <div>
          <p class="kicker">{t('home.paths.kicker')}</p>
          <h2 id="paths-title">{t('home.paths.title')}</h2>
        </div>
        <a class="more" href={learn}>{fill(t('home.paths.all'), { n: courses })}</a>
      </div>
      <div class="paths">
        {paths.map((p, i) => (
          <article class="path reveal" style={`--tc: var(--t-${p.track}); --d: ${i * 150}ms`}>
            <span class="level">{t(`level.${p.level}`)}</span>
            <h3>{p.title}</h3>
            <ol>
              {p.steps.map((s) => <li><a href={s.href}>{s.title}</a></li>)}
            </ol>
            <a class="more" href={p.steps[0].href}>{t('home.paths.start')}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="wrap block blog" aria-labelledby="blog-title">
      <div class="head row reveal">
        <h2 id="blog-title">{t('home.blog')}</h2>
        <a class="more" href={url(`/${lang}/blog/`)}>{t('home.allPosts')}</a>
      </div>
      <div class="posts">
        {posts.map((p, i) => (
          <a class="post reveal" href={p.href} lang={p.lang === lang ? undefined : p.lang} style={`--d: ${i * 120}ms`}>
            <span class="meta">{p.meta}</span>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
  <StudyMap lang={lang} />
</Base>

<script>
  // Scroll-triggered motion. Without JS, or with reduced motion, every number and section is shown in its final state.
  let reduce = false;
  try { reduce = matchMedia('(prefers-reduced-motion: reduce)').matches; } catch {}
  if (!reduce && 'IntersectionObserver' in window) {
    const fmt = new Intl.NumberFormat(document.documentElement.lang.startsWith('zh') ? 'zh-TW' : 'en-US');
    // Numbers count up once (eased), when the band scrolls into view.
    const band = document.querySelector<HTMLElement>('.numbers');
    const counters = [...document.querySelectorAll<HTMLElement>('[data-count]')].filter((el) => +el.dataset.count! > 0);
    if (band && counters.length) {
      counters.forEach((el) => (el.textContent = fmt.format(0)));
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const start = performance.now(), dur = 1600;
        const step = (now: number) => {
          const x = Math.min(1, (now - start) / dur), k = 1 - Math.pow(1 - x, 3);
          counters.forEach((el) => (el.textContent = fmt.format(Math.round(+el.dataset.count! * k))));
          if (x < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }, { threshold: 0.4 });
      io.observe(band);
    }
    // Lower sections rise into place when they scroll into view; anything already on screen is left alone (no flash).
    const below = [...document.querySelectorAll<HTMLElement>('.reveal')].filter((el) => el.getBoundingClientRect().top > innerHeight);
    if (below.length) {
      below.forEach((el) => el.classList.add('pre'));
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.remove('pre');
          io.unobserve(e.target);
        }
      }, { rootMargin: '0px 0px -10% 0px' });
      below.forEach((el) => io.observe(el));
    }
  }
</script>

<style>
  .home { --ease: cubic-bezier(0.2, 0.8, 0.2, 1); --mark: #ffd166; --scan: #1f6fe0; font-family: var(--f-ui); }

  /* ---------- hero ---------- */
  .hero { background: linear-gradient(color-mix(in srgb, var(--accent) 7%, var(--bg)), var(--bg) 70%); padding-top: clamp(40px, 7vw, 88px); }
  .hero-text { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  .badge { display: inline-flex; align-items: center; gap: 8px; margin: 0; padding: 6px 14px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); font-size: 14px; color: var(--muted); max-width: 100%; }
  .dot { flex: none; width: 8px; height: 8px; border-radius: 999px; background: var(--t-nlp); }
  h1 { font-weight: 800; font-size: clamp(38px, 4.4vw + 14px, 76px); line-height: 1.04; letter-spacing: -0.025em; max-width: 1000px; }
  .see { position: relative; isolation: isolate; font-family: 'Source Serif 4 Variable', Georgia, serif; font-style: italic; font-weight: 400; padding-inline: 0.04em; }
  .see::after { content: ''; position: absolute; z-index: -1; left: 0; right: 0; bottom: 0.06em; height: 0.12em; min-height: 5px; border-radius: 3px; background: var(--mark); }
  :lang(zh) .see { font-family: inherit; font-style: normal; font-weight: 800; }
  .lede { margin: 0; font-size: clamp(17px, 0.6vw + 14px, 21px); line-height: 1.55; color: var(--muted); max-width: 760px; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 6px; }
  .b { display: inline-flex; align-items: center; min-height: 48px; padding: 12px 26px; border-radius: 999px; border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); text-decoration: none; font-weight: 600; font-size: 17px; }
  .b.primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .b:hover { border-color: var(--accent); }
  .b.primary:hover { background: color-mix(in srgb, var(--accent) 85%, var(--ink)); }
  .resume { margin: 0; }

  /* The fan: positions are percentages of a 1344 × 430 stage, so it scales with the window without moving anything. */
  .fan-wrap { margin-top: 44px; }
  .fan { position: relative; list-style: none; margin: 0 auto; padding: 0; width: 100%; max-width: 1344px; aspect-ratio: 1344 / 430; }
  .card { position: absolute; margin: 0; background: var(--surface); border-radius: 16px; box-shadow: 0 18px 40px rgb(21 25 30 / 0.12), 0 0 0 1px var(--line); padding: clamp(6px, 0.9vw, 12px); }
  .card a { display: flex; flex-direction: column; gap: 8px; color: var(--muted); text-decoration: none; border-radius: 10px; }
  .card a:hover .cap strong { color: var(--accent); }
  .cap { font-size: 13px; line-height: 1.35; text-align: left; }
  .cap strong { color: var(--ink); }
  .pic { position: relative; display: block; overflow: hidden; border-radius: 10px; background: #ffffff; }
  .pic :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .edges { aspect-ratio: 1; }
  .pair { display: flex; gap: 6px; background: none; }
  .pair :global(img) { flex: 1; min-width: 0; aspect-ratio: 1; border-radius: 8px; }
  .wide { aspect-ratio: 226 / 150; }
  .wide :global(img) { object-position: left center; }
  .c5 .wide { aspect-ratio: 216 / 130; }
  /* SLIC: only the third of the four panels (x 783-1142, y 46-405 of the 1550 × 421 figure). */
  .crop { aspect-ratio: 1; }
  .crop :global(img) { position: absolute; max-width: none; width: 430.56%; height: auto; left: -217.5%; top: -12.78%; object-fit: fill; }
  .c1 { left: 2.23%; top: 16.28%; width: 18.6%; transform: rotate(-5deg); }
  .c2 { left: 20.09%; top: 4.65%; width: 22.32%; transform: rotate(-2deg); }
  .c3 { left: 41.67%; top: 0; width: 24.55%; z-index: 2; box-shadow: 0 24px 50px rgb(21 25 30 / 0.16), 0 0 0 1px var(--line); }
  .c4 { left: 65.48%; top: 9.3%; width: 18.6%; transform: rotate(2deg); }
  .c5 { left: 80.36%; top: 25.58%; width: 17.86%; transform: rotate(5deg); }
  /* The scan line is the top edge of a full-size overlay, so it travels the whole image with `translate` alone. */
  .scan { position: absolute; inset: 0; pointer-events: none; }
  .scan::before { content: ''; position: absolute; left: 0; right: 0; top: -2px; height: 4px; background: var(--scan); box-shadow: 0 0 12px 2px rgb(31 111 224 / 0.55); }

  /* ---------- numbers ---------- */
  .numbers { margin-top: clamp(28px, 4vw, 56px); }
  .numbers dl { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; margin: 0; padding-block: 28px; border-block: 1px solid var(--line); text-align: center; }
  .numbers div { display: flex; flex-direction: column-reverse; gap: 4px; }
  .numbers dd { margin: 0; font: 700 40px/1.1 var(--f-display); font-variant-numeric: tabular-nums; }
  .numbers dt { font-size: 15px; color: var(--muted); }

  /* ---------- sections ---------- */
  .block { padding-top: clamp(64px, 7vw, 96px); }
  .head { display: flex; flex-direction: column; gap: 10px; max-width: 760px; margin-bottom: 32px; }
  .head.row { max-width: none; flex-direction: row; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 12px 24px; }
  .kicker { margin: 0 0 10px; font-size: 15px; font-weight: 600; color: var(--accent); }
  .head:not(.row) .kicker { margin: 0; }
  h2 { font-size: clamp(30px, 2vw + 16px, 44px); line-height: 1.1; letter-spacing: -0.015em; }
  .more { display: inline-block; padding-block: 6px; font-weight: 600; font-size: 16px; text-decoration: none; }
  .more:hover { text-decoration: underline; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .step { background: var(--code-bg); border-radius: 18px; padding: 26px; display: flex; flex-direction: column; gap: 10px; }
  .step h3 { font: 600 19px/1.3 var(--f-ui); }
  .step p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--muted); }
  .num { width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--sc); background: color-mix(in srgb, var(--sc) 14%, var(--surface)); }
  .s1 { --sc: var(--t-nlp); } .s2 { --sc: var(--accent); } .s3 { --sc: var(--t-information-theory); } .s4 { --sc: var(--t-optimization); }

  .try { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 680px); gap: 48px; align-items: center; }
  .try-text { display: flex; flex-direction: column; gap: 14px; }
  .try-text .kicker { margin: 0; }
  .try-text p:not(.kicker) { margin: 0; font-size: 18px; line-height: 1.6; color: var(--muted); }
  .try-text .more { align-self: flex-start; }
  .try-demo :global(.demo) { border-top: 0; padding: 0; margin: 0; }
  .try-demo :global(.cmp) { width: 100%; aspect-ratio: 680 / 420; border-radius: 20px; box-shadow: 0 0 0 1px var(--line); }
  .try-demo :global(.layer) { image-rendering: auto; }
  .try-demo :global(.lbl) { top: auto; bottom: 14px; padding: 4px 10px; border-radius: 999px; font: 13px var(--f-ui); text-transform: none; background: rgb(21 25 30 / 0.7); color: #ffffff; }
  .try-demo :global(.handle::before) { width: 4px; left: -2px; background: #ffffff; box-shadow: none; }
  .try-demo :global(.range) { max-width: none; margin-top: 10px; }

  .paths { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .path { border: 1px solid var(--line); border-radius: 20px; padding: 28px; display: flex; flex-direction: column; gap: 14px; background: var(--surface); }
