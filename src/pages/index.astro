---
// Root: send readers to their language. Static hosting has no server-side redirect,
// so this uses a script with a meta-refresh fallback to English.
import { url } from '../lib/site';
const en = url('/en/');
const zh = url('/zh-tw/');
---
<!doctype html>
<html lang="en" data-en={en} data-zh={zh}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pixels → Perception</title>
    <meta http-equiv="refresh" content={`2; url=${en}`} />
    <link rel="alternate" hreflang="en" href={en} />
    <link rel="alternate" hreflang="zh-Hant-TW" href={zh} />
    <script>
      const en = document.documentElement.dataset.en!;
      const zh = document.documentElement.dataset.zh!;
      let pick = en;
      try {
        const saved = localStorage.getItem('lang');
        const langs = navigator.languages || [navigator.language];
        if (saved === 'zh-tw' || (!saved && langs.some((l) => /^zh(-(tw|hk|hant|mo))?/i.test(l) && !/^zh-(cn|sg|hans)/i.test(l)))) pick = zh;
      } catch {}
      location.replace(pick);
    </script>
  </head>
  <body>
    <p><a href={en}>English</a> · <a href={zh}>繁體中文</a></p>
  </body>
</html>
