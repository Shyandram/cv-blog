---
import { getCollection } from 'astro:content';
import { LANGS, LANG_LABEL, type Lang, useT } from '../i18n/ui';
import { TRACKS, LEVELS } from '../lib/taxonomy';
import { splitId, url } from '../lib/site';
import { proseCount } from '../lib/content-stats';
import { experiments } from '../lib/playground/catalog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh-tw', t = useT(lang);
const tutorials = await getCollection('tutorials', e => !e.data.draft);
const posts = await getCollection('posts', e => !e.data.draft);
const unique = (entries: { id: string }[]) => new Set(entries.map(e => splitId(e.id).slug)).size;
const n = (value: number) => value.toLocaleString(zh ? 'zh-TW' : 'en-US');
const languages = LANGS.map(language => {
  const ts = tutorials.filter(e => splitId(e.id).lang === language);
  const ps = posts.filter(e => splitId(e.id).lang === language);
  const counts = [...ts, ...ps].map(e => proseCount(e.body ?? '', e.filePath?.endsWith('.mdx') ? 'mdx' : 'md'));
  return { language, tutorials: ts.length, posts: ps.length,
    words: counts.reduce((sum, c) => sum + c.words, 0),
    characters: counts.reduce((sum, c) => sum + c.characters, 0) };
});
const notebookCount = new Set(tutorials.map(e => e.data.notebook).filter(Boolean)).size;
const activeTracks = TRACKS.filter(track => tutorials.some(e => e.data.track === track));
const cards = [
  [activeTracks.length, zh ? '學習單元' : 'Learning tracks'],
  [unique(tutorials), zh ? '教學主題' : 'Tutorial topics'],
  [tutorials.length + posts.length, zh ? '教學與部落格頁面' : 'Tutorial & blog pages'],
  [experiments.length + 2, zh ? '互動實驗' : 'Interactive experiments'],
  [notebookCount, zh ? '筆記本' : 'Notebooks'],
  [LANGS.length, zh ? '語言' : 'Languages'],
] as const;
---
<section class="site-overview" aria-labelledby="site-overview-title">
  <h2 id="site-overview-title">{zh ? '網站內容總覽' : 'The site at a glance'}</h2>
  <p>{zh ? '從基礎到進階的學習地圖。以下統計涵蓋已發布的教學與部落格文章，隨網站內容更新。' : 'A learning map from foundations to advanced topics. These totals cover published tutorials and blog posts and update with the site’s content.'}</p>
  <dl class="overview-cards">
    {cards.map(([value, label]) => <div><dt>{label}</dt><dd>{n(value)}</dd></div>)}
  </dl>
  <p class="count-note">{zh ? '教學主題依內容識別碼去除語言版本的重複；頁面數則分別計入各語言版本，不含首頁、索引頁與草稿。' : 'Tutorial topics count each topic once across languages. Page totals count each language edition separately and exclude landing pages, indexes, and drafts.'}</p>

  <h3>{zh ? '各語言的篇數與字數' : 'Content and reading volume by language'}</h3>
  <div class="language-stats">
    {languages.map(row => <article>
      <h4>{LANG_LABEL[row.language]}</h4>
      <p>{n(row.tutorials)} {zh ? '篇教學' : 'tutorials'} · {n(row.posts)} {zh ? '篇部落格文章' : 'blog posts'}</p>
      <p class="reading-count"><strong>{n(row.language === 'en' ? row.words : row.characters)}</strong> {row.language === 'en' ? (zh ? '英文單字' : 'English words') : (zh ? '漢字' : 'Chinese characters')}</p>
      {row.language === 'zh-tw' && <p>{zh ? '另含' : 'Plus'} {n(row.words)} {zh ? '個非漢字詞彙（含數字）' : 'non-Chinese words and numbers'}</p>}
    </article>)}
  </div>
  <p class="count-note">{zh ? '字數為正文的近似統計，包含標題、練習與參考文獻的文字；不計程式碼、公式、頁面中繼資料、連結網址與元件屬性。英文以字詞計數，中文以漢字計數，兩者不直接相加。' : 'Approximate prose counts include headings, exercises, and reference text. Code, equations, metadata, link destinations, and component attributes are excluded. English words and Chinese characters are different units and are not added together.'}</p>

  <h3>{zh ? '完整學習索引' : 'The learning index'}</h3>
  <table class="track-index">
    <caption>{zh ? '各單元已發布的教學篇數' : 'Published tutorials in each track'}</caption>
    <thead><tr><th scope="col">{zh ? '單元' : 'Track'}</th><th scope="col" lang="en">EN</th><th scope="col">繁中</th></tr></thead>
    <tbody>{activeTracks.map(track => <tr>
      <th scope="row"><a href={url(`/${lang}/learn/#${track}`)}>{t(`track.${track}`)}</a></th>
      {LANGS.map(language => <td>{n(tutorials.filter(e => e.data.track === track && splitId(e.id).lang === language).length)}</td>)}
    </tr>)}</tbody>
    <tfoot><tr><th scope="row">{zh ? '合計' : 'Total'}</th>{languages.map(row => <td>{n(row.tutorials)}</td>)}</tr></tfoot>
  </table>
  <p>{LEVELS.map((level, i) => <>{i > 0 && ' · '}{t(`level.${level}`)}: {n(unique(tutorials.filter(e => e.data.level === level)))}</>)}</p>
  <nav class="overview-links" aria-label={zh ? '網站索引' : 'Site index'}>
    <a href={url(`/${lang}/learn/`)}>{t('nav.learn')} →</a>
    <a href={url(`/${lang}/blog/`)}>{t('nav.blog')} →</a>
    <a href={url(`/${lang}/playground/`)}>{t('nav.playground')} →</a>
  </nav>
</section>

<style>
  .site-overview { margin-block: 2.5rem; }
  .overview-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .overview-cards div, .language-stats article { padding: 20px 0; border-top: 1px solid var(--line); }
  .overview-cards dt { color: var(--muted); font: 13px var(--f-ui); }
  .overview-cards dd { margin: 6px 0 0; font: 700 30px var(--f-display); }
  .language-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .language-stats h4 { margin: 0 0 8px; }
  .language-stats p { margin: 6px 0; font-size: 14px; }
  .reading-count strong { font: 700 26px var(--f-display); margin-inline-end: 0.25em; }
  .count-note { font-size: 13px; color: var(--muted); }
  .site-overview .track-index { display: table; width: 100%; font: 14px var(--f-ui); border-collapse: collapse; }
  .track-index caption { text-align: left; color: var(--muted); margin-bottom: 10px; }
  .track-index th, .track-index td { padding: 10px 8px; border-bottom: 1px solid var(--line); }
  .track-index th { text-align: left; }
  .track-index td, .track-index thead th:not(:first-child) { text-align: right; font-variant-numeric: tabular-nums; }
  .overview-links { display: flex; flex-wrap: wrap; gap: 12px 24px; }
  @media (max-width: 480px) {
    .overview-cards { grid-template-columns: repeat(2, 1fr); }
    .language-stats { grid-template-columns: 1fr; }
  }
</style>
