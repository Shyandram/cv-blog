---
// Shows this browser's reading progress on the learn index and the home page (stored by the tutorial pages; see
// src/scripts/progress.ts). The pages mark up what can carry progress:
//   #resume                 an empty, hidden <p>: filled with a "Continue reading" link to the last place read
//   #review                 an empty, hidden <ul>: exercises due for another try (spaced review)
//   [data-path]             one tutorial (its URL path; data-short = "IP 03", data-ex = exercise heading id): gets a
//                           3 px progress bar, sr-only "42% read" and, when there are any, "2/6 exercises" / "Finished"
//   [data-paths]            a group of tutorials (a track): its .tprog child gets "3 of 13 finished" and a bar
// Nothing is shown without storage.
import { type Lang, useT } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const keys = ['learn.continue', 'learn.read', 'learn.exercises', 'learn.finished', 'learn.notes', 'learn.papers', 'learn.trackDone', 'learn.going', 'review.one', 'review.many'] as const;
const data = Object.fromEntries(keys.map((k) => [`data-${k.replace('.', '-')}`, t(k)]));
---
<div id="study-labels" hidden {...data}></div>

<script>
  import { statusOf, lastPlace, tutorialPathOf, dueExercises, fill } from '../scripts/progress';

  const L = document.getElementById('study-labels')?.dataset ?? {};
  const items = [...document.querySelectorAll<HTMLElement>('[data-path]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-paths]')];
  const known = new Map<string, HTMLElement | undefined>();
  items.forEach((el) => known.set(el.dataset.path!, el));
  groups.forEach((g) => (g.dataset.paths ?? '').split(' ').filter(Boolean).forEach((p) => { if (!known.has(p)) known.set(p, undefined); }));
  const pct = (r: number) => Math.round(r * 100);
  const bar = (host: HTMLElement, ratio: number) => {
    let b = host.querySelector<HTMLElement>(':scope > .pbar');
    if (!b) {
      b = document.createElement('span');
      b.className = 'pbar';
      b.setAttribute('aria-hidden', 'true');
      b.append(document.createElement('span'));
      host.append(b);
    }
    b.style.setProperty('--p', String(ratio));
  };

  // Continue reading: the last place read, if it belongs to a tutorial listed on this page.
  const resume = document.getElementById('resume');
  const last = lastPlace();
  if (resume && last && known.has(tutorialPathOf(last.path))) {
    const a = document.createElement('a');
    a.className = 'resume-link';
    a.href = `${last.path}${last.id ? `#${encodeURIComponent(last.id)}` : ''}`;
    const k = document.createElement('span');
    k.className = 'k';
    k.textContent = L.learnContinue ?? 'Continue reading';
    const v = document.createElement('span');
    v.className = 'v';
    v.textContent = `${last.title}${last.heading ? ` · ${last.heading}` : ''}`;
    a.append(k, v);
    resume.append(a);
    resume.hidden = false;
  }

  // One tutorial: bar for how far the main page was read; visible text only for exercises and finished tutorials.
  for (const el of items) {
    const s = statusOf(el.dataset.path!);
    if (!s.started) continue;
    el.classList.add('has-progress');
    bar(el, s.done ? 1 : s.ratio);
    const st = document.createElement('span');
    st.className = s.done ? 'st done' : 'st';
    const parts: string[] = [];
    if (s.done) parts.push(`✓ ${L.learnFinished ?? 'Finished'}`);
    else if (s.solved > 0) parts.push(fill(L.learnExercises ?? '{k}/{n}', { k: s.solved, n: s.total }));
    if (s.notes > 0.02) parts.push(fill(L.learnNotes ?? '', { p: pct(s.notes) }));
    if (s.papers > 0.02) parts.push(fill(L.learnPapers ?? '', { p: pct(s.papers) }));
    st.textContent = parts.join(' · ');
    if (parts.length === 0) st.className = 'sr-only';
    const sr = document.createElement('span');
    sr.className = 'sr-only';
    sr.textContent = `${parts.length ? ' · ' : ''}${fill(L.learnRead ?? '{p}%', { p: pct(s.ratio) })}`;
    st.append(sr);
    (el.querySelector('.meta') ?? el).append(st);
  }

  // A track: how many of its tutorials are finished.
  for (const g of groups) {
    const paths = (g.dataset.paths ?? '').split(' ').filter(Boolean);
    const all = paths.map(statusOf);
    if (!all.some((s) => s.started)) continue;
    const done = all.filter((s) => s.done).length;
    const out = g.querySelector<HTMLElement>('.tprog');
    if (!out) continue;
    const going = all.filter((s) => s.started && !s.done).length;
    out.textContent = [done > 0 || going === 0 ? fill(L.learnTrackdone ?? '{k}/{n}', { k: done, n: paths.length }) : '', going > 0 ? fill(L.learnGoing ?? '{k}', { k: going }) : ''].filter(Boolean).join(' · ');
    out.hidden = false;
    bar(out, paths.length ? done / paths.length : 0);
  }

  // Spaced review: exercises solved 3, 10 or 30 days ago.
  const review = document.getElementById('review');
  if (review) {
    const due = [...known.keys()].map((p) => ({ p, k: dueExercises(p).length, el: known.get(p) })).filter((x) => x.k > 0).slice(0, 3);
    for (const { p, k, el } of due) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `${p}#${encodeURIComponent(el?.dataset.ex ?? 'exercises')}`;
      a.textContent = fill(k === 1 ? L.reviewOne ?? '' : L.reviewMany ?? '', { k, t: el?.dataset.short ?? p });
      li.append(a);
      review.append(li);
    }
    review.hidden = due.length === 0;
  }
</script>

<style is:global>
  .resume-link { display: inline-grid; gap: 4px; padding: 10px 0; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; font: 15px/1.4 var(--f-ui); max-width: 100%; }
  .resume-link .k { font: 600 11px var(--f-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .resume-link .v { font-weight: 600; overflow-wrap: anywhere; }
  .resume-link .v::after { content: ' →'; }
  .pbar { display: block; height: 3px; border-radius: 2px; background: var(--line); overflow: hidden; }
  .pbar > span { display: block; height: 100%; width: calc(var(--p, 0) * 100%); background: var(--tc, var(--accent)); }
  #review { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; font: 15px var(--f-ui); }
  #review a { display: inline-block; padding-block: 4px; }
  #review a::before { content: '↻ '; }
</style>
