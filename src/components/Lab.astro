---
/**
 * Embed an experiment inside a chapter: <Lab id="frequency-filter" />.
 * Renders the same card as the Playground page, with a link back to the full list.
 */
import ExperimentPlayground from './ExperimentPlayground.astro';
import ImageLab from './ImageLab.astro';
import { experiments, sources, experimentSources } from '../lib/playground/catalog';
import { labs } from '../lib/playground/labs/registry';
import { testImageCredit } from '../lib/playground/labs/sources';
import { LANGS, type Lang } from '../i18n/ui';
interface Props { id: string }
const { id } = Astro.props;
const raw = Astro.params.lang;
const lang: Lang = (LANGS as readonly string[]).includes(String(raw)) ? (raw as Lang) : 'en';
const zh = lang === 'zh-tw';
const lab = labs.find(l => l.id === id);
const exp = experiments.find(e => e.id === id);
const entry = lab ?? exp;
if (!entry) throw new Error(`<Lab id="${id}">: no such experiment`);
const labSources = lab ? [...lab.sources, testImageCredit] : [];
---
<aside class="inline-lab" aria-label={entry.title[lang]}>
  <p class="inline-lab-head"><strong>{zh ? '動手試試' : 'Try it'}</strong> · <span>{entry.title[lang]}</span></p>
  {lab
    ? <ImageLab lab={lab} lang={lang} links={[]} sources={labSources} />
    : <ExperimentPlayground experiment={exp!} lang={lang} links={[]} sources={experimentSources[id] ?? sources[entry.track]} />}
  <p class="inline-lab-foot"><a href={`/${lang}/playground/#${id}`}>{zh ? '在互動實驗頁開啟 →' : 'Open in the Playground →'}</a></p>
</aside>
<style>
  .inline-lab { border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 10px; padding: 16px 18px; margin: 28px 0; background: var(--surface); font-family: var(--f-ui); }
  .inline-lab-head { margin: 0 0 14px; font-size: 14px; color: var(--muted); }
  .inline-lab-head strong { font: 600 11px var(--f-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); }
  .inline-lab-head span { color: var(--ink); font-weight: 600; }
  .inline-lab-foot { margin: 14px 0 0; font-size: 13px; }
</style>
