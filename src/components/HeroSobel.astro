---
import { useT, type Lang } from '../i18n/ui';
interface Props { caption?: string }
const { caption = 'Sobel-x · 3×3' } = Astro.props;
const lang: Lang = /^\/(?:[^/]+\/)*zh-tw\//.test(Astro.url.pathname) ? 'zh-tw' : 'en';
const t = useT(lang);
---
<hero-sobel class="hero-demo">
  <canvas width="192" height="192" aria-label="A Sobel edge filter sweeping across a test image"></canvas>
  <div class="cap">
    <span>{caption}</span>
    <button type="button" class="replay" hidden>↻ {t('hero.replay')}</button>
    <span>192 × 192 px</span>
  </div>
</hero-sobel>
<script>
  import { testImage, convolve } from '../lib/cv';
  // One sweep (about 4 s), then the final frame holds (WCAG 2.2.2). The sweep pauses while the canvas is off-screen and
  // never runs when the reader prefers reduced motion; the replay button starts it again.
  const DURATION = 4000;
  class HeroSobel extends HTMLElement {
    connectedCallback() {
      const N = 192, src = testImage(N);
      const edge = convolve(src, N, [-1, 0, 1, -2, 0, 2, -1, 0, 1], 3).map((v) => Math.min(1, Math.abs(v) * 1.2));
      const c = this.querySelector('canvas')!, ctx = c.getContext('2d')!, im = ctx.createImageData(N, N);
      const replay = this.querySelector<HTMLButtonElement>('.replay')!;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const draw = (sx: number) => {
        for (let y = 0; y < N; y++)
          for (let x = 0; x < N; x++) {
            const p = y * N + x, o = p * 4, v = Math.round((x < sx ? edge[p] : src[p]) * 255);
            im.data[o] = im.data[o + 1] = im.data[o + 2] = v;
            im.data[o + 3] = 255;
            if (x === sx) { im.data[o] = 31; im.data[o + 1] = 95; im.data[o + 2] = 214; }
          }
        ctx.putImageData(im, 0, 0);
      };
      if (reduce) { draw(Math.floor(N * 0.55)); return; }
      let elapsed = 0, last = 0, running = false, visible = true, raf = 0;
      const tick = (now: number) => {
        if (last) elapsed += now - last;
        last = now;
        const done = elapsed >= DURATION;
        draw(done ? N : Math.floor((elapsed / DURATION) * N));
        if (done) { running = false; return; }
        raf = requestAnimationFrame(tick);
      };
      const start = () => { if (running || !visible || elapsed >= DURATION) return; running = true; last = 0; raf = requestAnimationFrame(tick); };
      const pause = () => { if (!running) return; running = false; cancelAnimationFrame(raf); };
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) start(); else pause(); }).observe(c);
      replay.hidden = false;
      replay.addEventListener('click', () => { pause(); elapsed = 0; start(); });
      draw(0);
    }
  }
  if (!customElements.get('hero-sobel')) customElements.define('hero-sobel', HeroSobel);
</script>
<style>
  .hero-demo { display: block; padding: 0; }
  canvas { width: 100%; height: auto; image-rendering: pixelated; border-radius: var(--radius-panel); display: block; }
  .cap { font: 12px var(--f-mono); color: var(--muted); margin-top: 10px; display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
  .replay { font: 12px var(--f-ui); min-height: 44px; padding: 4px 10px; border: 1px solid var(--line-strong); border-radius: var(--radius-panel); background: var(--bg); color: var(--ink); cursor: pointer; }
  .replay:hover { border-color: var(--accent); color: var(--accent); }
</style>
