---
interface Props { caption?: string }
const { caption = 'Sobel-x · 3×3' } = Astro.props;
---
<hero-sobel class="hero-demo">
  <canvas width="192" height="192" aria-label="A Sobel edge filter sweeping across a test image"></canvas>
  <div class="cap"><span>{caption}</span><span>192 × 192 px</span></div>
</hero-sobel>
<script>
  import { testImage, convolve } from '../lib/cv';
  class HeroSobel extends HTMLElement {
    connectedCallback() {
      const N = 192, src = testImage(N);
      const edge = convolve(src, N, [-1, 0, 1, -2, 0, 2, -1, 0, 1], 3).map((v) => Math.min(1, Math.abs(v) * 1.2));
      const c = this.querySelector('canvas')!, ctx = c.getContext('2d')!, im = ctx.createImageData(N, N);
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let sweep = reduce ? N * 0.55 : 0;
      const frame = () => {
        const sx = Math.floor(sweep);
        for (let y = 0; y < N; y++)
          for (let x = 0; x < N; x++) {
            const p = y * N + x, o = p * 4, v = Math.round((x < sx ? edge[p] : src[p]) * 255);
            im.data[o] = im.data[o + 1] = im.data[o + 2] = v;
            im.data[o + 3] = 255;
            if (x === sx) { im.data[o] = 31; im.data[o + 1] = 95; im.data[o + 2] = 214; }
          }
        ctx.putImageData(im, 0, 0);
        if (!reduce && this.isConnected) { sweep = (sweep + 0.6) % (N + 40); requestAnimationFrame(frame); }
      };
      frame();
    }
  }
  if (!customElements.get('hero-sobel')) customElements.define('hero-sobel', HeroSobel);
</script>
<style>
  .hero-demo { display: block; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 16px; }
  canvas { width: 100%; height: auto; image-rendering: pixelated; border-radius: 6px; display: block; }
  .cap { font: 12px var(--f-mono); color: var(--muted); margin-top: 10px; display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
</style>
