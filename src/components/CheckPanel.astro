---
// Retrieval practice for a tutorial's main page.
// - Under the "Exercises" heading: a short prompt (try first; hints contain worked answers) and, after each exercise's hint,
//   a "Solved" checkbox. Both are added by the script below, so the tutorial text itself is unchanged.
// - After the text: a "Check your understanding" panel with the exercises solved so far and the next tutorial.
// Solved exercises are kept in this browser only (pp:x:<path>, see src/scripts/progress.ts); an exercise solved some days
// ago comes back for one more try (3, 10, then 30 days), shown here and on the learn index.
import { type Lang, useT } from '../i18n/ui';
import { url } from '../lib/site';

interface Props {
  lang: Lang;
  exercisesId: string;
  count: number;
  next?: { slug: string; title: string; minutes: number };
  track: string;
}
const { lang, exercisesId, count, next, track } = Astro.props;
const t = useT(lang);
const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (m, k: string) => (k in v ? String(v[k]) : m));
---
<section class="check" aria-labelledby="check-title" data-pagefind-ignore data-ex-id={exercisesId}
  data-prompt={t('ex.prompt')} data-solved={t('ex.solved')} data-which={t('ex.which')}
  data-count={t('check.count')} data-all={t('check.all')} data-due={t('review.due')} data-again={t('review.again')} data-again-done={t('review.done')}
  data-show-hints={t('ex.showHints')} data-hide-hints={t('ex.hideHints')} data-next-label={t('tut.nextLabel')}
  data-next-href={next ? url(`/${lang}/learn/${next.slug}/`) : undefined} data-next-title={next?.title}>
  <h2 id="check-title">{t('check.title')}</h2>
  <div class="check-ex">
    <p class="check-state" aria-live="polite">{fill(t('check.intro'), { n: count })}</p>
    <div class="check-meter" aria-hidden="true" hidden><span></span></div>
    <p class="check-due" hidden></p>
    <a class="check-go" href={`#${exercisesId}`}>{t('check.go')} ↑</a>
  </div>
  {next ? (
    <p class="check-next"><span class="lbl">{t('check.next')}</span> <a href={url(`/${lang}/learn/${next.slug}/`)}>{next.title}</a> <span class="min">· {next.minutes} {t('tut.minutes')}</span></p>
  ) : (
    <p class="check-next">{fill(t('check.last'), { track: t(`track.${track}`) })} <a href={url(`/${lang}/learn/#${track}`)}>{t('check.map')} →</a></p>
  )}
</section>

<script>
  import { exercisesOf, saveExercises, dueExercises, fill } from '../scripts/progress';

  const panel = document.querySelector<HTMLElement>('section.check');
  const heading = panel?.dataset.exId ? document.getElementById(panel.dataset.exId) : null;
  // Runs once the page's sections are folded into <details class="chapter-section"> (src/scripts/chapter-sections.ts).
  const setup = (panel: HTMLElement, heading: HTMLElement) => {
    const L = panel.dataset;
    const path = location.pathname;

    // The exercise section: the body of its folded section, or else the heading's siblings up to the next h2 (or a block
    // that contains one, e.g. a notes card).
    const section = heading.closest<HTMLDetailsElement>('details.chapter-section');
    const body = section?.querySelector<HTMLElement>(':scope > .section-body');
    const blocks: Element[] = [];
    if (body) blocks.push(...body.children);
    else for (let el = heading.nextElementSibling; el && el.tagName !== 'H2' && !el.querySelector('h2'); el = el.nextElementSibling) blocks.push(el);
    const hints = blocks.flatMap((b) => (b.tagName === 'DETAILS' ? [b] : [...b.querySelectorAll('details')])) as HTMLDetailsElement[];

    const prompt = document.createElement('p');
    prompt.className = 'ex-prompt';
    prompt.textContent = L.prompt ?? '';
    if (body) body.prepend(prompt); else heading.after(prompt);

    // Closing row: show or hide every hint at once, and go on to the next chapter.
    if (section && body) {
      section.classList.add('ex-section');
      const tools = document.createElement('div');
      tools.className = 'ex-tools';
      tools.dataset.pagefindIgnore = '';
      if (hints.length) {
        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.className = 'ex-hints';
        const sync = () => {
          const open = hints.every((h) => h.open);
          toggle.textContent = open ? (L.hideHints ?? 'Hide hints') : (L.showHints ?? 'Show hints');
          toggle.setAttribute('aria-pressed', String(open));
        };
        toggle.addEventListener('click', () => { const open = !hints.every((h) => h.open); hints.forEach((h) => { h.open = open; }); sync(); });
        hints.forEach((h) => h.addEventListener('toggle', sync));
        sync();
        tools.append(toggle);
      }
      if (L.nextHref) {
        const nextLink = document.createElement('a');
        nextLink.className = 'ex-next';
        nextLink.href = L.nextHref;
        nextLink.textContent = `${L.nextLabel ?? 'Next: '}${L.nextTitle ?? ''} →`;
        tools.append(nextLink);
      }
      if (tools.children.length) body.append(tools);
    }

    const state = exercisesOf(path);
    state.n = hints.length;
    const due = new Set(dueExercises(path));
    const store = () => saveExercises(path, state);

    const stateEl = panel.querySelector<HTMLElement>('.check-state');
    const meter = panel.querySelector<HTMLElement>('.check-meter');
    const dueEl = panel.querySelector<HTMLElement>('.check-due');
    const render = () => {
      const k = Object.keys(state.s).length;
      const n = state.n;
      if (stateEl && n > 0 && (k > 0 || meter?.hidden === false)) {
        stateEl.textContent = k >= n ? fill(L.all ?? '', { n }) : fill(L.count ?? '', { k, n });
        meter!.hidden = false;
        meter!.style.setProperty('--p', String(k / n));
      }
      if (dueEl) {
        dueEl.hidden = due.size === 0;
        dueEl.textContent = fill(L.due ?? '', { k: due.size });
      }
    };

    hints.forEach((hint, i) => {
      const key = String(i);
      const row = document.createElement('div');
      row.className = 'ex-row';
      const label = document.createElement('label');
      label.className = 'ex-solved';
      const box = document.createElement('input');
      box.type = 'checkbox';
      box.checked = key in state.s;
      const text = document.createElement('span');
      text.textContent = L.solved ?? 'Solved';
      const which = document.createElement('span');
      which.className = 'sr-only';
      which.textContent = ` (${fill(L.which ?? 'exercise {n}', { n: i + 1 })})`;
      label.append(box, text, which);
      row.append(label);
      box.addEventListener('change', () => {
        if (box.checked) state.s[key] = { at: Date.now(), r: 0 };
        else delete state.s[key];
        due.delete(key);
        row.querySelector('.ex-again')?.remove();
        store();
        render();
      });
      // Spaced review: an exercise solved days ago asks for one more try without the hint.
      if (due.has(key)) {
        const again = document.createElement('button');
        again.type = 'button';
        again.className = 'ex-again';
        again.textContent = L.again ?? 'Solved it again';
        again.addEventListener('click', () => {
          const s = state.s[key];
          if (s) { s.r += 1; s.at = Date.now(); }
          due.delete(key);
          again.replaceWith(Object.assign(document.createElement('span'), { className: 'ex-again-done', textContent: L.againDone ?? '' }));
          store();
          render();
        });
        row.append(again);
      }
      hint.after(row);
    });
    if (hints.length > 0) store();
    render();
  };
  if (panel && heading) {
    const run = () => setup(panel, heading);
    if (document.readyState === 'complete') run(); else document.addEventListener('DOMContentLoaded', run, { once: true });
  }
</script>

<style>
  .check { margin: 40px 0 0; padding: 24px 0; border-top: 1px solid var(--line); max-width: var(--measure); font: 15px/1.5 var(--f-ui); }
  .check h2 { font-size: 20px; margin: 0 0 10px; }
  .check-ex { display: grid; gap: 8px; justify-items: start; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .check-state, .check-due, .check-next { margin: 0; }
  .check-due { color: var(--muted); }
  .check-meter { width: min(100%, 280px); height: 6px; border-radius: 3px; background: var(--code-bg); overflow: hidden; }
  .check-meter span { display: block; height: 100%; width: calc(var(--p, 0) * 100%); background: var(--tc, var(--accent)); }
  .check-go { display: inline-block; padding-block: 4px; font-weight: 600; }
  .check-next { padding-top: 14px; }
  .check-next .lbl { font: 600 11px var(--f-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-right: 4px; }
  .check-next a { font-weight: 600; display: inline-block; padding-block: 4px; }
  .check-next .min { color: var(--muted); font-size: 13px; }

  /* Added to the exercise section by the script. */
  :global(.prose .ex-prompt) { font: 15px/1.55 var(--f-ui); color: var(--muted); border-left: 3px solid var(--tc, var(--accent)); padding: 6px 0 6px 12px; }
  :global(.prose .ex-row) { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: -0.4em 0 1.2em; font: 14px var(--f-ui); }
  :global(.prose .ex-solved) { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 2px 10px 2px 6px; border: 1px solid var(--line-strong); border-radius: var(--radius-control); cursor: pointer; color: var(--muted); }
  :global(.prose .ex-solved:has(input:checked)) { color: var(--ink); border-color: var(--tc, var(--accent)); background: color-mix(in srgb, var(--tc, var(--accent)) 10%, transparent); }
  :global(.prose .ex-solved input) { width: 18px; height: 18px; margin: 0; accent-color: var(--tc, var(--accent)); }
  :global(.prose .ex-again) { min-height: 44px; padding: 2px 12px; border: 1px dashed var(--tc, var(--accent)); border-radius: var(--radius-control); background: none; color: var(--ink); font: 14px var(--f-ui); cursor: pointer; }
  :global(.prose .ex-again-done) { color: var(--muted); }
  @media print { .check, :global(.prose .ex-row), :global(.prose .ex-prompt) { display: none; } }
</style>
