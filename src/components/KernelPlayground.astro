---
/**
 * Edit a 3×3 kernel and see it applied to a test image live.
 * <KernelPlayground preset="sobel-x" lang="en" />
 */
interface Props { preset?: string; lang?: 'en' | 'zh-tw' }
const { preset = 'sobel-x', lang = 'en' } = Astro.props;
const L = lang === 'zh-tw'
  ? { title: '卷積核實驗室', hint: '修改任一格或選擇預設，輸出會即時更新。', input: '輸入 I', output: '輸出 G = K ⋆ I', cell: '卷積核第 {r} 列第 {c} 行', shown: ' · 以 0.5 + G/2 顯示',
      presets: { identity: '恆等', 'box-blur': '均值模糊', gaussian: '高斯', sharpen: '銳化', 'sobel-x': 'Sobel x', 'sobel-y': 'Sobel y', laplacian: '拉普拉斯', emboss: '浮雕' } }
  : { title: 'Kernel playground', hint: 'Edit any cell or pick a preset. The output updates as you type.', input: 'Input I', output: 'Output G = K ⋆ I', cell: 'Kernel row {r} column {c}', shown: ' · shown as 0.5 + G/2',
      presets: { identity: 'identity', 'box-blur': 'box blur', gaussian: 'gaussian', sharpen: 'sharpen', 'sobel-x': 'sobel x', 'sobel-y': 'sobel y', laplacian: 'laplacian', emboss: 'emboss' } };
---
<kernel-playground class="demo" data-preset={preset} data-cell-label={L.cell} data-shown={L.shown} data-preset-labels={JSON.stringify(L.presets)}>
  <div class="demo-h"><b>{L.title}</b><span>{L.hint}</span></div>
  <div class="kp">
    <div>
      <div class="kgrid"></div>
      <div class="presets"></div>
      <div class="note sum"></div>
    </div>
    <div class="kp-out">
      <figure><canvas class="in" width="160" height="160"></canvas><figcaption class="note">{L.input}</figcaption></figure>
      <figure><canvas class="out" width="160" height="160"></canvas><figcaption class="note">{L.output}</figcaption></figure>
    </div>
  </div>
</kernel-playground>

<script>
  import { testImage, convolve, drawGray } from '../lib/cv';

  const PRESETS: Record<string, number[]> = {
    identity: [0, 0, 0, 0, 1, 0, 0, 0, 0],
    'box-blur': Array(9).fill(1 / 9),
    gaussian: [1, 2, 1, 2, 4, 2, 1, 2, 1].map((v) => v / 16),
    sharpen: [0, -1, 0, -1, 5, -1, 0, -1, 0],
    'sobel-x': [-1, 0, 1, -2, 0, 2, -1, 0, 1],
    'sobel-y': [-1, -2, -1, 0, 0, 0, 1, 2, 1],
    laplacian: [0, 1, 0, 1, -4, 1, 0, 1, 0],
    emboss: [-2, -1, 0, -1, 1, 1, 0, 1, 2],
  };
  const N = 160;
  const fmt = (v: number) => (Number.isInteger(v) ? String(v) : String(+v.toFixed(3)));

  class KernelPlayground extends HTMLElement {
    connectedCallback() {
      const src = testImage(N);
      drawGray(this.querySelector<HTMLCanvasElement>('canvas.in')!, src, N);
      const out = this.querySelector<HTMLCanvasElement>('canvas.out')!;
      const sumEl = this.querySelector('.sum')!;
      const grid = this.querySelector('.kgrid')!;
      const box = this.querySelector('.presets')!;
      const cellLabel = this.dataset.cellLabel ?? 'Kernel row {r} column {c}';
      const shown = this.dataset.shown ?? ' · shown as 0.5 + G/2';
      const presetLabels: Record<string, string> = JSON.parse(this.dataset.presetLabels ?? '{}');
      const inputs: HTMLInputElement[] = [];
      for (let i = 0; i < 9; i++) {
        const inp = document.createElement('input');
        inp.type = 'text';
        inp.inputMode = 'decimal';
        inp.setAttribute('aria-label', cellLabel.replace('{r}', String((i / 3 | 0) + 1)).replace('{c}', String((i % 3) + 1)));
        inp.addEventListener('input', () => { mark(null); run(); });
        grid.appendChild(inp);
        inputs.push(inp);
      }
      const btns = Object.keys(PRESETS).map((name) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = presetLabels[name] ?? name.replace('-', ' ');
        b.dataset.name = name;
        b.addEventListener('click', () => set(name));
        box.appendChild(b);
        return b;
      });
      const mark = (name: string | null) => btns.forEach((b) => b.classList.toggle('on', b.dataset.name === name));
      const set = (name: string) => { PRESETS[name].forEach((v, i) => (inputs[i].value = fmt(v))); mark(name); run(); };
      const run = () => {
        const K = inputs.map((i) => parseFloat(i.value) || 0);
        const sum = K.reduce((a, b) => a + b, 0);
        const signed = Math.abs(sum) < 1e-6; // zero-sum (edge) kernels are shown around mid-grey
        drawGray(out, convolve(src, N, K, 3), N, signed);
        sumEl.textContent = `Σ K = ${fmt(sum)}${signed ? shown : ''}`;
      };
      set(PRESETS[this.dataset.preset ?? ''] ? this.dataset.preset! : 'sobel-x');
    }
  }
  if (!customElements.get('kernel-playground')) customElements.define('kernel-playground', KernelPlayground);
</script>

<style>
  .kp { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 20px; align-items: start; }
  .kgrid { display: grid; grid-template-columns: repeat(3, 58px); gap: 4px; }
  .kgrid :global(input) { width: 58px; height: 44px; text-align: center; font: 14px var(--f-mono); border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--ink); font-variant-numeric: tabular-nums; }
  .kgrid :global(input:nth-child(5)) { border-color: var(--accent); }
  .presets { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 10px; max-width: 182px; }
  .presets :global(button) { font: 11px var(--f-mono); padding: 4px 7px; border-radius: 5px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); cursor: pointer; }
  .presets :global(button.on) { border-color: var(--accent); color: var(--accent); }
  .kp-out { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  figure { margin: 0; min-width: 0; }
  canvas { width: 100%; height: auto; display: block; border-radius: 6px; }
  .note { font: 11px var(--f-mono); color: var(--muted); margin-top: 6px; }
  @media (max-width: 620px) { .kp { grid-template-columns: minmax(0, 1fr); } }
</style>
