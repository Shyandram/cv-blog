---
/**
 * Optional reading under a subsection heading: <Supplement summary="What it adds">...</Supplement>.
 * The heading stays outside (anchors, outline and search keep working); the body is collapsed by default.
 * Print and the PDF book show it open.
 */
interface Props { summary?: string; lang?: 'en' | 'zh-tw' }
const { summary, lang = Astro.url.pathname.startsWith('/zh-tw') ? 'zh-tw' : 'en' } = Astro.props;
const label = lang === 'zh-tw' ? '補充' : 'Supplementary';
const hint = lang === 'zh-tw' ? '可略過，不影響後續內容' : 'Optional; later sections do not depend on it';
---
<details class="supplement">
  <summary><span class="badge">{label}</span><span class="what">{summary ?? hint}</span></summary>
  <div class="body"><slot /></div>
</details>
<style>
  .supplement { margin: 0 0 1.4em; border: 1px dashed var(--line); border-radius: 8px; }
  summary { cursor: pointer; padding: 9px 14px; font-family: var(--f-ui); display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; font-size: 15px; line-height: 1.5; }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: '▸'; color: var(--muted); font-size: 13px; transition: transform 0.15s; }
  details[open] > summary::before { transform: rotate(90deg); }
  summary:hover .what { color: var(--ink); }
  .badge { font: 600 11px var(--f-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); }
  .what { color: var(--muted); }
  .body { padding: 2px 14px 6px; border-top: 1px dashed var(--line); }
  .body :global(> :first-child) { margin-top: 12px; }
  @media print { .supplement { border-style: solid; } .supplement::details-content { content-visibility: visible; } }
</style>
