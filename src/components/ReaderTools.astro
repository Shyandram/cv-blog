---
// Reading aids for a tutorial page: a thin progress bar; below 1200 px a sticky section bar that names the section being
// read, its position and the minutes left, and opens into "On this page" (per-section minutes, ✓ for sections already
// read), the chapter's sub-chapters (its Supplementary notes and Paper guides pages) and "In this track"; scroll-spy for both
// tables of contents; a back-to-top button. Code disclosures are shared by all prose pages.
// Progress, read sections and the last place read are per-viewer conveniences in localStorage (the page works without it).
import { url } from '../lib/site';
import ChapterTree, { type ChapterNode } from './ChapterTree.astro';
import { type Lang, useT } from '../i18n/ui';

interface Props {
  lang: Lang;
  toc: { slug: string; text: string; minutes?: number }[];
  tutorialTitle: string;
  trackTitle: string;
  chapters: { slug: string; title: string }[];
  current: string;
  onThisPage: string;
  /** The chapter's optional sections, each a group of pages (index + one page per item); `current` marks this page. */
  subs?: { label: string; href: string; current: boolean; items: { text: string; href: string; current: boolean }[] }[];
  /** False on a section index page: its scroll position says nothing about reading. */
  trackProgress?: boolean;
  /** On an item page: the section index path and its items' paths, to keep the section's share read (pp:p:<index>). */
  zone?: { index: string; items: string[] };
  /** The track as a tree (main chapters → sub-chapters → …); without it, `chapters` is shown as a flat list. */
  tree?: ChapterNode[];
  open?: string[];
  currentIsPage?: boolean;
}
const { lang, toc, tutorialTitle, trackTitle, chapters, current, onThisPage, subs = [], trackProgress = true, zone, tree, open = [], currentIsPage = true } = Astro.props;
const t = useT(lang);
const labels = {
  open: t('tut.navigate'),
  top: t('tut.top'),
};
---
<div class="rt-progress" aria-hidden="true"><span></span></div>

<details class="rt-mnav" data-pagefind-ignore>
  <summary>
    <span class="rt-chev" aria-hidden="true"></span>
    <span class="sr-only rt-prefix">{labels.open}: </span>
    <span class="rt-now">{labels.open}</span>
    <span class="rt-pos"></span>
  </summary>
  <div class="rt-mbody">
    {toc.length > 0 && (
      <section class="rt-sections">
        <p class="rt-title">{onThisPage}</p>
        <ul>{toc.map((h) => (
          <li><a href={`#${h.slug}`} data-min={h.minutes || undefined}><span class="rt-text">{h.text}</span>{h.minutes ? <span class="rt-min">{h.minutes} {t('tut.minutes')}</span> : null}</a></li>
        ))}</ul>
      </section>
    )}
    {subs.map((g) => (
      <section class="rt-subs">
        <p class="rt-title"><a href={g.href} aria-current={g.current ? 'page' : undefined}>{g.label} · {g.items.length}</a></p>
        <ol>{g.items.map((x) => <li><a href={x.href} aria-current={x.current ? 'page' : undefined}>{x.text}</a></li>)}</ol>
      </section>
    ))}
    <section class="rt-chapters">
      <p class="rt-title">{trackTitle}</p>
      {tree ? (
        <ol class="ct-tree">
          <ChapterTree nodes={tree} current={current} currentIsPage={currentIsPage} open={open} idPrefix="mnav" lang={lang} />
        </ol>
      ) : (
        <ol>
          {chapters.map((c) => (
            <li><a href={url(`/${lang}/learn/${c.slug}/`)} aria-current={c.slug === current ? 'page' : undefined}>{c.title}</a></li>
          ))}
        </ol>
      )}
      <a class="rt-treelink" href={url(`/${lang}/learn/tree/`)}>{lang === 'zh-tw' ? '查看完整課程樹 →' : 'View the whole course tree →'}</a>
    </section>
  </div>
</details>

<button type="button" class="rt-top" hidden aria-label={labels.top} title={labels.top} data-pagefind-ignore>↑</button>
<div id="rt-labels" hidden
  data-pos={t('tut.sectionPos')} data-left={t('tut.left')} data-sep={lang === 'zh-tw' ? '・' : ' · '} data-read={t('tut.read')} data-tutorial={tutorialTitle}
  data-progress={trackProgress ? undefined : 'off'} data-zone-index={zone?.index} data-zone-items={zone ? JSON.stringify(zone.items) : undefined}></div>

<script>
  import { load, save } from '../scripts/progress';
  const labels = document.getElementById('rt-labels')?.dataset ?? {};
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const path = location.pathname;

  // Sections of this page, in order, with the links that point at them (side TOC and section bar).
  const mnav = document.querySelector<HTMLDetailsElement>('.rt-mnav');
  const barLinks = [...document.querySelectorAll<HTMLAnchorElement>('.rt-sections a[href^="#"]')];
  // Side TOC: the h2 links (sub-lists of h3 links are handled separately).
  const sideLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]')].filter((a) => !a.closest('.toc-sub'));
  const idOf = (a: HTMLAnchorElement) => decodeURIComponent(a.hash.slice(1));
  const sections = barLinks.map((a) => ({ id: idOf(a), text: a.querySelector('.rt-text')?.textContent ?? a.textContent ?? '', minutes: Number(a.dataset.min) || 0, el: document.getElementById(idOf(a)) }))
    .filter((s): s is typeof s & { el: HTMLElement } => !!s.el);
  const linksFor = (id: string) => [...barLinks, ...sideLinks].filter((a) => idOf(a) === id);
  let active = -1;

  // Sections already read (scrolled past) get a ✓ in both tables of contents.
  const readKey = `pp:s:${path}`;
  const read = new Set<string>((() => { try { return JSON.parse(load(readKey) ?? '[]') as string[]; } catch { return []; } })());
  const tick = (id: string) => linksFor(id).forEach((a) => {
    if (a.querySelector('.rt-done')) return;
    const done = document.createElement('span');
    done.className = 'rt-done';
    done.innerHTML = '<span aria-hidden="true">✓</span>';
    const sr = document.createElement('span');
    sr.className = 'sr-only';
    sr.textContent = ` ${labels.read ?? '(read)'}`;
    done.append(sr);
    a.append(done);
  });
  read.forEach(tick);

  // Remember how far this page has been read and where (the learn index shows it and links back to the section).
  let best = Number(load(`pp:p:${path}`)) || 0;
  let ratioNow = 0;
  const tracking = labels.progress !== 'off';
  // An item page also keeps its section's share read up to date (mean over the section's items, each counted read at 95 %).
  const zoneItems = (() => { try { return JSON.parse(labels.zoneItems ?? '[]') as string[]; } catch { return []; } })();
  const rememberZone = () => {
    if (!labels.zoneIndex || zoneItems.length === 0) return;
    const share = zoneItems.reduce((a, p) => a + Math.min(1, (Number(load(`pp:p:${p}`)) || 0) / 0.95), 0) / zoneItems.length;
    save(`pp:p:${labels.zoneIndex}`, share.toFixed(3));
  };
  const remember = () => {
    if (!tracking) return;
    if (ratioNow > best) { best = ratioNow; save(`pp:p:${path}`, ratioNow.toFixed(3)); rememberZone(); }
    if (ratioNow <= 0.02 && active <= 0) return;
    const h1 = document.querySelector('h1')?.textContent?.trim() ?? '';
    const tutorial = labels.tutorial ?? h1;
    const title = h1 && h1 !== tutorial ? `${tutorial} · ${h1}` : tutorial;
    const s = sections[active];
    save('pp:last', JSON.stringify({ path, title, ratio: Number(ratioNow.toFixed(3)), id: s?.id, heading: s?.text }));
  };

  // The section bar names the section being read: "Background · 3/15 · 18 min left".
  const now = mnav?.querySelector<HTMLElement>('.rt-now');
  const pos = mnav?.querySelector<HTMLElement>('.rt-pos');
  const header = document.querySelector<HTMLElement>('header.top');
  const readingLine = () => {
    const h = header && getComputedStyle(header).position === 'sticky' ? header.getBoundingClientRect().bottom : 0;
    const summary = mnav?.querySelector('summary');
    const bar = summary && summary.offsetParent ? summary.getBoundingClientRect().bottom : 0;
    // A heading counts as reached once it is above this line; the margin exceeds the anchor offset, so a TOC jump selects its target.
    return Math.max(h, bar, 0) + 24;
  };
  const setActive = (i: number) => {
    if (i === active) return;
    active = i;
    const s = sections[i];
    sideLinks.forEach((a) => (idOf(a) === s.id ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
    barLinks.forEach((a) => (idOf(a) === s.id ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
    if (now) now.textContent = s.text;
    if (pos) {
      const left = sections.slice(i).reduce((a, x) => a + x.minutes, 0);
      const where = (labels.pos ?? '{i}/{n}').replace('{i}', String(i + 1)).replace('{n}', String(sections.length));
      pos.textContent = left > 0 ? `${where}${labels.sep ?? ' · '}${(labels.left ?? '{m} min left').replace('{m}', String(left))}` : where;
    }
    let changed = false;
    for (const x of sections.slice(0, i)) if (!read.has(x.id)) { read.add(x.id); tick(x.id); changed = true; }
    if (changed) save(readKey, JSON.stringify([...read]));
    remember();
    // Keep the active entry visible inside the (independently scrolling) side rail without moving the page.
    const link = sideLinks.find((a) => idOf(a) === s.id);
    const rail = link?.closest<HTMLElement>('.toc');
    if (link && rail && rail.scrollHeight > rail.clientHeight) {
      const top = link.offsetTop - rail.offsetTop;
      if (top < rail.scrollTop || top + link.offsetHeight > rail.scrollTop + rail.clientHeight) rail.scrollTop = top - rail.clientHeight / 3;
    }
  };
  const spy = () => {
    if (sections.length === 0) return;
    const line = readingLine();
    let i = 0;
    sections.forEach((s, k) => { if (s.el.getBoundingClientRect().top - line <= 0) i = k; });
    setActive(i);
    // The h3 being read inside the active section (side TOC only).
    const sub = sideLinks.find((a) => idOf(a) === sections[i].id)?.parentElement?.querySelectorAll<HTMLAnchorElement>('.toc-sub a');
    let cur: HTMLAnchorElement | undefined;
    sub?.forEach((a) => { const el = document.getElementById(idOf(a)); if (el && el.getBoundingClientRect().top - line <= 0) cur = a; });
    document.querySelectorAll<HTMLAnchorElement>('.toc-sub a[aria-current]').forEach((a) => { if (a !== cur) a.removeAttribute('aria-current'); });
    cur?.setAttribute('aria-current', 'true');
  };

  // Progress bar and back-to-top, updated at most once per frame.
  const bar = document.querySelector<HTMLElement>('.rt-progress span');
  const top = document.querySelector<HTMLButtonElement>('.rt-top');
  let ticking = false;
  // On narrow screens the button would sit on top of the text and captions being read, so it appears only while the
  // reader scrolls back up.
  const narrow = window.matchMedia('(max-width: 899px)');
  let lastY = window.scrollY;
  const update = () => {
    ticking = false;
    const doc = document.documentElement;
    const max = doc.scrollHeight - window.innerHeight;
    ratioNow = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    if (bar) bar.style.transform = `scaleX(${ratioNow})`;
    const dy = window.scrollY - lastY;
    lastY = window.scrollY;
    if (top) {
      const far = window.scrollY >= window.innerHeight * 1.2;
      if (!far) top.hidden = true;
      else if (!narrow.matches) top.hidden = false;
      else if (dy > 2) top.hidden = true;
      else if (dy < -2) top.hidden = false;
    }
    spy();
    if (ratioNow > best) remember();
  };
  window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  window.addEventListener('resize', update);
  update();
  top?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }));

  // Choosing a destination closes the section bar; opening it shows the current section.
  mnav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { mnav.open = false; }));
  mnav?.addEventListener('toggle', () => {
    if (!mnav.open) return;
    const body = mnav.querySelector<HTMLElement>('.rt-mbody');
    const link = barLinks.find((a) => a.getAttribute('aria-current') === 'location');
    if (body && link) body.scrollTop = Math.max(0, link.offsetTop - body.offsetTop - body.clientHeight / 3);
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && mnav?.open) { mnav.open = false; mnav.querySelector('summary')?.focus(); } });

</script>

<style is:global>
  .rt-progress { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 60; pointer-events: none; }
  .rt-progress span { display: block; height: 100%; background: var(--tc, var(--accent)); transform: scaleX(0); transform-origin: 0 50%; }
  .rt-top {
    position: fixed; right: clamp(12px, 2vw, 24px); bottom: clamp(12px, 2vw, 24px); z-index: 50;
    width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink);
    font: 600 18px var(--f-ui); cursor: pointer; box-shadow: 0 2px 10px rgb(0 0 0 / 0.12);
  }
  .rt-top:hover { border-color: var(--accent); color: var(--accent); }
  .rt-top[hidden] { display: none; }
  body:has(.reader-console) .rt-top { display: none; }

  /* Section bar (below 1200 px, where the side table of contents is hidden). It sticks under the header. */
  .rt-mnav { display: none; position: sticky; top: var(--header-h, 0px); z-index: 30; margin: 0 0 22px; border-bottom: 1px solid var(--line); background: var(--bg); font: 14px var(--f-ui); }
  .rt-mnav > summary { cursor: pointer; display: flex; align-items: center; gap: 10px; padding: 8px 12px; min-height: 44px; box-sizing: border-box; list-style: none; }
  .rt-mnav > summary::-webkit-details-marker { display: none; }
  .rt-chev { flex: none; width: 8px; height: 8px; border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted); transform: rotate(-45deg); margin-right: 2px; }
  .rt-mnav[open] .rt-chev { transform: rotate(45deg); }
  .rt-now { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
  .rt-pos { flex: none; font: 12px var(--f-mono); color: var(--muted); font-variant-numeric: tabular-nums; }
  .rt-pos:empty { display: none; }
  .rt-mnav[open] > summary { border-bottom: 1px solid var(--line); }
  .rt-mbody { max-height: 70dvh; overflow-y: auto; overscroll-behavior: contain; }
  .rt-mnav section { padding: 12px 14px 4px; }
  .rt-mnav .rt-title { font: 600 11px var(--f-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 0 0 8px; }
  .rt-mnav ul, .rt-mnav ol { margin: 0 0 8px; padding: 0; list-style: none; display: grid; gap: 2px; }
  .rt-mnav a { min-height: 44px; display: flex; align-items: baseline; gap: 10px; padding: 8px 6px; color: var(--ink); text-decoration: none; border-radius: 6px; }
  .rt-mnav a:hover { background: var(--code-bg); }
  .rt-mnav a[aria-current='page'], .rt-mnav a[aria-current='location'] { font-weight: 600; color: var(--tc, var(--accent)); }
  .rt-mnav a[aria-current='location'] { background: var(--code-bg); }
  .rt-text { flex: 1; min-width: 0; }
  .rt-min { flex: none; font: 12px var(--f-mono); color: var(--muted); font-weight: 400; }
  .rt-done { flex: none; color: var(--t-nlp); font-weight: 600; margin-left: 4px; }
  .rt-mnav .rt-title a { display: inline; padding: 0; color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .rt-mnav .rt-title a:hover { background: none; color: var(--ink); }
  .rt-chapters { display: none; }
  /* The track tree inside the section bar: the tree's own layout, with touch-sized rows. */
  .rt-mnav .ct-tree { display: grid; gap: 1px; }
  .rt-mnav .ct-row > a { display: block; padding: 8px 6px 8px 2px; color: var(--ink); border-radius: 6px; }
  .rt-mnav .ct-node.cur > .ct-row > a { color: var(--tc, var(--accent)); }
  .rt-mnav .ct-toggle, .rt-mnav .ct-spacer { width: 44px; height: 44px; }
  .rt-mnav .ct-children { margin-bottom: 4px !important; }
  .rt-mnav a.rt-treelink { display: inline-block; margin: 4px 0 10px; font-weight: 600; color: var(--tc, var(--accent)); }
  @media (max-width: 1199px) {
    .rt-mnav { display: block; }
    /* Anchor jumps land below the header and the section bar. */
    :root:has(.rt-mnav) { --anchor-offset: calc(var(--header-h, 0px) + 64px); }
  }
  @media (max-width: 899px) { .rt-chapters { display: block; } }

  .toc a[aria-current='location'], .toc .toc-sub a[aria-current='true'] { color: var(--ink); font-weight: 600; }
  .toc .toc-sub a[aria-current='true'] { font-weight: 500; }
  .toc li:has(> a[aria-current='location']) { margin-left: -11px; padding-left: 10px; border-left: 2px solid var(--tc, var(--accent)); }

  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  @media print { .rt-progress, .rt-top, .rt-mnav { display: none !important; } }
</style>
