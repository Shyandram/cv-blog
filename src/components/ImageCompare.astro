---
/**
 * Drag a slider between two images.
 *   <ImageCompare before={inUrl} after={outUrl} beforeLabel="Input" afterLabel="Canny" />
 * With no images it shows the built-in test image vs. a 5×5 Gaussian blur.
 * `sweep` (used on the home page): the divider sweeps back and forth by itself, with a round knob, until the reader
 * touches, drags or focuses the slider. It stays still when the reader prefers reduced motion, and pauses off screen.
 */
import type { ImageMetadata } from 'astro';
interface Props {
  before?: ImageMetadata | string;
  after?: ImageMetadata | string;
  beforeLabel?: string;
  afterLabel?: string;
  alt?: string;
  sweep?: boolean;
}
const { before, after, beforeLabel = 'Input', afterLabel = 'Output', alt = '', sweep = false } = Astro.props;
const src = (x: ImageMetadata | string | undefined) => (typeof x === 'string' ? x : x?.src);
const synthetic = !before || !after;
---
<image-compare class="demo" data-synthetic={synthetic ? '' : undefined} data-sweep={sweep ? '' : undefined}>
  <div class="cmp">
    {synthetic ? (
      <>
        <canvas class="layer before" width="200" height="200" aria-label={alt}></canvas>
        <canvas class="layer after" width="200" height="200" aria-hidden="true"></canvas>
      </>
    ) : (
      <>
        <img class="layer before" src={src(before)} alt={alt} loading="lazy" decoding="async" />
        <img class="layer after" src={src(after)} alt="" loading="lazy" decoding="async" />
      </>
    )}
    <div class="handle">{sweep && <span class="knob" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6"></path></svg></span>}</div>
    <span class="lbl" style="left:8px">{beforeLabel}</span>
    <span class="lbl" style="right:8px">{afterLabel}</span>
  </div>
  <input class="range" type="range" min="0" max="100" value="50" aria-label={`${beforeLabel} / ${afterLabel}`} />
</image-compare>

<script>
  import { testImage, convolve, gaussianKernel, drawGray } from '../lib/cv';

  class ImageCompare extends HTMLElement {
    connectedCallback() {
      const box = this.querySelector<HTMLElement>('.cmp')!;
      const after = this.querySelector<HTMLElement>('.after')!;
      const handle = this.querySelector<HTMLElement>('.handle')!;
      const range = this.querySelector<HTMLInputElement>('.range')!;
      if (this.hasAttribute('data-synthetic')) {
        const n = 200, img = testImage(n);
        drawGray(this.querySelector<HTMLCanvasElement>('canvas.before')!, img, n);
        drawGray(after as HTMLCanvasElement, convolve(img, n, gaussianKernel(5, 1.4), 5), n);
      }
      // The handle is a full-size overlay whose left edge draws the divider, so it moves with `translate` (no layout work).
      const setPos = (pct: number) => {
        pct = Math.max(0, Math.min(100, pct));
        after.style.clipPath = `inset(0 0 0 ${pct}%)`;
        handle.style.translate = `${pct}% 0`;
        range.value = String(Math.round(pct));
      };
      let stopSweep = () => {};
      range.addEventListener('input', () => { stopSweep(); setPos(+range.value); });
      let dragging = false;
      const fromEvt = (e: PointerEvent) => { const r = box.getBoundingClientRect(); setPos(((e.clientX - r.left) / r.width) * 100); };
      box.addEventListener('pointerdown', (e) => { stopSweep(); dragging = true; box.setPointerCapture(e.pointerId); fromEvt(e); });
      box.addEventListener('pointermove', (e) => dragging && fromEvt(e));
      box.addEventListener('pointerup', () => (dragging = false));
      setPos(50);

      let reduce = false;
      try { reduce = matchMedia('(prefers-reduced-motion: reduce)').matches; } catch {}
      if (this.hasAttribute('data-sweep') && !reduce && 'IntersectionObserver' in window) {
        // 50 % → 72 % → 28 % → 50 %, one cycle every 7 s, only while the box is on screen.
        let raf = 0, t0 = 0, elapsed = 0;
        const tick = (now: number) => {
          if (!t0) t0 = now - elapsed;
          elapsed = now - t0;
          setPos(50 + 22 * Math.sin((2 * Math.PI * elapsed) / 7000));
          raf = requestAnimationFrame(tick);
        };
        const pause = () => { cancelAnimationFrame(raf); raf = 0; t0 = 0; };
        const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { if (!raf) raf = requestAnimationFrame(tick); } else pause(); });
        io.observe(box);
        stopSweep = () => { pause(); io.disconnect(); stopSweep = () => {}; };
        range.addEventListener('focus', () => stopSweep());
        box.addEventListener('touchstart', () => stopSweep(), { passive: true });
      }
    }
  }
  if (!customElements.get('image-compare')) customElements.define('image-compare', ImageCompare);
</script>

<style>
  .cmp { position: relative; aspect-ratio: 1 / 1; width: 420px; max-width: 100%; margin: 0 auto; border-radius: 8px; overflow: hidden; touch-action: none; cursor: ew-resize; }
  .layer { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated; margin: 0; border-radius: 0; }
  .handle { position: absolute; inset: 0; translate: 50% 0; pointer-events: none; }
  .handle::before { content: ''; position: absolute; top: 0; bottom: 0; left: -1px; width: 2px; background: var(--surface); box-shadow: 0 0 0 1px var(--ink); }
  .knob { position: absolute; left: 0; top: 50%; translate: -50% -50%; width: 44px; height: 44px; border-radius: 999px; background: #ffffff; color: #15191e; box-shadow: 0 4px 12px rgb(0 0 0 / 0.25); display: flex; align-items: center; justify-content: center; }
  .lbl { position: absolute; top: 8px; font: 600 11px var(--f-mono); padding: 2px 6px; border-radius: 4px; background: color-mix(in srgb, var(--ink) 72%, transparent); color: var(--bg); text-transform: uppercase; }
  .range { display: block; width: 100%; max-width: 420px; height: 28px; margin: 6px auto 0; accent-color: var(--accent); }
</style>
