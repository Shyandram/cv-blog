---
// The chapter map at the top of a tutorial (AGENTS.md §3 "Showing structure and layers"): the h2 outline as an indented
// tree, one line of summary per section (quoted from the section by sectionSummaries in src/lib/site.ts), its reading
// time, and its h3s on demand. The house-style frame (what you'll learn, the big picture / modern view, takeaways,
// exercises) is grouped into a "Start" and a "Wrap up" row so the topic sections stand out.
//
// It is the same outline as the side "On this page" list and the section bar, not a fourth navigation: the side list
// (≥ 1200 px) stays hidden while the map is on screen and appears once the map scrolls away, so only one list is ever
// visible; below 1200 px the sticky section bar sits directly under the map as its "you are here" line.
// The layer switch opens or closes every Layer-2 block (<Deeper>) at once; it needs JavaScript and is hidden without it.
import type { Lang } from '../i18n/ui';

interface Section { slug: string; text: string; minutes: number; summary: string; subs: { slug: string; text: string }[] }
interface Props { lang: Lang; sections: Section[]; minutes: number; deeper: number }
const { lang, sections, minutes, deeper } = Astro.props;
const zh = lang === 'zh-tw';
const START = /^(what you.ll learn|你將學到|the big picture|先看全貌)$/i;
const END = /^(modern view|現代觀點|key takeaways|重點整理|exercises|練習)$/i;
const start = sections.filter((s) => START.test(s.text.trim()));
const end = sections.filter((s) => END.test(s.text.trim()));
const core = sections.filter((s) => !start.includes(s) && !end.includes(s));
const L = {
  title: zh ? '本章地圖' : 'Chapter map',
  stats: zh ? `${core.length} 個主題・約 ${minutes} 分鐘` : `${core.length} topics · ${minutes} min`,
  start: zh ? '開始' : 'Start',
  end: zh ? '收尾' : 'Wrap up',
  min: zh ? '分鐘' : 'min',
  subs: (s: Section) => (zh ? `${s.text}：${s.subs.length} 個小節` : `${s.text}: ${s.subs.length} subsections`),
  layer: zh ? '精確版' : 'Precise versions',
  show: zh ? `全部展開（${deeper}）` : `Show all (${deeper})`,
  hide: zh ? `全部收合（${deeper}）` : `Hide all (${deeper})`,
};
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
{sections.length > 0 && (
  <nav class="smap" aria-labelledby="smap-title" data-pagefind-ignore>
    <details class="smap-fold">
    <summary class="smap-head">
      <span class="smap-title" id="smap-title">{L.title}</span>
      <span class="smap-stats">{L.stats}</span>
    </summary>
    <div class="smap-body">
      {deeper > 0 && (
        <span class="smap-layer" hidden>
          <span class="smap-layer-label" id="smap-layer-label">{L.layer}</span>
          <button type="button" class="smap-layer-btn" aria-pressed="false" aria-describedby="smap-layer-label" data-show={L.show} data-hide={L.hide}>{L.show}</button>
        </span>
      )}
    {start.length > 0 && (
      <p class="smap-frame"><span class="smap-frame-label">{L.start}</span>{start.map((s, i) => <>{i > 0 && <span class="smap-dot" aria-hidden="true">·</span>}<a href={`#${s.slug}`}>{s.text}</a></>)}</p>
    )}
    <ol class="smap-list">
      {core.map((s, i) => (
        <li>
          <div class="smap-row">
            <span class="smap-n" aria-hidden="true">{pad(i)}</span>
            <a href={`#${s.slug}`}>{s.text}</a>
            {s.minutes > 0 && <span class="smap-min">{s.minutes} {L.min}</span>}
            {s.subs.length > 0
              ? <button type="button" class="ct-toggle smap-more" aria-expanded="false" aria-controls={`smap-${s.slug}`}><span class="sr-only">{L.subs(s)}</span></button>
              : <span class="smap-spacer" aria-hidden="true"></span>}
          </div>
          {s.summary && <p class="smap-sum">{s.summary}</p>}
          {s.subs.length > 0 && <ul class="smap-sub" id={`smap-${s.slug}`} hidden>{s.subs.map((x) => <li><a href={`#${x.slug}`}>{x.text}</a></li>)}</ul>}
        </li>
      ))}
    </ol>
    {end.length > 0 && (
      <p class="smap-frame"><span class="smap-frame-label">{L.end}</span>{end.map((s, i) => <>{i > 0 && <span class="smap-dot" aria-hidden="true">·</span>}<a href={`#${s.slug}`}>{s.text}</a></>)}</p>
    )}
    </div>
    </details>
  </nav>
)}

<script>
  // The map is open on wider screens (CSS shows its body whatever the state, where ::details-content is supported);
  // on phones it starts as one folded row. Here the state follows the layout so assistive technology hears the truth.
  const fold = document.querySelector<HTMLDetailsElement>('.smap-fold');
  const wide = matchMedia('(min-width: 621px)');
  const syncFold = () => {
    if (!fold || !CSS.supports('selector(::details-content)')) return;
    const summary = fold.querySelector('summary');
    if (wide.matches) { fold.open = true; summary?.setAttribute('tabindex', '-1'); }
    else summary?.removeAttribute('tabindex');
  };
  syncFold();
  wide.addEventListener('change', syncFold);
  // One outline on screen at a time: the side "On this page" list waits until the map has scrolled away.
  const map = document.querySelector<HTMLElement>('.smap');
  if (map && 'IntersectionObserver' in window) {
    const root = document.documentElement;
    new IntersectionObserver(([e]) => { root.dataset.smap = e.isIntersecting ? 'in' : 'out'; }).observe(map);
  }
  // Layer switch: open or close every <Deeper> block. Opening one by hand leaves the button in a mixed state.
  const wrap = map?.querySelector<HTMLElement>('.smap-layer');
  const btn = wrap?.querySelector<HTMLButtonElement>('.smap-layer-btn');
  const blocks = [...document.querySelectorAll<HTMLDetailsElement>('.prose details.deeper')];
  if (wrap && btn && blocks.length) {
    wrap.hidden = false;
    const sync = () => {
      const open = blocks.filter((d) => d.open).length;
      btn.setAttribute('aria-pressed', open === 0 ? 'false' : open === blocks.length ? 'true' : 'mixed');
      btn.textContent = (open === blocks.length ? btn.dataset.hide : btn.dataset.show) ?? '';
    };
    btn.addEventListener('click', () => {
      const open = blocks.some((d) => !d.open);
      blocks.forEach((d) => {
        if (open) for (let p = d.parentElement; p; p = p.parentElement) if (p instanceof HTMLDetailsElement) p.open = true;
        d.open = open;
      });
      sync();
    });
    blocks.forEach((d) => d.addEventListener('toggle', sync));
    sync();
  }
</script>

<style is:global>
  /* The map uses the UI face and the reading measure; rows keep 44 px targets. */
  .smap { container-type: inline-size; max-width: none; margin: 4px 0 26px; font: 15px/1.45 var(--f-ui); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 12px 0 10px; }
  .smap a { color: var(--ink); text-decoration: none; }
  .smap a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .smap-head { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; min-height: 44px; list-style: none; cursor: pointer; }
  .smap-head::-webkit-details-marker { display: none; }
  .smap-head::before { content: ''; flex: none; width: 7px; height: 7px; border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted); transform: rotate(-45deg); margin: 0 2px; }
  .smap-fold[open] > .smap-head::before { transform: rotate(45deg); }
  .smap-head:hover .smap-title { color: var(--ink); }
  /* Wider screens: the map is always open (no click needed); phones keep the one-row fold (content-priority). */
  @media (min-width: 621px) {
    @supports selector(::details-content) {
      .smap-fold::details-content { content-visibility: visible; display: block; }
      .smap-head { cursor: default; pointer-events: none; }
      .smap-head::before { display: none; }
    }
  }
  .smap-body { display: flow-root; }
  .smap-title { margin: 0; font: 600 12px var(--f-ui); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  :lang(zh) .smap-title { letter-spacing: 0.04em; font-size: 13px; }
  .smap-stats { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .smap-layer { float: right; margin: -44px 0 0; display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }
  .smap-layer[hidden] { display: none; }
  .smap-layer-btn { min-height: 44px; padding: 6px 12px; border: 1px solid var(--line-strong); border-radius: var(--radius-control); background: transparent; color: var(--ink); font: 500 13px var(--f-ui); cursor: pointer; }
  .smap-layer-btn:hover { border-color: var(--accent); color: var(--accent); }
  .smap-layer-btn[aria-pressed='true'] { background: var(--code-bg); }
  /* The frame rows: a small label, then the sections inline. */
  .smap-frame { display: flex; flex-wrap: wrap; align-items: center; gap: 0 8px; margin: 0; min-height: 44px; color: var(--muted); }
  .smap-frame a { display: inline-flex; align-items: center; min-height: 44px; color: var(--muted); }
  .smap-frame-label { min-width: 4.6em; font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; }
  :lang(zh) .smap-frame-label { text-transform: none; letter-spacing: 0.04em; font-size: 13px; }
  .smap-dot { color: var(--line-strong); }
  /* The topic sections: number, title, minutes, h3 toggle; the one-line summary sits under the title, indented. */
  .smap-list { list-style: none; margin: 2px 0; padding: 0; }
  .smap-list > li { padding: 2px 0 6px 12px; border-left: 1.5px solid var(--line); break-inside: avoid; }
  /* A wide column shows the topics in two newspaper columns (01-05, 06-10), so the map stays short. */
  @container (min-width: 760px) { .smap-list { columns: 2; column-gap: 28px; } }
  /* Number and minutes sit on the title's first line, also when a long title wraps. */
  .smap-row { display: grid; grid-template-columns: 2.1em minmax(0, 1fr) auto 44px; align-items: start; gap: 0 8px; min-height: 44px; }
  .smap-n, .smap-min { padding-top: 11px; line-height: 1.45; }
  .smap-n { font: 12px var(--f-mono); color: var(--muted); font-variant-numeric: tabular-nums; }
  .smap-row > a { font-weight: 600; padding-block: 8px; overflow-wrap: anywhere; }
  .smap-min { font: 12px var(--f-mono); color: var(--muted); white-space: nowrap; }
  .smap-more { margin: 0; }
  .smap-spacer { width: 44px; }
  .smap-sum { margin: -6px 0 0 calc(2.1em + 8px); padding-right: 52px; font-size: 14px; line-height: 1.5; color: var(--muted); }
  .smap-sub { list-style: none; margin: 6px 0 4px calc(2.1em + 8px); padding: 0 0 0 12px; border-left: 1px dashed var(--line-strong); font-size: 14px; }
  .smap-sub[hidden] { display: none; }
  .smap-sub a { display: flex; align-items: center; min-height: 40px; color: var(--muted); }
  @media (pointer: fine) { .smap-row { min-height: 36px; } .smap-row > .smap-more { height: 36px; } .smap-row > a { padding-block: 8px 4px; } .smap-frame, .smap-frame a { min-height: 36px; } .smap-sub a { min-height: 32px; } }
  /* Phones: the summary is part of the on-demand layer (the row toggle), so the outline itself stays short. */
  @media (max-width: 620px) {
    .smap-row { grid-template-columns: 1.8em minmax(0, 1fr) auto 44px; gap: 0 6px; }
    .smap-sum { display: none; }
    li:has(> .smap-row > .smap-more[aria-expanded='true']) > .smap-sum { display: block; margin: 0 0 0 calc(1.8em + 6px); padding-right: 0; }
    .smap-sub { margin-left: calc(1.8em + 6px); }
    .smap-layer { float: none; margin: 0 0 4px; width: 100%; justify-content: space-between; }
  }
  /* The side list waits until the map has scrolled away (it keeps its column, so nothing moves). */
  @media (min-width: 1200px) {
    :root[data-smap='in'] .toc { opacity: 0; visibility: hidden; }
    @media (prefers-reduced-motion: no-preference) { .toc { transition: opacity 160ms ease, visibility 160ms; } }
  }
  @media print { .smap { display: none !important; } }
</style>
