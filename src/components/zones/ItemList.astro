---
// Index page of an optional section (…/notes/, …/papers/): the items as a list of cards. The cards repeat only each item's
// first sentence, so they stay out of the search index (the item pages are indexed).
---
<ol class="item-cards" data-pagefind-ignore><slot /></ol>
<style>
  .item-cards { list-style: none; margin: 1.4em 0 2em; padding: 0; display: grid; gap: 12px; max-width: var(--measure); font-family: var(--f-ui); }
</style>
