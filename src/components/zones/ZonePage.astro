---
// An optional section on its own pages (index …/notes/ and items …/notes/<id>/; the same for papers): renders its content and
// forwards a link to an id that now lives on an item's page (old links …/notes/#id, or a stale …/notes/<a>/#id).
interface Props { kind?: 'notes' | 'papers'; items?: string; heading?: string; headingId?: string; ids?: string }
const { kind = 'notes', ids = '{}' } = Astro.props;
---
<div hidden class="zone-ids" data-zone-kind={kind} data-zone-ids={ids}></div>
<slot />
<script>
  const forwardLegacyHash = () => {

  const id = decodeURIComponent(location.hash.slice(1));
  const box = document.querySelector<HTMLElement>('.zone-ids');
  if (id && box && !document.getElementById(id)) {
    let map: Record<string, string> = {};
    try { map = JSON.parse(box.dataset.zoneIds ?? '{}'); } catch { map = {}; }
    const item = map[id];
    const kind = box.dataset.zoneKind ?? 'notes';
    const at = location.pathname.lastIndexOf(`/${kind}/`);
    if (item && at >= 0) location.replace(`${location.pathname.slice(0, at)}/${kind}/${item}/${location.hash}`);
  }

  };
  forwardLegacyHash();
  window.addEventListener("hashchange", forwardLegacyHash);
</script>
