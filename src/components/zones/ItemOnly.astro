---
// Item pages (…/notes/<id>/, …/papers/<id>/): renders an item of an optional section only on that item's own page.
interface Props { kind?: 'notes' | 'papers'; id?: string; title?: string; n?: string }
const { kind = 'notes', id = '' } = Astro.props;
const show = String(Astro.params.slug ?? '').endsWith(`/${kind}/${id}`);
---
{show && <slot />}
