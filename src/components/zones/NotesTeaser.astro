---
// Stands in, on the main tutorial page, for a section that lives on its own page: the Supplementary notes (kind="notes",
// concept and sub-field details, …/notes/) or the Paper guides (kind="papers", reading guides to single papers, …/papers/).
// A short card lists the items and links to them. Old links to an item's anchor on the main page are forwarded there.
interface Props { kind?: 'notes' | 'papers'; items?: string; heading?: string; headingId?: string }
const { kind = 'notes', items = '[]', heading = '', headingId = '' } = Astro.props;
const list = JSON.parse(items) as { id: string; text: string }[];
const zh = Astro.params.lang === 'zh-tw';
const base = `${kind}/`;
const n = list.length;
const lead = kind === 'papers'
  ? (zh ? `這一章有 ${n} 篇論文導讀，放在另一頁：帶你讀懂本章依據的論文——它要解決的問題、核心想法、結果，以及閱讀時該注意什麼。`
        : `This chapter has ${n} paper ${n === 1 ? 'guide' : 'guides'} on a separate page: reading guides to papers it builds on — the problem, the idea, what was shown and what to check when you read it.`)
  : (zh ? `這一章有 ${n} 則補充資料，放在另一頁：概念與子領域的細節。主線不依賴它們，想深入時再看。`
        : `This chapter has ${n} supplementary ${n === 1 ? 'note' : 'notes'} on a separate page: details of concepts and sub-fields. Nothing in the main text depends on them; read them when you want to go deeper.`);
const open = kind === 'papers' ? (zh ? '打開論文導讀頁 →' : 'Open the paper guides →') : (zh ? '打開補充資料頁 →' : 'Open the supplementary notes →');
---
<section class:list={['notes-teaser', kind]} aria-labelledby={headingId || undefined} data-zone-base={base} data-note-ids={list.map((x) => x.id).join(' ')} data-pagefind-ignore>
  <h2 id={headingId || undefined}>{heading}</h2>
  <p>{lead}</p>
  <ul>{list.map((x) => <li><a href={`${base}#${x.id}`}>{x.text}</a></li>)}</ul>
  <a class="open" href={base}>{open}</a>
</section>
<script>
  // Forward old in-page links (…/#some-note) to the page that now holds that item.
  const id = decodeURIComponent(location.hash.slice(1));
  if (id) for (const card of document.querySelectorAll<HTMLElement>('.notes-teaser')) {
    if ((card.dataset.noteIds ?? '').split(' ').includes(id)) { location.replace(`${card.dataset.zoneBase}${location.hash}`); break; }
  }
</script>
<style>
  .notes-teaser { margin: 2.2em 0; padding: 18px 20px; border: 1px solid var(--line); border-left: 4px solid var(--tc, var(--accent)); border-radius: 10px; background: var(--surface); max-width: var(--measure); font-family: var(--f-ui); }
  .notes-teaser.papers { border-left-style: double; border-left-width: 6px; }
  .notes-teaser h2 { margin: 0 0 6px; font-size: 20px; }
  .notes-teaser p { margin: 0 0 10px; color: var(--muted); font-size: 15px; }
  .notes-teaser ul { margin: 0 0 12px; padding-left: 1.2em; display: grid; gap: 4px; font-size: 15px; }
  .open { font-weight: 600; }
</style>
