---
// Stands in for the Supplementary notes on the main tutorial page: a short card listing the notes, each linking to the
// separate notes page. Old links to a note's anchor on the main page are forwarded there by the script below.
interface Props { items?: string; heading?: string; headingId?: string }
const { items = '[]', heading = 'Supplementary notes', headingId = 'supplementary-notes' } = Astro.props;
const list = JSON.parse(items) as { id: string; text: string }[];
const zh = Astro.params.lang === 'zh-tw';
---
<section class="notes-teaser" aria-labelledby={headingId} data-note-ids={list.map((x) => x.id).join(' ')} data-pagefind-ignore>
  <h2 id={headingId}>{heading}</h2>
  <p>{zh
    ? `這一章有 ${list.length} 則選讀補充資料，放在另一頁：主線不依賴它們，想深入時再看。`
    : `This chapter has ${list.length} optional supplementary ${list.length === 1 ? 'note' : 'notes'} on a separate page. Nothing in the main text depends on them; read them when you want to go deeper.`}</p>
  <ul>{list.map((x) => <li><a href={`notes/#${x.id}`}>{x.text}</a></li>)}</ul>
  <a class="open" href="notes/">{zh ? '打開補充資料頁 →' : 'Open the supplementary notes →'}</a>
</section>
<script>
  // Forward old in-page links (…/#some-note) to the notes page.
  const teaser = document.querySelector<HTMLElement>('.notes-teaser');
  const ids = new Set((teaser?.dataset.noteIds ?? '').split(' ').filter(Boolean));
  const id = decodeURIComponent(location.hash.slice(1));
  if (id && ids.has(id)) location.replace(`notes/${location.hash}`);
</script>
<style>
  .notes-teaser { margin: 2.2em 0; padding: 18px 20px; border: 1px solid var(--line); border-left: 4px solid var(--tc, var(--accent)); border-radius: 10px; background: var(--surface); max-width: var(--measure); font-family: var(--f-ui); }
  .notes-teaser h2 { margin: 0 0 6px; font-size: 20px; }
  .notes-teaser p { margin: 0 0 10px; color: var(--muted); font-size: 15px; }
  .notes-teaser ul { margin: 0 0 12px; padding-left: 1.2em; display: grid; gap: 4px; font-size: 15px; }
  .open { font-weight: 600; }
</style>
