---
// Stands in, on the main tutorial page, for a section whose items live on pages of their own: the Supplementary notes
// (kind="notes", concept and sub-field details, index …/notes/, one page per item at …/notes/<id>/) or the Paper guides
// (kind="papers", reading guides to single papers, …/papers/ and …/papers/<id>/). A short card lists the items and links to
// them. Old links to an id of an item on the main page (…/#some-note, or any id inside it) are forwarded to that item's page.
interface Props { kind?: 'notes' | 'papers'; items?: string; heading?: string; headingId?: string; ids?: string }
const { kind = 'notes', items = '[]', heading = '', headingId = '', ids = '{}' } = Astro.props;
const list = JSON.parse(items) as { id: string; text: string }[];
const zh = Astro.params.lang === 'zh-tw';
const base = `${kind}/`;
const n = list.length;
// One line: the tab bar under the title and the left rail already list the items, so the card only says where they are.
const lead = kind === 'papers'
  ? (zh ? `${n} 篇論文導讀，各自成頁。` : `${n} paper ${n === 1 ? 'guide' : 'guides'}, each on a page of its own.`)
  : (zh ? `${n} 則補充資料，各自成頁；主線不依賴它們。` : `${n} supplementary ${n === 1 ? 'note' : 'notes'}, each on a page of its own; the main text does not depend on them.`);
const open = kind === 'papers' ? (zh ? '打開論文導讀 →' : 'Open the paper guides →') : (zh ? '打開補充資料 →' : 'Open the notes →');
---
<section class:list={['notes-teaser', kind]} aria-labelledby={headingId || undefined} data-zone-base={base} data-zone-ids={ids} data-items={list.length} data-pagefind-ignore>
  <h2 id={headingId || undefined}>{heading}</h2>
  <p>{lead}</p>
  <a class="open" href={base}>{open}</a>
</section>
<script>
  const forwardLegacyHash = () => {

  // Forward old in-page links (…/#some-note, or an id inside a note) to the page that now holds that item.
  const id = decodeURIComponent(location.hash.slice(1));
  if (id && !document.getElementById(id)) for (const card of document.querySelectorAll<HTMLElement>('.notes-teaser')) {
    let map: Record<string, string> = {};
    try { map = JSON.parse(card.dataset.zoneIds ?? '{}'); } catch { map = {}; }
    if (map[id]) { location.replace(`${card.dataset.zoneBase}${map[id]}/${location.hash}`); break; }
  }

  };
  forwardLegacyHash();
  window.addEventListener("hashchange", forwardLegacyHash);
</script>
<style>
  .notes-teaser { margin: 2em 0; padding: 8px 16px; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; border: 1px solid var(--line); border-left: 4px solid var(--tc, var(--accent)); border-radius: 10px; background: var(--surface); max-width: var(--measure); font-family: var(--f-ui); }
  .notes-teaser.papers { border-left-style: double; border-left-width: 6px; }
  .notes-teaser + .notes-teaser { margin-top: -1.2em; }
  .notes-teaser h2 { margin: 0; font-size: 16px; }
  .notes-teaser p { margin: 0; flex: 1 1 14em; color: var(--muted); font-size: 14px; }
  .open { font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; min-height: 44px; }
</style>
