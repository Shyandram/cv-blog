---
// One card on the index page of an optional section: the item's number and title (a link to its page) and its first sentence.
interface Props { kind?: 'notes' | 'papers'; id?: string; title?: string; n?: string }
const { id = '', title = '', n = '' } = Astro.props;
---
<li class="item-card">
  <a href={`${id}/`}><span class="num" aria-hidden="true">{n.padStart(2, '0')}</span><span class="t">{title}</span><span class="go" aria-hidden="true">→</span></a>
  <div class="lead"><slot /></div>
</li>
<style>
  .item-card { border: 1px solid var(--line); border-left: 3px solid var(--tc, var(--accent)); border-radius: 10px; background: var(--surface); padding: 12px 16px 2px; }
  .item-card:hover, .item-card:focus-within { border-color: var(--tc, var(--accent)); }
  .item-card > a { display: flex; align-items: baseline; gap: 10px; font-weight: 600; font-size: 17px; line-height: 1.35; color: var(--ink); text-decoration: none; padding-block: 2px; }
  .item-card > a:hover .t, .item-card > a:focus-visible .t { text-decoration: underline; }
  .num { flex: none; font: 600 12px var(--f-mono); color: var(--tc, var(--accent)); }
  .t { flex: 1; min-width: 0; overflow-wrap: anywhere; }
  .go { flex: none; color: var(--muted); }
  .lead :global(p) { margin: 6px 0 10px; color: var(--muted); font-size: 15px; line-height: 1.5; max-width: none; }
</style>
