---
import { TRACKS } from '../lib/taxonomy';
import { type Lang, useT } from '../i18n/ui';
import { url, formatDuration, nestTutorials } from '../lib/site';
import type { Place } from '../lib/curriculum';
// Each track shows only its first main chapters (the tree's top level), each with the number of sub-chapters under it.
interface Props { lang: Lang; items: { slug: string; place: Place; href: string; minutes: number; entry: { data: { track: string; title: string } } }[] }
const { lang, items } = Astro.props;
const t = useT(lang);
const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (m, k: string) => (k in v ? String(v[k]) : m));
const zh = lang === 'zh-tw';
const total = (n: { children: { children: unknown[] }[] }): number => n.children.reduce((a, c) => a + 1 + total(c as never), 0);
---
<div class="tracks">
  {TRACKS.map((track, i) => {
    const list = items.filter((x) => x.entry.data.track === track);
    const total = list.reduce((a, x) => a + x.minutes, 0);
    return (
      <a class="track" href={url(`/${lang}/learn/#${track}`)} style={`--tc: var(--t-${track})`} data-paths={list.map((x) => x.href).join(' ')}>
        <span class="num">{t('track.label').toUpperCase()} {i}</span>
        <h3>{t(`track.${track}`)}</h3>
        <ul>
          {nestTutorials(list).slice(0, 3).map((n) => { const k = total(n); return <li>{n.item.entry.data.title}{k > 0 && <span class="subs" title={zh ? `${k} 個子章節` : `${k} sub-chapters`}> +{k}<span class="sr-only">{zh ? ' 個子章節' : ' sub-chapters'}</span></span>}</li>; })}
          {list.length === 0 && <li>{t('track.empty')}</li>}
        </ul>
        <span class="meta">{list.length > 0 ? `${list.length === 1 ? t('learn.tutorial1') : fill(t('learn.tutorials'), { n: list.length })} · ${formatDuration(total, lang)}` : ''}</span>
        <span class="tprog" hidden></span>
      </a>
    );
  })}
</div>
<style>
  .tracks { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--surface); }
  .track { padding: 18px 16px 20px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; min-width: 0; color: inherit; text-decoration: none; box-shadow: inset 0 3px 0 var(--tc); }
  .track { border-bottom: 1px solid var(--line); }
  .track:nth-child(4n) { border-right: 0; }
  .track:nth-last-child(-n+4) { border-bottom: 0; }
  .track:hover h3 { color: var(--tc); }
  .num { font: 12px var(--f-mono); color: var(--tc); }
  h3 { font-size: 17px; }
  ul { margin: 0; padding: 0; list-style: none; font-size: 13px; color: var(--muted); display: grid; gap: 3px; }
  .subs { font: 600 11px var(--f-mono); color: var(--tc); white-space: nowrap; }
  .meta { margin-top: auto; font: 12px var(--f-ui); color: var(--muted); font-variant-numeric: tabular-nums; }
  .tprog { font: 12px var(--f-ui); color: var(--ink); }
  .tprog :global(.pbar) { margin-top: 5px; }
  @media (max-width: 1000px) { .tracks { grid-template-columns: repeat(2, minmax(0, 1fr)); } .track:nth-child(n) { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); } .track:nth-child(2n) { border-right: 0; } .track:nth-last-child(-n+2) { border-bottom: 0; } }
  @media (max-width: 620px) { .tracks { grid-template-columns: minmax(0, 1fr); } .track:nth-child(n) { border-right: 0; border-bottom: 1px solid var(--line); } .track:last-child { border-bottom: 0; } }
</style>
