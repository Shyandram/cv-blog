---
import { type Lang } from '../i18n/ui';
import { url } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<pagefind-config bundle-path={url('/pagefind/')} lang={lang} no-worker></pagefind-config>
<pagefind-modal data-pagefind-ignore>
  <pagefind-modal-header>
    <pagefind-input placeholder={lang === 'zh-tw' ? '搜尋教學與文章…' : 'Search tutorials and articles…'}></pagefind-input>
  </pagefind-modal-header>
  <pagefind-modal-body>
    <pagefind-summary default-message={lang === 'zh-tw' ? '輸入關鍵字，尋找教學與文章。' : 'Type a keyword to find tutorials and articles.'}></pagefind-summary>
    <pagefind-results show-images="false" max-sub-results="2"></pagefind-results>
  </pagefind-modal-body>
  <pagefind-modal-footer>
    <div class="palette-hints" aria-hidden="true">
      <span><kbd>↑ ↓</kbd> {lang === 'zh-tw' ? '選擇' : 'Navigate'}</span>
      <span><kbd>↵</kbd> {lang === 'zh-tw' ? '開啟' : 'Open'}</span>
      <span><kbd>Esc</kbd> {lang === 'zh-tw' ? '關閉' : 'Close'}</span>
    </div>
    <a class="search-page-link" href={url(`/${lang}/search/`)}>{lang === 'zh-tw' ? '完整搜尋頁面' : 'Full search page'} →</a>
  </pagefind-modal-footer>
</pagefind-modal>

<style is:global>
  pagefind-config, pagefind-modal:not(:defined) { display: none; }
  pagefind-modal, pagefind-modal-trigger {
    --pf-text: var(--ink);
    --pf-text-secondary: var(--muted);
    --pf-text-muted: var(--muted);
    --pf-background: var(--surface);
    --pf-border: var(--line);
    --pf-border-focus: var(--accent);
    --pf-outline-focus: var(--accent);
    --pf-hover: var(--code-bg);
    --pf-skeleton: var(--code-bg);
    --pf-skeleton-shine: var(--surface);
    --pf-mark: var(--accent);
    --pf-font: var(--f-ui);
    --pf-border-radius: 8px;
    --pf-input-font-size: 16px;
    --pf-result-title-font-size: 16px;
    --pf-result-excerpt-font-size: 14px;
    --pf-modal-backdrop: rgb(10 18 32 / 55%);
  }
  /* The trigger is a control: its boundary needs 3:1 (WCAG 1.4.11). Separators inside the modal keep --line. */
  pagefind-modal-trigger { --pf-border: var(--line-strong); }
  pagefind-modal .search-page-link { font: 12px var(--f-ui); white-space: nowrap; }
  .palette-hints { display: flex; flex-wrap: wrap; gap: 6px 12px; font: 12px var(--f-ui); }
  .palette-hints span { white-space: nowrap; }
  .palette-hints kbd { padding: 1px 4px; border: 1px solid var(--line); border-radius: 4px; background: var(--code-bg); font: 11px var(--f-ui); }
  body:has(.pf-modal[open]) { overflow: hidden; }
  @media (max-width: 620px) {
    pagefind-modal-trigger .pf-trigger-text,
    pagefind-modal-trigger .pf-trigger-shortcut { display: none !important; }
  }
</style>
