---
// A leveled outline (AGENTS.md §3 "Showing structure"): wrap an ordinary Markdown list, nested at most three levels.
// Level 1 = key point, level 2 = supporting detail, level 3 = minor detail; global.css (.outline) draws the levels.
// An item may start with a priority marker, which becomes a tag (a word plus a fill style, never colour alone):
//   [core]   Core      / 核心   — what a reader must take away
//   [key]    Important / 重要   — needed to apply the core point well
//   [detail] Detail    / 細節   — good to know; safe to skip on a first read
//
//   <Outline title="Rules of thumb">
//
//   - [core] **Precision** — when the model says positive, how often is it right?
//     - Costly false alarms: a spam filter that hides real mail.
//   - [detail] Specificity is recall for the negative class.
//
//   </Outline>
import { type Lang } from '../i18n/ui';

interface Props { title?: string }
const { title } = Astro.props;
const lang: Lang = /^\/(?:[^/]+\/)*zh-tw\//.test(Astro.url.pathname) ? 'zh-tw' : 'en';
const zh = lang === 'zh-tw';
const LABEL = {
  core: zh ? '核心' : 'Core',
  key: zh ? '重要' : 'Important',
  detail: zh ? '細節' : 'Detail',
} as const;
const html = (await Astro.slots.render('default')).replace(
  /<li>(\s*(?:<p>)?)\[(core|key|detail)\]\s*/g,
  (_m, lead: string, p: keyof typeof LABEL) =>
    `<li class="is-${p}">${lead}<span class="pri pri-${p}">${LABEL[p]}<span class="sr-only">${zh ? '：' : ':'}</span></span>`,
);
---
<div class="outline">
  {title && <span class="outline-title">{title}</span>}
  <Fragment set:html={html} />
</div>
