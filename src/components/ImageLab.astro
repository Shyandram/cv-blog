---
import type { LabDef } from '../lib/playground/labs/types';
import type { Lang } from '../i18n/ui';
import type { Source } from '../lib/playground/catalog';
import { labAssetUrls } from '../lib/playground/labs/assets';
import Predict from './Predict.astro';
interface Props { lab: LabDef; lang: Lang; links: { title: string; href: string }[]; sources: Source[] }
const { lab, lang, links, sources } = Astro.props;
const zh = lang === 'zh-tw';
const urls = labAssetUrls(Object.keys(lab.assets));
---
<image-lab data-lab={lab.id} data-lang={lang} data-assets={JSON.stringify(urls)}>
  <Predict id={lab.id} predict={lab.predict} lang={lang} />
  <div class="lab-controls">
    {lab.controls.map(c => (
      <label class="control">
        <span>{c.label[lang]} {c.kind === 'range' && <output data-value-for={c.key}>{c.value}</output>}</span>
        {c.kind === 'range'
          ? <input disabled data-key={c.key} type="range" min={c.min} max={c.max} step={c.step} value={c.value} />
          : <select disabled data-key={c.key}>{c.options?.map(o => <option value={o.value} selected={o.value === String(c.value)}>{o.label[lang]}</option>)}</select>}
      </label>
    ))}
  </div>
  <div class="lab-actions"><button type="button" data-reset disabled>{zh ? '重設' : 'Reset'}</button></div>
  <p class="lab-status" data-status role="status">{zh ? '正在載入影像…' : 'Loading image…'}</p>
  <div class="lab-panes" style={lab.paneMin ? `--pane-min: ${lab.paneMin}px` : undefined}>
    {lab.panes.map(p => (
      <figure class:list={['pane', { wide: p.wide }]} style={p.kind === 'canvas' ? `--ar: ${p.width} / ${p.height}` : undefined}>
        {p.kind === 'canvas'
          ? <canvas data-pane={p.key} width={p.width} height={p.height} role="img" aria-label={p.label[lang]}></canvas>
          : <div class="pane-svg" data-pane={p.key} role="img" aria-label={p.label[lang]}></div>}
        <figcaption>{p.label[lang]}</figcaption>
      </figure>
    ))}
  </div>
  <dl class="lab-metrics" data-metrics></dl>
  <p class="lab-summary" id={`${lab.id}-summary`} data-summary></p>
  <p class="sr-only" aria-live="polite" aria-atomic="true" data-announce></p>
  <p class="lab-challenge"><strong>{zh ? '試試看：' : 'Try this: '}</strong>{lab.challenge[lang]}</p>
  <p class="lab-note">{lab.note[lang]}</p>
  {links.length > 0 && (
    <nav class="lab-reading" aria-label={zh ? '延伸閱讀' : 'Related lessons'}>
      <span>{zh ? '接著讀' : 'Read next'}</span>
      {links.map(link => <a href={link.href}>{link.title} →</a>)}
    </nav>
  )}
  <details class="lab-sources">
    <summary>{zh ? '方法與影像來源' : 'Method and image sources'}</summary>
    <ul>{sources.map(s => <li><a href={s.url}>{s.title}</a></li>)}</ul>
  </details>
  <noscript><p>{zh ? '這個實驗需要 JavaScript 才能執行。' : 'This experiment needs JavaScript to run.'}</p></noscript>
</image-lab>

<script>
  import { labLoaders } from '../lib/playground/labs/loaders';
  import { loadGray, loadRgb } from '../lib/imagekit/image';
  import type { LabInstance } from '../lib/playground/labs/types';
  import type { State } from '../lib/playground/types';
  import type { Lang } from '../i18n/ui';

  class ImageLab extends HTMLElement {
    private abort?: AbortController;
    private started = false;
    private observer?: IntersectionObserver;
    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      // Decode the image only once the card is visible (inside an opened panel, or inline in a chapter).
      this.observer = new IntersectionObserver(entries => {
        if (!this.started && entries.some(e => e.isIntersecting)) { this.started = true; this.observer?.disconnect(); void this.start(); }
      }, { rootMargin: '300px' });
      this.observer.observe(this);
    }
    disconnectedCallback() { this.abort?.abort(); this.observer?.disconnect(); this.started = false; }

    private async start() {
      const signal = this.abort!.signal;
      const lang: Lang = this.dataset.lang === 'zh-tw' ? 'zh-tw' : 'en';
      const status = this.querySelector<HTMLElement>('[data-status]')!;
      const load = labLoaders[this.dataset.lab ?? ''];
      try {
        if (!load) throw new Error(`Unknown lab ${this.dataset.lab}`);
        const { lab } = await load();
        const urls: Record<string, string> = JSON.parse(this.dataset.assets ?? '{}');
        const images = Object.fromEntries(await Promise.all(Object.entries(lab.assets).map(async ([key, mode]) =>
          [key, mode === 'rgb' ? await loadRgb(urls[key]) : await loadGray(urls[key])] as const)));
        if (signal.aborted) return;
        const instance: LabInstance = lab.create({ lang, images });
        status.hidden = true;
        this.wire(lab.controls.map(c => c.key), lab.controls, instance, lang);
      } catch (err) {
        console.error(err);
        status.textContent = lang === 'zh-tw' ? '無法載入這個實驗。請重新整理頁面，或改讀章節中的圖與說明。' : 'This experiment could not be loaded. Reload the page, or read the chapter figures instead.';
      }
    }

    private wire(keys: string[], controls: { key: string; kind: string; value: string | number; min?: number; max?: number }[], instance: LabInstance, lang: Lang) {
      const signal = this.abort!.signal;
      const fields = Array.from(this.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-key]'));
      const canvases: Record<string, HTMLCanvasElement> = {};
      this.querySelectorAll<HTMLCanvasElement>('canvas[data-pane]').forEach(c => { canvases[c.dataset.pane!] = c; });
      const svgs: Record<string, HTMLElement> = {};
      this.querySelectorAll<HTMLElement>('.pane-svg[data-pane]').forEach(d => { svgs[d.dataset.pane!] = d; });
      const summary = this.querySelector<HTMLElement>('[data-summary]')!;
      const metrics = this.querySelector<HTMLElement>('[data-metrics]')!;
      const announce = this.querySelector<HTMLElement>('[data-announce]')!;
      const render = () => {
        const state: State = {};
        for (const c of controls) {
          const field = fields.find(f => f.dataset.key === c.key)!;
          state[c.key] = c.kind === 'range' ? Math.max(c.min ?? -Infinity, Math.min(c.max ?? Infinity, Number(field.value))) : field.value;
          const out = this.querySelector<HTMLOutputElement>(`[data-value-for="${c.key}"]`);
          if (out) out.textContent = String(state[c.key]);
        }
        const result = instance.render(state, canvases);
        summary.textContent = result.summary;
        for (const [key, markup] of Object.entries(result.plots ?? {})) if (svgs[key]) svgs[key].innerHTML = markup; // our own deterministic SVG
        metrics.replaceChildren(...result.metrics.map(m => {
          const group = document.createElement('div'), dt = document.createElement('dt'), dd = document.createElement('dd');
          dt.textContent = m.label; dd.textContent = m.value; group.append(dt, dd); return group;
        }));
      };
      const setControl = (key: string, value: string | number) => {
        const field = fields.find(f => f.dataset.key === key);
        if (!field) return;
        field.value = String(value);
        schedule();
      };
      let frame = 0;
      const schedule = () => { if (!frame) frame = requestAnimationFrame(() => { frame = 0; render(); }); };
      fields.forEach(f => {
        f.disabled = false;
        f.addEventListener('input', schedule, { signal });
        f.addEventListener('change', () => { render(); announce.textContent = summary.textContent; }, { signal });
      });
      const reset = this.querySelector<HTMLButtonElement>('[data-reset]')!;
      reset.disabled = false;
      reset.addEventListener('click', () => { fields.forEach(f => { f.value = String(controls.find(c => c.key === f.dataset.key)!.value); }); render(); }, { signal });
      void keys; void lang;
      instance.attach?.(canvases, setControl);
      render();
    }
  }
  if (!customElements.get('image-lab')) customElements.define('image-lab', ImageLab);
</script>

<style>
  image-lab { display: block; min-width: 0; --plot-a: #2466c2; --plot-b: #c35b25; --plot-c: #287d51; --plot-d: #8a4daf; --plot-grid: var(--line); --plot-ink: var(--ink); --plot-muted: var(--muted); --plot-bg: var(--surface); }
  .lab-controls { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 24px; }
  .control { display: grid; align-content: start; gap: 8px; font-size: 14px; }
  .control > span { display: flex; gap: 12px; justify-content: space-between; }
  output { font: 12px var(--f-mono); color: var(--accent); font-variant-numeric: tabular-nums; }
  input, select { width: 100%; min-width: 0; accent-color: var(--accent); }
  select { font: 14px/1.5 var(--f-ui); padding: 8px 10px; border: 1px solid var(--line-strong); border-radius: 6px; background: var(--bg); color: var(--ink); }
  input[type=range] { margin: 0; height: 28px; }
  .lab-actions { display: flex; gap: 8px; margin: 14px 0 10px; }
  button { border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--ink); font: 13px var(--f-ui); padding: 8px 12px; cursor: pointer; }
  button:hover:not(:disabled) { border-color: var(--accent); }
  button:disabled { opacity: 0.55; cursor: default; }
  .lab-status { color: var(--muted); font-size: 14px; margin: 8px 0; }
  .lab-panes { display: grid; grid-template-columns: repeat(auto-fit, minmax(var(--pane-min, 220px), 1fr)); gap: 14px; }
  .pane { margin: 0; min-width: 0; }
  .pane.wide { grid-column: 1 / -1; }
  .pane canvas { display: block; width: 100%; height: auto; aspect-ratio: var(--ar); border: 1px solid var(--line); border-radius: 6px; background: var(--surface); }
  .pane-svg { border: 1px solid var(--line); border-radius: 6px; background: var(--surface); overflow: auto; }
  .pane-svg :global(svg) { display: block; width: 100%; max-width: 720px; height: auto; min-width: 460px; fill: var(--plot-ink); }
  .pane-svg :global(svg text) { font-family: var(--f-ui); font-size: 13px; }
  figcaption { font-size: 12.5px; color: var(--muted); margin-top: 6px; }
  .lab-metrics { display: flex; flex-wrap: wrap; gap: 12px 24px; margin: 16px 0; }
  .lab-metrics :global(div) { min-width: 100px; }
  .lab-metrics :global(dt) { font-size: 12px; color: var(--muted); }
  .lab-metrics :global(dd) { margin: 4px 0 0; font: 600 18px var(--f-mono); overflow-wrap: anywhere; }
  .lab-summary { margin: 12px 0; font-size: 15px; }
  .lab-challenge { background: var(--code-bg); padding: 12px 14px; border-radius: 8px; margin: 16px 0 10px; }
  .lab-note { color: var(--muted); font-size: 13px; margin: 0 0 16px; }
  .lab-reading { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; font-size: 13px; }
  .lab-reading span { color: var(--muted); }
  .lab-reading a { display: inline-block; padding-block: 4px; }
  .lab-sources { margin-top: 12px; font-size: 12px; color: var(--muted); }
  .lab-sources summary { cursor: pointer; padding-block: 6px; }
  .lab-sources ul { padding-left: 18px; }
  .lab-sources li { margin-bottom: 6px; }
  .lab-sources a { color: var(--muted); }
  @media (max-width: 640px) { .lab-controls { grid-template-columns: minmax(0, 1fr); } .lab-panes { grid-template-columns: repeat(auto-fit, minmax(min(var(--pane-min, 150px), 100%), 1fr)); } }
  :global(:root[data-theme=dark]) image-lab { --plot-a: #7fb0ff; --plot-b: #ffae77; --plot-c: #6bdba1; --plot-d: #ce9af5; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme=light])) image-lab { --plot-a: #7fb0ff; --plot-b: #ffae77; --plot-c: #6bdba1; --plot-d: #ce9af5; } }
</style>
