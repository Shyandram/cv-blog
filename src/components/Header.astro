---
import { LANGS, LANG_LABEL, LANG_SHORT, type Lang, useT } from '../i18n/ui';
import { url } from '../lib/site';

interface Props { lang: Lang; alternates: Record<Lang, string> }
const { lang, alternates } = Astro.props;
const t = useT(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rel = Astro.url.pathname.slice(base.length);
const links = [
  { href: `/${lang}/learn/`, label: t('nav.learn') },
  { href: `/${lang}/blog/`, label: t('nav.blog') },
  { href: `/${lang}/playground/`, label: t('nav.playground') },
  { href: `/${lang}/about/`, label: t('nav.about') },
];
---
<header class="top">
  <div class="wrap">
    <a class="logo" href={url(`/${lang}/`)}>
      <span class="logo-grid" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
      {t('site.name')}
    </a>
    <nav class="nav" aria-label={t('nav.main')}>
      {links.map((l) => <a href={url(l.href)} aria-current={rel.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="tools">
      <pagefind-modal-trigger placeholder={t('nav.search')} shortcut="mod+k">
        <a class="tool" href={url(`/${lang}/search/`)} aria-label={t('nav.search')}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        </a>
      </pagefind-modal-trigger>
      {LANGS.filter((l) => l !== lang).map((l) => (
        <a class="tool lang" href={url(alternates[l])} hreflang={l} lang={l}
          aria-label={LANG_LABEL[l].includes(LANG_SHORT[l]) ? LANG_LABEL[l] : `${LANG_LABEL[l]} (${LANG_SHORT[l]})`}><span class="lang-long">{LANG_LABEL[l]}</span><span class="lang-short">{LANG_SHORT[l]}</span></a>
      ))}
      <button class="tool" id="theme-toggle" type="button" aria-label={t('theme.toggle')} aria-pressed="false">
        <svg class="i-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z"></path></svg>
        <svg class="i-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const dark = matchMedia('(prefers-color-scheme: dark)');
  const current = () => root.dataset.theme ?? (dark.matches ? 'dark' : 'light');
  // "Toggle dark mode" is pressed while the dark theme is showing.
  const sync = () => btn?.setAttribute('aria-pressed', String(current() === 'dark'));
  sync();
  dark.addEventListener('change', sync);
  btn?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    sync();
    try { localStorage.setItem('theme', next); } catch {}
  });
  // Expose the sticky header's height (0 when it scrolls away on phones) so sticky bars and anchor offsets sit below it.
  const top = document.querySelector<HTMLElement>('header.top');
  if (top) {
    const setHeight = () => root.style.setProperty('--header-h', getComputedStyle(top).position === 'sticky' ? `${Math.ceil(top.getBoundingClientRect().height)}px` : '0px');
    new ResizeObserver(setHeight).observe(top);
    matchMedia('(max-width: 620px)').addEventListener('change', setHeight);
  }
  // Remember an explicit language choice so the root page sends the reader there next time.
  document.querySelectorAll<HTMLAnchorElement>('a.lang').forEach((a) =>
    a.addEventListener('click', () => { try { localStorage.setItem('lang', a.hreflang); } catch {} })
  );
</script>

<style>
  .top { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .wrap { display: flex; align-items: center; gap: 8px 20px; padding-block: 12px; flex-wrap: wrap; }
  .logo { display: flex; align-items: center; gap: 10px; font: 700 18px var(--f-display); color: var(--ink); text-decoration: none; }
  .logo-grid { display: grid; grid-template-columns: repeat(3, 7px); gap: 2px; }
  .logo-grid i { width: 7px; height: 7px; background: var(--ink); border-radius: 1px; }
  .logo-grid i:nth-child(odd) { opacity: 0.25; }
  .logo-grid i:nth-child(5) { opacity: 1; background: var(--accent); }
  .nav { display: flex; gap: 2px; flex-wrap: wrap; }
  .nav a { color: var(--muted); padding: 6px 10px; border-radius: 6px; text-decoration: none; }
  .nav a:hover { color: var(--ink); }
  .nav a[aria-current='page'] { color: var(--ink); text-decoration: underline; text-underline-offset: 7px; }
  .tools { margin-left: auto; display: flex; gap: 6px; align-items: center; }
  .tool { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; height: 44px; padding-inline: 8px; border: 0; border-radius: 4px; background: transparent; color: var(--ink); text-decoration: none; cursor: pointer; font: 13px var(--f-ui); }
  .tool:hover { background: var(--code-bg); }
  /* The icon shows the theme a click switches to: a moon in light mode, a sun in dark mode. */
  .i-sun { display: none; }
  :global(:root[data-theme='dark']) .i-sun { display: block; }
  :global(:root[data-theme='dark']) .i-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-sun { display: block; }
    :global(:root:not([data-theme='light'])) .i-moon { display: none; }
  }
  .lang-short { display: none; }
  /* Phones: two compact rows (logo + 44 px tools, then one scrollable nav row), and the header scrolls away with the
     page so it never covers focused content (WCAG 2.4.11). */
  @media (max-width: 620px) {
    .top { position: relative; backdrop-filter: none; background: var(--bg); }
    .wrap { padding-block: 6px 0; gap: 0 8px; flex-wrap: wrap; }
    .logo { font-size: 16px; gap: 8px; flex: 1 1 auto; min-width: 0; }
    .logo-grid { grid-template-columns: repeat(3, 6px); }
    .logo-grid i { width: 6px; height: 6px; }
    .tools { gap: 4px; }
    .tools :global(pagefind-modal-trigger) { --pf-input-height: 44px; }
    .lang-long { display: none; }
    .lang-short { display: inline; }
    .nav { order: 3; width: calc(100% + 20px); margin-inline: -10px; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
    .nav::-webkit-scrollbar { display: none; }
    .nav a { padding: 11px 10px; white-space: nowrap; }
  }
</style>
