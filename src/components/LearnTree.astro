---
// One track on the Learn page as a tree (src/content/curriculum.ts), with progressive disclosure: only the main chapters
// are shown; a chapter with sub-chapters has one button ("3 sub-chapters") that shows them, and deeper levels open the
// same way. Each page visit starts collapsed. Rows carry data-path
// for StudyMap's reading progress.
export type LearnNode = { slug: string; title: string; href: string; description: string; meta: string[]; short: string; ex: string; children: LearnNode[] };
interface Props { nodes: LearnNode[]; lang: string; depth?: number }
const { nodes, lang, depth = 1 } = Astro.props;
const zh = lang === 'zh-tw';
const count = (n: number) => (zh ? `查看 ${n} 個子章節` : `View ${n} sub-chapter${n === 1 ? '' : 's'}`);
const idOf = (slug: string) => `lt-${slug.replace(/[^a-z0-9]+/gi, '-')}`;
---
{nodes.map((node) => (
  <li class="lt-node" data-depth={Math.min(depth, 4)}>
    <div class="row" data-path={node.href} data-short={node.short} data-ex={node.ex}>
      <a href={node.href} class="title">{node.title}</a>
      <span class="desc">{node.description}</span>
      <span class="meta">{node.meta.map((m) => <span>{m}</span>)}</span>
    </div>
    {node.children.length > 0 && (
      <>
        <button type="button" class="lt-toggle" aria-expanded="false" aria-controls={idOf(node.slug)} data-slug={node.slug} aria-label={zh ? `${node.title}：查看 ${node.children.length} 個子章節` : `${node.title}: view ${node.children.length} sub-chapters`}>{count(node.children.length)}</button>
        <ol class="lt-children" id={idOf(node.slug)} hidden><Astro.self nodes={node.children} lang={lang} depth={depth + 1} /></ol>
      </>
    )}
  </li>
))}

<script>
  // Disclosure choices belong to this page visit; stored reading progress is independent.
  const set = (button: HTMLButtonElement, open: boolean) => {
    const list = document.getElementById(button.getAttribute('aria-controls') ?? '');
    if (!list) return;
    button.setAttribute('aria-expanded', String(open));
    list.hidden = !open;
  };
  document.addEventListener('click', (e) => {
    const button = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('.lt-toggle');
    if (!button) return;
    const open = button.getAttribute('aria-expanded') !== 'true';
    set(button, open);
  });
</script>

<style is:global>
  .lt-tree, .lt-tree ol { list-style: none; margin: 0; padding: 0; }
  .lt-tree { display: grid; gap: 2px; }
  .lt-tree [hidden] { display: none !important; }
  .lt-node { min-width: 0; }
  /* The whole row opens the tutorial (the title link stretches over the row only); the link's name stays the title. */
  .lt-node > .row { position: relative; display: grid; gap: 3px; padding: 10px 12px 12px; border-radius: 8px; }
  .lt-node > .row:hover { background: var(--surface); }
  .lt-node > .row:has(.title:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .lt-node .title { font: 600 16px var(--f-display); color: var(--ink); text-decoration: none; overflow-wrap: anywhere; }
  .lt-node .title::after { content: ''; position: absolute; inset: 0; border-radius: 8px; }
  .lt-node .title:focus-visible { outline: none; }
  .lt-node > .row:hover .title { color: var(--accent); }
  .lt-node .desc { font-family: var(--f-body); color: var(--muted); font-size: 15px; max-width: 72ch; }
  .lt-node .meta { display: flex; flex-wrap: wrap; gap: 2px 0; font: 13px var(--f-ui); color: var(--muted); }
  .lt-node .meta > span:not(:first-child)::before { content: '·'; padding-inline: 7px; }
  /* Progress (added by StudyMap) gets a line of its own, so a wrapped line never starts with a separator. */
  .lt-node .meta .st { flex-basis: 100%; color: var(--ink); }
  .lt-node .meta .st.done { color: var(--t-nlp); font-weight: 600; }
  .lt-node > .row > .pbar { position: absolute; left: 12px; bottom: 3px; width: min(calc(100% - 24px), 72ch); }
  /* The disclosure: a 44 px tall button under the row. */
  .lt-toggle { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; margin: -6px 0 2px 4px; padding: 0 10px; border: 0; border-radius: 8px; background: none; color: var(--tc, var(--accent)); font: 600 13px var(--f-ui); cursor: pointer; }
  .lt-toggle::before { content: ''; width: 6px; height: 6px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(-45deg); }
  .lt-toggle[aria-expanded='true']::before { transform: rotate(45deg); margin-top: -3px; }
  .lt-toggle:hover { background: var(--surface); }
  /* Level 2 and deeper: indented under a connector line, smaller titles; the indent stops growing after level 3. */
  .lt-children { margin: 0 0 8px 14px !important; padding-left: 8px !important; border-left: 2px solid var(--line); display: grid; gap: 1px; }
  .lt-node[data-depth='3'] .lt-children, .lt-node[data-depth='4'] .lt-children { margin-left: 4px !important; border-left-style: dashed; }
  .lt-children > .lt-node > .row { padding-block: 8px 10px; }
  .lt-children > .lt-node > .row .title { font-size: 15px; }
  .lt-children > .lt-node > .row .desc { font-size: 14px; }
</style>
