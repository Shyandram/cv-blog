---
// The chapters of a track as a tree (src/content/curriculum.ts), shown with progressive disclosure: every main chapter is
// one line; only the branch that holds the current page is open (its ancestors, so the current page's siblings show, and
// the current page, so its direct sub-chapters show); everything else opens on demand with a disclosure button. Under the
// current page, its Supplementary notes and Paper guides (pages of their own) are two more disclosures, open only on one
// of those pages. Used by the left rail of a tutorial page and by the "Contents" sheet on narrow screens. The indent stops
// growing after three levels (the connector line still shows the nesting), so deep trees stay legible at 375 px.
export type ChapterNode = { slug: string; title: string; href: string; children: ChapterNode[] };
export type ItemGroup = { label: string; href: string; current: boolean; items: { text: string; href: string; current: boolean }[] };
interface Props {
  nodes: ChapterNode[];
  /** Slug of the tutorial this page belongs to. */
  current: string;
  /** True on the tutorial's main page (its link gets aria-current="page"). */
  currentIsPage?: boolean;
  /** Slugs whose branch starts open (the current tutorial and its ancestors). */
  open: string[];
  /** The current tutorial's notes and paper guides, nested under it. */
  groups?: ItemGroup[];
  /** Prefix for element ids (the tree can appear twice on a page). */
  idPrefix: string;
  lang: string;
  depth?: number;
}
const { nodes, current, currentIsPage = false, open, groups = [], idPrefix, lang, depth = 1 } = Astro.props;
const zh = lang === 'zh-tw';
const short = (title: string) => title.split(/\s*[·・]\s*/)[0];
const idOf = (slug: string, extra = '') => `${idPrefix}-${slug.replace(/[^a-z0-9]+/gi, '-')}${extra}`;
---
{nodes.map((node) => {
  const isCur = node.slug === current;
  const isOpen = open.includes(node.slug);
  const kids = node.children.length > 0;
  return (
    <li class:list={['ct-node', { cur: isCur }]} data-depth={Math.min(depth, 4)}>
      <div class="ct-row">
        {kids
          ? <button type="button" class="ct-toggle" aria-expanded={isOpen ? 'true' : 'false'} aria-controls={idOf(node.slug)}><span class="sr-only">{zh ? `${short(node.title)} 的 ${node.children.length} 個子章節` : `${node.children.length} sub-chapters of ${short(node.title)}`}</span></button>
          : <span class="ct-spacer" aria-hidden="true"></span>}
        <a href={node.href} title={node.title} aria-current={isCur && currentIsPage ? 'page' : undefined}>{node.title}</a>
      </div>
      {isCur && groups.map((g, k) => {
        const gOpen = g.current || g.items.some((it) => it.current);
        return (
          <div class="ct-group">
            <div class="ct-row">
              <button type="button" class="ct-toggle" aria-expanded={gOpen ? 'true' : 'false'} aria-controls={idOf(node.slug, `-g${k}`)}><span class="sr-only">{g.label}</span></button>
              <a class="ct-glabel" href={g.href} aria-current={g.current ? 'page' : undefined}>{g.label}<span class="n">{g.items.length}</span></a>
            </div>
            <ol id={idOf(node.slug, `-g${k}`)} hidden={!gOpen}>{g.items.map((it) => <li><a href={it.href} title={it.text} aria-current={it.current ? 'page' : undefined}>{it.text}</a></li>)}</ol>
          </div>
        );
      })}
      {kids && (
        <ol class="ct-children" id={idOf(node.slug)} hidden={!isOpen}>
          <Astro.self nodes={node.children} current={current} currentIsPage={currentIsPage} open={open} groups={groups} idPrefix={idPrefix} lang={lang} depth={depth + 1} />
        </ol>
      )}
    </li>
  );
})}

<script>
  // Disclosure buttons: show or hide a chapter's sub-chapters (or the current page's notes and paper guides).
  document.addEventListener('click', (e) => {
    const button = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('.ct-toggle');
    if (!button) return;
    const list = document.getElementById(button.getAttribute('aria-controls') ?? '');
    if (!list) return;
    const open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
    list.hidden = !open;
  });
</script>

<style is:global>
  /* Shared by the rail and the Contents sheet: <ol class="ct-tree"> holds the top-level <li class="ct-node">s. */
  .ct-tree, .ct-tree ol { list-style: none; margin: 0; padding: 0; }
  .ct-tree { display: grid; gap: 1px; }
  .ct-tree [hidden] { display: none !important; }
  .ct-node, .ct-group { min-width: 0; }
  .ct-row { display: flex; align-items: center; gap: 0; border-radius: 6px; min-width: 0; }
  /* Titles remain readable without hover, including on touch screens. */
  .ct-row > a { flex: 1; min-width: 0; display: block; padding: 10px 6px 10px 2px; min-height: 44px; color: var(--muted); text-decoration: none; line-height: 1.35; white-space: normal; overflow-wrap: anywhere; }
  .ct-row:hover { background: var(--code-bg); }
  .ct-row > a:hover { color: var(--ink); }
  .ct-node.cur > .ct-row { box-shadow: inset 2px 0 0 var(--ink); }
  .ct-node.cur > .ct-row > a { color: var(--ink); font-weight: 600; white-space: normal; }
  /* Separate 44 px targets keep disclosures from overlapping adjacent links. */
  .ct-toggle, .ct-spacer { flex: none; width: 44px; height: 44px; }
  .ct-toggle { position: relative; display: grid; place-items: center; padding: 0; border: 0; border-radius: 4px; background: none; color: var(--muted); cursor: pointer; }
  .ct-toggle::after { content: ''; position: absolute; inset: 0; }
  .ct-toggle::before { content: ''; width: 6px; height: 6px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(-45deg); }
  .ct-toggle[aria-expanded='true']::before { transform: rotate(45deg); margin-top: -3px; }
  .ct-toggle:hover { color: var(--ink); background: var(--code-bg); }
  @media (pointer: coarse) { .ct-toggle, .ct-spacer { width: 44px; height: 44px; } .ct-toggle::after { inset: 0; } .ct-row > a { padding-block: 10px; } }
  /* Level 2 and deeper: indented under a connector line, in smaller type. The indent stops growing after level 3. */
  .ct-children { margin: 1px 0 4px 11px !important; padding-left: 2px !important; border-left: 1.5px solid var(--line); display: grid; gap: 1px; }
  .ct-node[data-depth='3'] > .ct-children, .ct-node[data-depth='4'] > .ct-children { margin-left: 3px !important; border-left-style: dashed; }
  .ct-children > .ct-node > .ct-row > a { font-size: 0.94em; }
  .ct-children .ct-children > .ct-node > .ct-row > a { font-size: 0.9em; }
  /* Innermost level: the current page's notes and paper guides, lighter. */
  .ct-group { margin-left: 11px; padding-left: 2px; border-left: 1.5px dotted var(--line); }
  .ct-group > ol { margin: 0 0 4px 24px !important; display: grid; }
  .ct-group > ol a { display: block; font-size: 13px; line-height: 1.5; min-height: 44px; padding-block: 10px; color: var(--muted); text-decoration: none; overflow-wrap: anywhere; }
  .ct-group > ol a:hover { color: var(--ink); }
  .ct-row > a.ct-glabel { font: 500 12px var(--f-ui); color: var(--muted); }
  .ct-glabel .n { margin-left: 6px; color: var(--muted); font-weight: 400; }
  .ct-group a[aria-current='page'] { color: var(--ink); font-weight: 600; }
  .ct-group > ol a[aria-current='page'] { margin-left: -10px; padding-left: 8px; border-left: 2px solid var(--tc, var(--accent)); }
  .ct-row > a.ct-glabel[aria-current='page'] { text-decoration: underline; text-underline-offset: 3px; }
</style>
