---
/**
 * Distill-style interactive figure: wraps an existing lab wider than the text column, with a numbered caption.
 *   <LabFigure caption="..."><Lab id="segmentation-metrics" /></LabFigure>
 * Desktop (>= 1200 px): breaks out of the column to --lab-breakout (default 1000px, centred on the column), but never wider than the
 * window minus 2 x --lab-side, the room reserved for sidebars on each side (default 380px, so it cannot run under the current rail and ToC; a layout
 * without sidebars sets --lab-side: 16px). It is never narrower than the column. Below 1200 px it is the column's full width. Figures count themselves ("Interactive figure 1") with a CSS counter,
 * separately from the numbered static figures.
 */
import { LANGS, type Lang } from '../i18n/ui';
interface Props { caption: string }
const { caption } = Astro.props;
const raw = Astro.params.lang;
const lang: Lang = (LANGS as readonly string[]).includes(String(raw)) ? (raw as Lang) : 'en';
const zh = lang === 'zh-tw';
---
<figure class="labfig">
  <div class="labfig-body"><slot /></div>
  <figcaption><strong class="labfig-no">{zh ? '互動圖' : 'Interactive figure'}</strong> — {caption}</figcaption>
</figure>
<style>
  :global(body) { counter-reset: labfig; }
  .labfig { --w: max(100%, min(var(--lab-breakout, 1000px), calc(100vw - 2 * var(--lab-side, 380px)))); counter-increment: labfig; margin: 2em 0; max-width: none; }
  .labfig-body { min-width: 0; }
  /* The lab card brings its own rule and spacing; inside a figure the figure supplies them. */
  .labfig :global(.inline-lab) { margin: 0; padding: 16px 0 12px; border-top: 1px solid var(--line-strong); }
  .labfig-no::after { content: ' ' counter(labfig); }
  figcaption { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line); font: 14px/1.6 var(--f-ui); color: var(--muted); max-width: var(--measure, 40rem); overflow-wrap: anywhere; }
  figcaption strong { color: var(--ink); font-weight: 600; }
  @media (min-width: 1200px) {
    .labfig { width: var(--w); margin-inline: calc((100% - var(--w)) / 2); }
  }
  @media print { .labfig { width: auto; margin-inline: 0; break-inside: avoid; } }
</style>
