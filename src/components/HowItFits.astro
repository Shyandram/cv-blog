---
// "How this fits": a concept and its relations (AGENTS.md §3 "Showing structure"). Drawn from props as plain HTML:
//   builds on  →  this  →  leads to          (a flow row; stacked with ↓ on phones)
//   its parts, each with what it solves       (an indented tree, at most three levels)
// It is one nested list, so a screen reader gets the same information in reading order; arrows and tree lines are CSS.
//
//   <HowItFits
//     center="Image classification" centerNote="Which label fits this whole image?"
//     from={[{ label: 'IP 13', note: 'Bayes classifiers, softmax', href: '/en/learn/…/' }]}
//     to={[{ label: 'DLCV 02A', note: 'Face recognition', href: '/en/learn/…/' }]}
//     parts={[{ label: 'Data', note: 'What the network learns from', children: [{ label: 'Augmentation' }] }]}
//   />
import { type Lang } from '../i18n/ui';
import { url } from '../lib/site';

interface Node { label: string; note?: string; href?: string; tag?: 'core' | 'key' | 'detail'; children?: Node[] }
interface Props {
  center: string;
  centerNote?: string;
  from?: Node[];
  to?: Node[];
  parts?: Node[];
  title?: string;
  fromLabel?: string;
  toLabel?: string;
  partsLabel?: string;
}
const { center, centerNote, from = [], to = [], parts = [], title, fromLabel, toLabel, partsLabel } = Astro.props;
const lang: Lang = /^\/(?:[^/]+\/)*zh-tw\//.test(Astro.url.pathname) ? 'zh-tw' : 'en';
const zh = lang === 'zh-tw';
const L = {
  title: title ?? (zh ? '這一章的位置' : 'How this fits'),
  from: fromLabel ?? (zh ? '建立在' : 'Builds on'),
  to: toLabel ?? (zh ? '接著通往' : 'Leads to'),
  parts: partsLabel ?? (zh ? '組成部分，以及各自解決什麼' : 'Its parts, and what each one solves'),
  pri: { core: zh ? '核心' : 'Core', key: zh ? '重要' : 'Important', detail: zh ? '細節' : 'Detail' },
  sep: zh ? '：' : ': ',
};
const id = `fit-${Math.abs([...center].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7)).toString(36)}`;
const href = (h?: string) => (h && h.startsWith('/') ? url(h) : h);
---
<figure class="fit" aria-labelledby={id}>
  <figcaption class="fit-title" id={id}>{L.title}</figcaption>
  <ul class="fit-flow" role="list">
    {from.length > 0 && (
      <li class="fit-side fit-from">
        <span class="fit-h">{L.from}</span>
        <ul role="list">{from.map((n) => (
          <li class="fit-node">{n.href ? <a href={href(n.href)}>{n.label}</a> : <strong>{n.label}</strong>}{n.note && <span class="fit-note">{n.note}</span>}</li>
        ))}</ul>
      </li>
    )}
    <li class:list={['fit-center', { 'has-from': from.length > 0, 'has-to': to.length > 0 }]}>
      <strong class="fit-this">{center}</strong>
      {centerNote && <span class="fit-note">{centerNote}</span>}
      {parts.length > 0 && (
        <div class="fit-parts">
          <span class="fit-h">{L.parts}</span>
          <ul class="fit-tree" role="list">{parts.map((n) => (
            <li>
              <span class="fit-row">{n.tag && <span class={`pri pri-${n.tag}`}>{L.pri[n.tag]}<span class="sr-only">{L.sep}</span></span>}{n.href ? <a href={href(n.href)}>{n.label}</a> : <strong>{n.label}</strong>}{n.note && <span class="fit-note">{n.note}</span>}</span>
              {n.children && n.children.length > 0 && (
                <ul role="list">{n.children.map((c) => (
                  <li>
                    <span class="fit-row">{c.tag && <span class={`pri pri-${c.tag}`}>{L.pri[c.tag]}<span class="sr-only">{L.sep}</span></span>}{c.href ? <a href={href(c.href)}>{c.label}</a> : <b>{c.label}</b>}{c.note && <span class="fit-note">{c.note}</span>}</span>
                    {c.children && c.children.length > 0 && (
                      <ul role="list">{c.children.map((g) => (
                        <li><span class="fit-row">{g.href ? <a href={href(g.href)}>{g.label}</a> : <span>{g.label}</span>}{g.note && <span class="fit-note">{g.note}</span>}</span></li>
                      ))}</ul>
                    )}
                  </li>
                ))}</ul>
              )}
            </li>
          ))}</ul>
        </div>
      )}
    </li>
    {to.length > 0 && (
      <li class="fit-side fit-to">
        <span class="fit-h">{L.to}</span>
        <ul role="list">{to.map((n) => (
          <li class="fit-node">{n.href ? <a href={href(n.href)}>{n.label}</a> : <strong>{n.label}</strong>}{n.note && <span class="fit-note">{n.note}</span>}</li>
        ))}</ul>
      </li>
    )}
  </ul>
</figure>

<style>
  .fit { margin: 0 0 1.6em; padding: 16px 18px 18px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); font: 15px/1.45 var(--f-ui); max-width: none; }
  .fit-title { margin: 0 0 12px; font: 600 12px var(--f-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .fit ul { list-style: none; margin: 0; padding: 0; }
  .fit-flow { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr) minmax(0, 1fr); gap: 14px 40px; align-items: start; }
  .fit-flow:not(:has(.fit-from)) { grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr); }
  .fit-flow:not(:has(.fit-to)) { grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr); }
  .fit-flow:not(:has(.fit-from, .fit-to)) { grid-template-columns: minmax(0, 1fr); }
  .fit-h { display: block; margin-bottom: 6px; font: 600 11px var(--f-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  :global(:lang(zh)) .fit-h, :global(:lang(zh)) .fit-title { letter-spacing: 0.04em; font-size: 12px; }
  .fit-side ul { display: grid; gap: 8px; }
  .fit-node { padding: 8px 10px; border: 1px solid var(--line-strong); border-radius: 8px; background: var(--bg); }
  .fit-node a, .fit-node strong { font-weight: 600; }
  .fit-note { display: block; color: var(--muted); font-size: 13.5px; }
  .fit-center { position: relative; padding: 12px 14px 14px; border: 2px solid var(--tc, var(--accent)); border-radius: 10px; }
  /* Arrows between the columns: decorative, drawn in the gaps. */
  .fit-center.has-from::before, .fit-center.has-to::after { position: absolute; top: 14px; width: 40px; text-align: center; font: 600 20px/1 var(--f-ui); color: var(--muted); }
  .fit-center.has-from::before { content: '→'; left: -42px; }
  .fit-center.has-to::after { content: '→'; right: -42px; }
  .fit-this { display: block; font: 700 18px/1.3 var(--f-display); }
  .fit-parts { margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line); }
  /* The parts tree: ├ / └ connectors drawn with borders. */
  .fit-tree li { position: relative; padding-left: 20px; }
  .fit-tree li + li { margin-top: 6px; }
  .fit-tree li::before { content: ''; position: absolute; left: 6px; top: 0; bottom: -6px; border-left: 1px solid var(--connector); }
  .fit-tree li:last-child::before { bottom: auto; height: 0.8em; }
  .fit-tree li::after { content: ''; position: absolute; left: 6px; top: 0.8em; width: 10px; border-top: 1px solid var(--connector); }
  .fit-tree ul { margin-top: 5px; font-size: 14px; }
  .fit-tree ul ul { color: var(--muted); font-size: 13.5px; }
  .fit-row { display: block; }
  .fit-row > :is(strong, b, a) { font-weight: 600; }
  .fit-row .fit-note { display: inline; }
  .fit-row > :is(strong, b, a, span:not(.fit-note, .pri)) + .fit-note::before { content: ' — '; }
  :global(:lang(zh)) .fit-row > :is(strong, b, a, span:not(.fit-note, .pri)) + .fit-note::before { content: '：'; }
  .pri { display: inline-block; margin-right: 0.45em; }
  @media (max-width: 760px) {
    .fit { padding: 14px 12px; }
    .fit-flow, .fit-flow:not(:has(.fit-from)), .fit-flow:not(:has(.fit-to)) { grid-template-columns: minmax(0, 1fr); gap: 30px; }
    .fit-center.has-from::before { content: '↓'; left: 0; right: 0; width: auto; top: -26px; }
    .fit-center.has-to::after { content: '↓'; left: 0; right: 0; width: auto; top: auto; bottom: -26px; }
    .fit-tree li { padding-left: 16px; }
  }
</style>
