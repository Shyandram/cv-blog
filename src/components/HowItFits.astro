---
// "How it fits" (AGENTS.md §3 "Showing structure and layers"): where a concept sits among others, drawn from props as
// plain HTML — what it builds on → this → what it leads to, and its parts with the problem each part solves.
// It is ONE nested list in reading order, so a screen reader and the PDF (scripts/book/export.mjs) get the same
// information; the columns, arrows and tree lines are CSS only.
//
//   <HowItFits
//     center="Deep image classification" centerNote="Which label fits this whole image?"
//     from={[{ chapter: 'image-processing/dip-13-pattern-classification', note: 'Bayes classifiers, softmax by hand' }]}
//     to={[{ chapter: 'deep-learning/dl-02a-face-metric-learning', note: 'Classification turned into comparison' }]}
//     parts={[{ label: 'Data', note: 'what the network learns from', href: '#datasets-and-why-they-matter', tag: 'core',
//               children: [{ label: 'Augmentation', href: '#data-augmentation' }] }]}
//   />
//
// A node names a tutorial with `chapter` (a curriculum slug, `<track>/<file name>`; the label defaults to its full name,
// e.g. "IP 13 · Image Pattern Classification", and the build fails if the tutorial does not exist) or links anywhere with `href` (an in-page `#id` is
// checked by scripts/check-site-links.py). `tag` is an optional priority: 'core' | 'key' | 'detail'. Parts nest at
// most two levels. `fromLabel` / `toLabel` rename the side columns (e.g. "Related chapters"). No citations ([n]) in props: they are not linked there; keep cited claims in the prose.
import { tutorialsFor, url } from '../lib/site';
import type { Lang } from '../i18n/ui';

type Tag = 'core' | 'key' | 'detail';
interface Node { label?: string; chapter?: string; href?: string; note?: string; tag?: Tag; children?: Node[] }
interface Props { center: string; centerNote?: string; from?: Node[]; to?: Node[]; parts?: Node[]; title?: string; fromLabel?: string; toLabel?: string }
const { center, centerNote, from = [], to = [], parts = [], title, fromLabel, toLabel } = Astro.props;
const lang: Lang = /^\/(?:[^/]+\/)*zh-tw\//.test(Astro.url.pathname) ? 'zh-tw' : 'en';
const zh = lang === 'zh-tw';
const list = await tutorialsFor(lang);
type Resolved = { label: string; href?: string; full?: string; note?: string; tag?: Tag; children: Resolved[] };
const resolve = (n: Node, depth = 1): Resolved => {
  if (depth > 2 && n.children?.length) throw new Error(`HowItFits: parts nest at most two levels (${n.label})`);
  let label = n.label, href = n.href, full: string | undefined;
  if (n.chapter) {
    const hit = list.find((x) => x.slug === n.chapter);
    if (!hit) throw new Error(`HowItFits: unknown chapter "${n.chapter}" on ${Astro.url.pathname}`);
    full = hit.entry.data.title;
    label ??= full;
    href = url(`/${lang}/learn/${hit.slug}/`);
  }
  if (!label) throw new Error('HowItFits: a node needs a label or a chapter');
  return { label, href, full: full && full !== label ? full : undefined, note: n.note, tag: n.tag, children: (n.children ?? []).map((c) => resolve(c, depth + 1)) };
};
const F = from.map((n) => resolve(n)), T = to.map((n) => resolve(n)), P = parts.map((n) => resolve(n));
const L = {
  title: title ?? (zh ? '本章的位置' : 'How it fits'),
  from: fromLabel ?? (zh ? '建立在' : 'Builds on'),
  center: zh ? '本章' : 'This chapter',
  to: toLabel ?? (zh ? '接著通往' : 'Leads to'),
  parts: zh ? '組成部分，以及各自解決的問題' : 'Its parts, and the problem each one solves',
  pri: { core: zh ? '核心' : 'Core', key: zh ? '重要' : 'Important', detail: zh ? '細節' : 'Detail' },
  sep: zh ? '：' : ': ',
};
const uid = `fit-${Math.abs([...center].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7)).toString(36)}`;
---
<section class="fit" aria-labelledby={uid}>
  <p class="fit-title" id={uid}>{L.title}</p>
  <ul class="fit-flow">
    {F.length > 0 && (
      <li class="fit-side fit-from"><span class="fit-h">{L.from}</span>
        <ul>{F.map((n) => <li class="fit-node">{n.href ? <a href={n.href} title={n.full}>{n.label}</a> : <strong>{n.label}</strong>}{n.note && <span class="fit-note">{n.note}</span>}</li>)}</ul>
      </li>
    )}
    <li class:list={['fit-center', { 'has-from': F.length > 0, 'has-to': T.length > 0 }]}><span class="fit-h">{L.center}</span>
      <strong class="fit-this">{center}</strong>
      {centerNote && <span class="fit-note">{centerNote}</span>}
      {P.length > 0 && (
        <div class="fit-parts"><span class="fit-h">{L.parts}</span>
          <ul class="fit-tree">{P.map((n) => (
            <li>
              <span class="fit-row">{n.tag && <span class={`pri pri-${n.tag}`}>{L.pri[n.tag]}<span class="sr-only">{L.sep}</span></span>}{n.href ? <a href={n.href} title={n.full}>{n.label}</a> : <strong>{n.label}</strong>}{n.note && <span class="fit-note">{n.note}</span>}</span>
              {n.children.length > 0 && (
                <ul>{n.children.map((c) => (
                  <li><span class="fit-row">{c.tag && <span class={`pri pri-${c.tag}`}>{L.pri[c.tag]}<span class="sr-only">{L.sep}</span></span>}{c.href ? <a href={c.href} title={c.full}>{c.label}</a> : <span class="fit-label">{c.label}</span>}{c.note && <span class="fit-note">{c.note}</span>}</span></li>
                ))}</ul>
              )}
            </li>
          ))}</ul>
        </div>
      )}
    </li>
    {T.length > 0 && (
      <li class="fit-side fit-to"><span class="fit-h">{L.to}</span>
        <ul>{T.map((n) => <li class="fit-node">{n.href ? <a href={n.href} title={n.full}>{n.label}</a> : <strong>{n.label}</strong>}{n.note && <span class="fit-note">{n.note}</span>}</li>)}</ul>
      </li>
    )}
  </ul>
</section>
