---
/**
 * Distill-style margin note, written inline: "... the denominator <MarginNote>pixels that are true or predicted</MarginNote> ...".
 * Wide screens (>= 1200 px): a numbered note floats into the right margin beside its paragraph; the prose column does not move.
 * Narrower screens: the note becomes an aside under its paragraph (a small script moves it; without JavaScript it stays in the
 * sentence, set off in brackets, so nothing is lost). Numbers come from a CSS counter, so notes number themselves per page.
 * The margin is used only when the .prose column is at least 820 px wide (container query): the note takes the room the column has beside
 * the text measure (between 120 and 200 px), so it never runs under a sidebar or the table of contents.
 * Tune with --mn-width (200px at most) and --mn-gap on any ancestor. Notes hold short plain text only (no headings, no new facts).
 */
---
<span class="mn"><sup class="mn-mark" aria-hidden="true"></sup><span class="mn-note" role="note"><slot /></span></span>
<style is:global>
  body { counter-reset: mn; }
  .prose { container-type: inline-size; } /* the margin is used only when the text column itself has room for it (see the container query) */
  .mn { counter-increment: mn; }
  .mn-mark::before { content: counter(mn); }
  .mn-mark { font: 600 0.62em/0 var(--f-ui); color: var(--accent); margin-inline: 1px 2px; }
  /* Default (no JavaScript, narrow): the note stays in the sentence, in brackets, numbered. */
  .mn-note { font: 14px/1.55 var(--f-ui); color: var(--muted); font-style: normal; overflow-wrap: anywhere; }
  .mn-note::before { content: ' [' counter(mn) ' '; font-weight: 600; color: var(--accent); }
  .mn-note::after { content: ']'; }
  /* Narrow with JavaScript: moved under its paragraph. */
  .mn-note.mn-below { display: block; margin: -0.4em 0 1em; padding: 6px 0 6px 12px; max-width: var(--measure, 40rem); border-left: 2px solid var(--line-strong); }
  .mn-note.mn-below::before { content: attr(data-n) '.'; margin-right: 6px; }
  .mn-note.mn-below::after { content: none; }
  /* Margin mode: window >= 1200 px AND a column with at least ~140 px beside the text measure for the gap and the note. */
  @media (min-width: 1200px) {
    @container (min-width: 820px) {
      .mn-note, .mn-note.mn-below {
        --mnw: clamp(120px, calc(100cqw - var(--measure, 40rem) - var(--mn-gap, 20px)), var(--mn-width, 200px));
        float: right; clear: right; box-sizing: border-box; display: block;
        width: var(--mnw); margin: 0.2em calc(-1 * (var(--mnw) + var(--mn-gap, 20px))) 0.6em 0;
        padding: 8px 0 0; border-left: 0; border-top: 1px solid var(--line-strong);
        font-size: 13px; line-height: 1.5; max-width: none;
      }
      .mn-note::before, .mn-note.mn-below::before { content: counter(mn) ' '; margin: 0; font-weight: 600; color: var(--accent); }
      .mn-note::after { content: none; }
    }
  }
  @media print { .mn-note, .mn-note.mn-below { float: none !important; margin: 0 !important; } }
</style>
<script>
  // When the margin is not available: place each note after the paragraph that contains it; otherwise put it back in the sentence.
  const mq = window.matchMedia('(min-width: 1200px)');
  const wide = { get matches() { return mq.matches && (document.querySelector('.prose')?.clientWidth ?? 0) >= 820; } }; // same test as the CSS
  const notes = Array.from(document.querySelectorAll<HTMLElement>('.mn-note'));
  const homes = new Map<HTMLElement, HTMLElement>();
  const place = () => {
    const last = new Map<Element, Element>();
    notes.forEach((note, i) => {
      const home = homes.get(note) ?? (note.parentElement as HTMLElement);
      homes.set(note, home);
      note.dataset.n = String(i + 1);
      if (wide.matches) {
        if (note.parentElement !== home) home.append(note);
        note.classList.remove('mn-below');
        return;
      }
      const block = home.closest('p, li, td, dd') ?? home;
      if (block.matches('li, td, dd')) block.append(note);
      else (last.get(block) ?? block).after(note);
      last.set(block, note);
      note.classList.add('mn-below');
    });
  };
  if (notes.length) {
    place();
    mq.addEventListener('change', place);
    const prose = document.querySelector('.prose');
    if (prose && 'ResizeObserver' in window) { let was = wide.matches; new ResizeObserver(() => { if (wide.matches !== was) { was = wide.matches; place(); } }).observe(prose); }
  }
</script>
