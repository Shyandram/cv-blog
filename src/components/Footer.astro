---
import { type Lang, useT } from '../i18n/ui';
import { url, REPO } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<footer class="site-foot">
  <div class="wrap">
    <span>© {new Date().getFullYear()} {t('site.name')}</span>
    <span>
      <a href={url(`/${lang}/rss.xml`)}>{t('footer.rss')}</a>{' · '}<a href={`https://github.com/${REPO}`}>{t('footer.source')}</a>
    </span>
  </div>
</footer>
