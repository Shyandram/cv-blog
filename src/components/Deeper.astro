---
// Layer 2 of a tutorial (AGENTS.md §3 "Reading layers"): content a reader opens only when they need it — the precise
// version (definitions, derivations, math), a worked example, the tested code and its output. One click expands it in
// place. It is a native <details>, so it works without JavaScript, keeps keyboard and screen-reader semantics, and
// browsers' find-in-page opens it. src/scripts/disclosure.ts also opens it for deep links and search hits, remembers
// a reader's "Expand all", and printing opens every block (src/scripts/prose.ts). The PDF book prints the children inline.
//
//   <Deeper kind="precise">…</Deeper>                       "The precise version" / 「精確版本」
//   <Deeper kind="code" title="Mixup and CutMix in PyTorch">…</Deeper>
//   <Deeper kind="example" open>…</Deeper>                  open by default
import { type Lang } from '../i18n/ui';

type Kind = 'precise' | 'code' | 'example' | 'derivation' | 'more';
interface Props { kind?: Kind; title?: string; open?: boolean; id?: string }
const { kind = 'precise', title, open = false, id } = Astro.props;
const lang: Lang = /^\/(?:[^/]+\/)*zh-tw\//.test(Astro.url.pathname) ? 'zh-tw' : 'en';
const zh = lang === 'zh-tw';
const KIND: Record<Kind, { en: [string, string]; zh: [string, string] }> = {
  //            [badge, default title]
  precise:    { en: ['Precise', 'The precise version'], zh: ['精確', '精確版本'] },
  code:       { en: ['Code', 'Code and output'], zh: ['程式', '程式碼與輸出'] },
  example:    { en: ['Example', 'Worked example'], zh: ['範例', '計算範例'] },
  derivation: { en: ['Derivation', 'Derivation'], zh: ['推導', '推導'] },
  more:       { en: ['More', 'More detail'], zh: ['延伸', '更多細節'] },
};
const [badge, fallbackTitle] = KIND[kind][zh ? 'zh' : 'en'];
// What is inside, counted from the rendered HTML, so the reader can judge the cost of opening it.
const html = await Astro.slots.render('default');
const count = (re: RegExp) => (html.match(re) ?? []).length;
const equations = count(/class="katex-display"/g);
const codeLines = [...html.matchAll(/<pre[^>]*>([\s\S]*?)<\/pre>/g)].reduce((n, m) => n + (m[1].match(/class="line"/g)?.length || m[1].split('\n').length), 0);
const figures = count(/<figure\b/g);
const parts = [
  equations ? (zh ? `${equations} 條方程式` : `${equations} equation${equations > 1 ? 's' : ''}`) : '',
  codeLines ? (zh ? `${codeLines} 行程式碼` : `${codeLines} lines of code`) : '',
  figures ? (zh ? `${figures} 張圖` : `${figures} figure${figures > 1 ? 's' : ''}`) : '',
].filter(Boolean);
const meta = parts.join(zh ? '・' : ' · ');
---
<details class={`disclosure deeper deeper-${kind}`} open={open} id={id} data-deeper>
  <summary>
    <span class="dis-kind">{badge}</span>
    <span class="dis-label">{title ?? fallbackTitle}</span>
    {meta && <span class="dis-meta">{meta}</span>}
    <span class="dis-act" aria-hidden="true" data-show={zh ? '展開' : 'Show'} data-hide={zh ? '收合' : 'Hide'}></span>
  </summary>
  <div class="dis-body"><Fragment set:html={html} /></div>
</details>
