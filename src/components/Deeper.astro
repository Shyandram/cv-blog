---
// Layer 2 of a tutorial section (AGENTS.md §3 "Showing structure and layers"): the precise version (definitions,
// derivations, math), a worked example, or code with its output, one click away and expanded in place.
//
//   <Deeper title="Softmax and cross-entropy, precisely">
//
//   Markdown, math, code and figures; no headings.
//
//   </Deeper>
//
//   kind: 'precise' (default) | 'example' | 'derivation' | 'code' | 'more' — sets the small label before the title.
//
// It is a native <details>, closed in the HTML: no layout shift, readable and operable without JavaScript, keyboard
// and screen-reader semantics for free, and Chromium's find-in-page opens it. src/scripts/chapter-sections.ts opens it
// for deep links and search hits inside it, src/scripts/prose.ts opens it for printing, the section map's layer switch
// opens all of them, and the PDF exporter (scripts/book/export.mjs) prints the children inline under the title.
interface Props { title: string; kind?: 'precise' | 'example' | 'derivation' | 'code' | 'more'; id?: string }
const { title, kind = 'precise', id } = Astro.props;
const zh = /^\/(?:[^/]+\/)*zh-tw\//.test(Astro.url.pathname);
const KIND = {
  precise: zh ? '精確版' : 'Precise',
  example: zh ? '計算範例' : 'Worked example',
  derivation: zh ? '推導' : 'Derivation',
  code: zh ? '程式碼' : 'Code',
  more: zh ? '延伸' : 'More',
} as const;
// What is inside, counted from the rendered children, so the reader can judge the cost of opening it.
const html = await Astro.slots.render('default');
const count = (re: RegExp) => (html.match(re) ?? []).length;
const equations = count(/class="katex-display/g);
const code = count(/class="rt-code/g);
const figures = count(/<figure\b/g);
const parts = [
  equations ? (zh ? `${equations} 條式子` : `${equations} equation${equations > 1 ? 's' : ''}`) : '',
  code ? (zh ? `${code} 段程式碼` : `${code} code block${code > 1 ? 's' : ''}`) : '',
  figures ? (zh ? `${figures} 張圖` : `${figures} figure${figures > 1 ? 's' : ''}`) : '',
].filter(Boolean);
const slug = (s: string) => s.toLowerCase().normalize('NFKC').replace(/<[^>]*>/g, '').replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-+|-+$/g, '');
const anchor = id ?? `deeper-${slug(title)}`;
---
<details class={`deeper deeper-${kind}`} id={anchor} data-deeper>
  <summary>
    <span class="deeper-text">
      <span class="deeper-kind">{KIND[kind]}<span class="sr-only">{zh ? '：' : ': '}</span></span>
      <span class="deeper-title">{title}</span>
    </span>
    {parts.length > 0 && <span class="deeper-meta" data-pagefind-ignore>{parts.join(zh ? '・' : ' · ')}</span>}
    <span class="deeper-act" aria-hidden="true" data-show={zh ? '展開' : 'Show'} data-hide={zh ? '收合' : 'Hide'}></span>
  </summary>
  <div class="deeper-body"><Fragment set:html={html} /></div>
</details>
