---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useT, type Lang } from '../i18n/ui';
interface Props { src: ImageMetadata; alt: string; caption?: string; width?: number; pixelated?: boolean }
const { src, alt, caption, width, pixelated = false } = Astro.props;
// Figures are drawn at up to 1600 px; on a phone the labels shrink to a few pixels, so each figure links to its full-size file.
const lang: Lang = /^\/(?:[^/]+\/)*zh-tw\//.test(Astro.url.pathname) ? 'zh-tw' : 'en';
const t = useT(lang);
const label = t('fig.open').replace('{alt}', alt);
---
<figure class="fig">
  <a class="fig-zoom" href={src.src} aria-label={label}>
    <Image src={src} alt={alt} width={width} style={pixelated ? 'image-rendering: pixelated' : undefined} />
    <span class="fig-badge" aria-hidden="true">⤢ {t('fig.tap')}</span>
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  .fig { margin: 0 0 1.4em; }
  .fig-zoom { position: relative; display: block; width: fit-content; max-width: 100%; margin-inline: auto; cursor: zoom-in; border-radius: 6px; }
  .fig :global(img) { display: block; margin-inline: auto; }
  .fig-badge { display: none; position: absolute; right: 6px; bottom: 6px; padding: 3px 8px; border-radius: 999px; font: 600 11px var(--f-ui); background: color-mix(in srgb, var(--ink) 78%, transparent); color: var(--bg); pointer-events: none; }
  @media (max-width: 620px) { .fig-badge { display: inline-block; } }
  figcaption { font: 13px var(--f-ui); color: var(--muted); margin-top: 6px; text-align: center; overflow-wrap: anywhere; } /* long script paths in captions would widen the page on phones */
  @media print { .fig-badge { display: none !important; } }
</style>
