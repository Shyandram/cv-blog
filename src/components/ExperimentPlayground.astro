---
import type { Experiment, State } from '../lib/playground/types';
import type { Lang } from '../i18n/ui';
import type { Source } from '../lib/playground/catalog';
import Predict from './Predict.astro';
interface Props {
  experiment: Experiment;
  lang: Lang;
  links: { title: string; href: string }[];
  sources: Source[];
}
const { experiment: e, lang, links, sources } = Astro.props;
const zh = lang === 'zh-tw';
const state: State = Object.fromEntries(e.controls.map(c => [c.key, c.value]));
const initial = e.compute(state, lang);
---
<experiment-playground data-experiment={e.id} data-lang={lang}>
  {e.predict && <Predict id={e.id} predict={e.predict} lang={lang} />}
  <div class="experiment-controls">
    {e.controls.map(c => (
      <label class:list={['control', { wide: c.kind === 'textarea' }]}>
        <span>{c.label[lang]} {c.kind === 'range' && <output data-value-for={c.key}>{c.value}</output>}</span>
        {c.kind === 'range' ? <input disabled data-key={c.key} type="range" min={c.min} max={c.max} step={c.step} value={c.value} /> :
          c.kind === 'select' ? <select disabled data-key={c.key}>{c.options?.map(o => <option value={o.value} selected={o.value === String(c.value)}>{o.label[lang]}</option>)}</select> :
          c.kind === 'textarea' ? <textarea disabled data-key={c.key} rows="4" maxlength="1200" spellcheck="false">{c.value}</textarea> :
          <input disabled data-key={c.key} type="text" maxlength="160" value={c.value} spellcheck="false" />}
      </label>
    ))}
  </div>
  <div class="experiment-actions">
    <button type="button" data-reset disabled>{zh ? '重設' : 'Reset'}</button>
    <button type="button" data-zoom aria-pressed="false" disabled>{zh ? '放大圖表' : 'Enlarge plot'}</button>
  </div>
  <div class="experiment-plot" tabindex="0" role="group" aria-label={e.title[lang]} aria-describedby={`${e.id}-summary`} set:html={initial.svg}></div>
  <dl class="experiment-metrics">{initial.metrics.map(m => <div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}</dl>
  <p class="experiment-summary" id={`${e.id}-summary`}>{initial.summary}</p>
  <p class="sr-only" aria-live="polite" aria-atomic="true" data-announce></p>
  <p class="experiment-challenge"><strong>{zh ? '試試看：' : 'Try this: '}</strong>{e.challenge[lang]}</p>
  <p class="experiment-note">{e.note[lang]}</p>
  {links.length > 0 && (
    <nav class="experiment-reading" aria-label={zh ? '延伸閱讀' : 'Related lessons'}>
      <span>{zh ? '接著讀' : 'Read next'}</span>
      {links.map(link => <a href={link.href}>{link.title} →</a>)}
    </nav>
  )}
  <details class="experiment-sources">
    <summary>{zh ? '方法來源' : 'Method sources'}</summary>
    <ul>{sources.map(s => <li><a href={s.url}>{s.title}</a></li>)}</ul>
  </details>
  <noscript><p>{zh ? '以上為預設結果；啟用 JavaScript 後即可調整控制項。' : 'Default results are shown. Enable JavaScript to adjust the controls.'}</p></noscript>
</experiment-playground>

<script>
  import { experiments } from '../lib/playground/catalog';
  import type { State } from '../lib/playground/types';
  import type { Lang } from '../i18n/ui';

  class ExperimentPlayground extends HTMLElement {
    private abort?: AbortController;
    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      const signal = this.abort.signal;
      const e = experiments.find(x => x.id === this.dataset.experiment);
      if (!e) return;
      const lang = this.dataset.lang === 'zh-tw' ? 'zh-tw' : 'en';
      const fields = Array.from(this.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[data-key]'));
      const plot = this.querySelector<HTMLElement>('.experiment-plot')!;
      const summary = this.querySelector<HTMLElement>('.experiment-summary')!;
      const metrics = this.querySelector<HTMLElement>('.experiment-metrics')!;
      const announce = this.querySelector<HTMLElement>('[data-announce]')!;
      const render = () => {
        const state: State = {};
        for (const control of e.controls) {
          const field = fields.find(f => f.dataset.key === control.key)!;
          state[control.key] = control.kind === 'range'
            ? Math.max(control.min ?? -Infinity, Math.min(control.max ?? Infinity, Number(field.value))) : field.value;
          const output = this.querySelector<HTMLOutputElement>(`[data-value-for="${control.key}"]`);
          if (output) output.textContent = String(state[control.key]);
        }
        const result = e.compute(state, lang as Lang);
        // Only our deterministic renderers generate SVG. They escape any editable text.
        plot.innerHTML = result.svg;
        summary.textContent = result.summary;
        metrics.replaceChildren(...result.metrics.map(m => {
          const group = document.createElement('div');
          const dt = document.createElement('dt'), dd = document.createElement('dd');
          dt.textContent = m.label; dd.textContent = m.value;
          group.append(dt, dd); return group;
        }));
      };
      // Sighted users see the summary update while dragging; screen readers hear it once the change is committed.
      fields.forEach(field => {
        field.disabled = false;
        field.addEventListener('input', render, { signal });
        field.addEventListener('change', () => { render(); announce.textContent = summary.textContent; }, { signal });
      });
      const reset = this.querySelector<HTMLButtonElement>('[data-reset]')!;
      reset.disabled = false;
      reset.addEventListener('click', () => {
        fields.forEach(field => field.value = String(e.controls.find(c => c.key === field.dataset.key)!.value));
        render();
      }, { signal });
      const zoom = this.querySelector<HTMLButtonElement>('[data-zoom]')!;
      zoom.disabled = false;
      zoom.addEventListener('click', () => {
        const enlarged = plot.classList.toggle('enlarged');
        zoom.setAttribute('aria-pressed', String(enlarged));
        zoom.textContent = lang === 'zh-tw' ? (enlarged ? '符合頁面寬度' : '放大圖表') : (enlarged ? 'Fit plot' : 'Enlarge plot');
      }, { signal });
    }
    disconnectedCallback() { this.abort?.abort(); }
  }
  if (!customElements.get('experiment-playground')) customElements.define('experiment-playground', ExperimentPlayground);
</script>

<style>
  experiment-playground { display: block; min-width: 0; --plot-a: #2466c2; --plot-b: #c35b25; --plot-c: #287d51; --plot-d: #8a4daf; --plot-grid: var(--line); --plot-ink: var(--ink); --plot-muted: var(--muted); --plot-bg: var(--surface); }
  .experiment-controls { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 16px 24px; }
  .control { display: grid; align-content: start; gap: 8px; font-size: 14px; }
  .control > span { display: flex; gap: 12px; justify-content: space-between; }
  .wide { grid-column: 1 / -1; }
  output { font: 12px var(--f-mono); color: var(--accent); font-variant-numeric: tabular-nums; }
  input, select, textarea { width: 100%; min-width: 0; accent-color: var(--accent); }
  input[type=text], select, textarea { font: 14px/1.5 var(--f-ui); padding: 8px 10px; border: 1px solid var(--line-strong); border-radius: 6px; background: var(--bg); color: var(--ink); }
  input[type=range] { margin: 0; height: 28px; }
  textarea { resize: vertical; }
  .experiment-actions { display: flex; gap: 8px; margin: 16px 0 12px; }
  button { border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--ink); font: 13px var(--f-ui); padding: 8px 12px; cursor: pointer; }
  button:hover { border-color: var(--accent); }
  .experiment-plot { border: 1px solid var(--line); border-radius: 8px; background: var(--surface); overflow: auto; }
  .experiment-plot > :global(svg) { display: block; width: 100%; height: auto; fill: var(--plot-ink); }
  .experiment-plot :global(svg text) { font-family: var(--f-ui); font-size: 14px; }
  .experiment-plot.enlarged > :global(svg) { min-width: 800px; }
  /* A 640-unit viewBox shrinks its 14-unit labels below 8 px on a phone; keep them readable and let the plot scroll inside its card. */
  @media (max-width: 640px) { .experiment-plot > :global(svg) { min-width: 560px; } }
  .experiment-metrics { display: flex; flex-wrap: wrap; gap: 12px 24px; margin: 16px 0; }
  .experiment-metrics :global(div) { min-width: 100px; }
  .experiment-metrics :global(dt) { font-size: 12px; color: var(--muted); }
  .experiment-metrics :global(dd) { margin: 4px 0 0; font: 600 18px var(--f-mono); overflow-wrap: anywhere; }
  .experiment-summary { margin: 12px 0; font-size: 15px; }
  .experiment-challenge { background: var(--code-bg); padding: 12px 14px; border-radius: 8px; margin: 16px 0 10px; }
  .experiment-note { color: var(--muted); font-size: 13px; margin: 0 0 16px; }
  .experiment-reading { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; font-size: 13px; }
  .experiment-reading span { color: var(--muted); }
  .experiment-reading a { overflow-wrap: anywhere; display: inline-block; padding-block: 4px; }
  .experiment-sources { margin-top: 12px; font-size: 12px; color: var(--muted); }
  .experiment-sources summary { cursor: pointer; padding-block: 6px; }
  .experiment-sources ul { padding-left: 18px; }
  .experiment-sources li { margin-bottom: 6px; }
  .experiment-sources a { color: var(--muted); }
  @media (max-width: 520px) { .experiment-controls { grid-template-columns: minmax(0,1fr); } }
  :global(:root[data-theme=dark]) experiment-playground { --plot-a: #7fb0ff; --plot-b: #ffae77; --plot-c: #6bdba1; --plot-d: #ce9af5; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme=light])) experiment-playground { --plot-a: #7fb0ff; --plot-b: #ffae77; --plot-c: #6bdba1; --plot-d: #ce9af5; } }
</style>
