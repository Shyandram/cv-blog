---
interface Props { type?: 'note' | 'tip' | 'warn' | 'math'; title?: string }
const { type = 'note', title } = Astro.props;
---
<aside class={`callout ${type}`}>
  {title && <strong>{title}</strong>}
  <slot />
</aside>
<style>
  .callout { --c: var(--accent); border-left: 3px solid var(--c); background: var(--code-bg); padding: 10px 14px; border-radius: 0 8px 8px 0; font: 15px/1.55 var(--f-ui); }
  .callout.tip { --c: var(--t-image-processing); }
  .callout.warn { --c: var(--t-ml); }
  .callout.math { --c: var(--t-pattern-recognition); }
  strong { display: block; font: 600 11px var(--f-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--c); margin-bottom: 4px; }
  .callout :global(p) { margin: 0; }
  .callout :global(p + p) { margin-top: 0.5em; }
</style>
