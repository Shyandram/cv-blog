---
import type { Predict } from '../lib/playground/types';
import type { Lang } from '../i18n/ui';
interface Props { id: string; predict: Predict; lang: Lang }
const { id, predict, lang } = Astro.props;
const zh = lang === 'zh-tw';
---
<predict-reveal data-answer={predict.answer} data-lang={lang}>
  <fieldset class="predict">
    <legend>{zh ? '先預測' : 'Predict first'}</legend>
    <p class="predict-question">{predict.question[lang]}</p>
    <div class="predict-options">
      {predict.options.map(o => <label><input type="radio" name={`predict-${id}`} value={o.value} disabled /> <span>{o.label[lang]}</span></label>)}
    </div>
    <button type="button" data-check disabled>{zh ? '檢查我的預測' : 'Check my prediction'}</button>
    <div class="predict-result" data-result hidden role="status">
      <p class="predict-verdict" data-verdict></p>
      <p>{predict.explain[lang]}</p>
    </div>
  </fieldset>
</predict-reveal>

<script>
  class PredictReveal extends HTMLElement {
    private abort?: AbortController;
    connectedCallback() {
      this.abort?.abort();
      this.abort = new AbortController();
      const { signal } = this.abort;
      const zh = this.dataset.lang === 'zh-tw';
      const radios = Array.from(this.querySelectorAll<HTMLInputElement>('input[type=radio]'));
      const check = this.querySelector<HTMLButtonElement>('[data-check]')!;
      const result = this.querySelector<HTMLElement>('[data-result]')!;
      const verdict = this.querySelector<HTMLElement>('[data-verdict]')!;
      radios.forEach(r => { r.disabled = false; });
      const reset = () => { result.hidden = true; check.disabled = !radios.some(r => r.checked); };
      radios.forEach(r => r.addEventListener('change', reset, { signal }));
      check.addEventListener('click', () => {
        const picked = radios.find(r => r.checked);
        if (!picked) return;
        const ok = picked.value === this.dataset.answer;
        const right = radios.find(r => r.value === this.dataset.answer)?.closest('label')?.textContent?.trim() ?? '';
        verdict.textContent = ok ? (zh ? '預測正確。' : 'Your prediction matches.') : (zh ? `和預期不同。答案是：${right}` : `Not quite. The answer is: ${right}`);
        verdict.dataset.ok = String(ok);
        result.hidden = false;
      }, { signal });
    }
    disconnectedCallback() { this.abort?.abort(); }
  }
  if (!customElements.get('predict-reveal')) customElements.define('predict-reveal', PredictReveal);
</script>

<style>
  predict-reveal { display: block; margin-bottom: 18px; }
  .predict { border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 8px; padding: 12px 14px 14px; margin: 0; background: var(--code-bg); min-width: 0; }
  legend { font: 600 11px var(--f-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); padding: 0 6px; }
  .predict-question { margin: 4px 0 10px; font-size: 15px; }
  .predict-options { display: grid; gap: 6px; margin-bottom: 12px; }
  .predict-options label { display: flex; gap: 8px; align-items: center; min-height: 28px; font-size: 14px; cursor: pointer; }
  .predict-options input { width: 18px; height: 18px; flex: none; margin: 0; }
  button { border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--ink); font: 13px var(--f-ui); padding: 8px 12px; cursor: pointer; }
  button:hover:not(:disabled) { border-color: var(--accent); }
  button:disabled { opacity: 0.55; cursor: default; }
  .predict-result { margin-top: 12px; font-size: 14px; }
  .predict-result p { margin: 4px 0; }
  .predict-verdict { font-weight: 600; }
  .predict-verdict[data-ok='true'] { color: var(--plot-c, #287d51); }
</style>
