---
// The units of one course on the Learn page (the top-level entries of src/content/curriculum.ts for a track) and, one
// level at a time, their sub-chapters. Only the units are shown; a unit with sub-chapters has a button that shows them,
// and deeper levels open the same way (each page visit starts collapsed). Without JavaScript the sub-chapter lists are
// shown in full (see the <noscript> rule on the Learn page). Rows carry data-path for StudyMap's reading progress.
export type UnitNode = {
  slug: string; href: string; prefix: string; number: string; text: string; short: string; ex: string;
  /** The text on the right of the row: the chapter count of a unit, or the reading time of a sub-chapter. */
  meta: string;
  children: UnitNode[];
};
interface Props { nodes: UnitNode[]; lang: string; depth?: number }
const { nodes, lang, depth = 1 } = Astro.props;
const zh = lang === 'zh-tw';
const idOf = (slug: string) => `lt-${slug.replace(/[^a-z0-9]+/gi, '-')}`;
const label = (n: UnitNode) => {
  const name = n.number ? `${n.prefix ? `${n.prefix} ` : ''}${n.number} ${n.text}` : n.text;
  const k = n.children.length;
  return zh ? `${name}：查看 ${k} 個子章節` : `${name}: show ${k} sub-chapter${k === 1 ? '' : 's'}`;
};
---
{nodes.map((node) => (
  <li class="cu-node" data-depth={Math.min(depth, 4)}>
    <div class="cu-row" data-path={node.href} data-short={node.short} data-ex={node.ex}>
      <a class="cu-link" href={node.href}>
        {node.number && <span class="cu-no">{node.prefix && <span class="sr-only">{node.prefix} </span>}{node.number}</span>}
        <span class="cu-title">{node.text}</span>
      </a>
      <span class="meta"><span>{node.meta}</span></span>
      {node.children.length > 0 ? (
        <button type="button" class="unit-toggle" aria-expanded="false" aria-controls={idOf(node.slug)} aria-label={label(node)} title={label(node)}>
          <span class="cu-more" aria-hidden="true">+{node.children.length}</span>
        </button>
      ) : <span class="cu-pad" aria-hidden="true"></span>}
    </div>
    {node.children.length > 0 && (
      <ol class="cu-children" id={idOf(node.slug)} hidden><Astro.self nodes={node.children} lang={lang} depth={depth + 1} /></ol>
    )}
  </li>
))}
