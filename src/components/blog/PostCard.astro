---
// A card for the "next in the series / more posts" footer of a post page: optional thumbnail, topic or series label, title, one line.
import { Image } from 'astro:assets';
import { type Lang, useT } from '../../i18n/ui';
import { url, formatDate, readingMinutes } from '../../lib/site';
import { firstPostImage } from '../../lib/blog-thumb';
import { BLOG_TOPIC_LABELS, seriesOf } from '../../lib/blog-topics';

interface Props { post: { lang: Lang; slug: string; entry: any }; lang: Lang; featured?: boolean }
const { post, lang, featured = false } = Astro.props;
const t = useT(lang);
const d = post.entry.data;
const thumb = firstPostImage(post.entry.body);
const s = seriesOf(post.slug);
const kicker = s
  ? `${s.series.label[lang]} · ${t('blog.part').replace('{n}', String(s.part)).replace('{total}', String(s.total))}`
  : BLOG_TOPIC_LABELS[d.category as keyof typeof BLOG_TOPIC_LABELS][lang];
---
<a class:list={['pcard', { featured }]} href={url(`/${post.lang}/blog/${post.slug}/`)} hreflang={post.lang}>
  {thumb && <Image class="pcard-img" src={thumb} alt="" width={480} widths={[240, 480]} sizes="(max-width: 700px) 100vw, 320px" loading="lazy" decoding="async" />}
  <span class="pcard-kicker">{kicker}</span>
  <span class="pcard-title">{d.title}</span>
  <span class="pcard-desc">{d.question ?? d.description}</span>
  <span class="pcard-meta">{t('blog.readMin').replace('{n}', String(readingMinutes(post.entry.body, post.lang)))} · {formatDate(d.published, lang)}</span>
</a>
<style>
  .pcard { display: flex; flex-direction: column; gap: 6px; min-width: 0; padding: 16px 18px 18px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--ink); text-decoration: none; transition: border-color 0.15s, translate 0.15s; }
  .pcard:hover { border-color: var(--line-strong); translate: 0 -2px; }
  .pcard:hover .pcard-title { color: var(--accent); }
  .pcard.featured { border-color: var(--line-strong); }
  .pcard-img { height: auto; width: calc(100% + 36px); margin: -16px -18px 8px; border-radius: 9px 9px 0 0; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; background: var(--code-bg); }
  @media (min-width: 701px) {
    .pcard.featured { display: grid; grid-template-columns: 260px minmax(0, 1fr); column-gap: 24px; align-content: start; }
    .pcard.featured > * { grid-column: 2; }
    .pcard.featured .pcard-img { grid-column: 1; grid-row: 1 / span 4; width: 100%; margin: 0; border-radius: 6px; align-self: start; }
  }
  .pcard-kicker { font: 600 12px var(--f-ui); color: var(--muted); }
  .pcard-title { font: 700 18px/1.3 var(--f-display); text-wrap: balance; overflow-wrap: anywhere; }
  .pcard-desc { font: 15px/1.55 var(--f-body); color: var(--muted); display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pcard-meta { margin-top: auto; padding-top: 6px; font: 12px var(--f-ui); color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .pcard { transition: none; } .pcard:hover { translate: none; } }
</style>
