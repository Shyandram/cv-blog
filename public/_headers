# Applied to static pages and assets. Astro adds per-page script hashes in a CSP
# meta tag; frame-ancestors must be delivered as an HTTP header instead.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'none'; upgrade-insecure-requests

# Cloudflare Pages: hashed build assets never change, so cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
